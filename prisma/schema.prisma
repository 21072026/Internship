// binaryTargets: "native" already resolves correctly when the image is built on
// the architecture it will run on, which is what build-image.yml does (one
// native runner per arch). Both concrete targets are listed anyway because a
// wrong/missing query engine does not fail the build — it fails at runtime, in
// production, on the first query. linux-arm64-* is the Oracle host (#2166),
// debian-openssl-3.0.x the amd64 one; ~15 MB to make a cross-build impossible
// to get wrong.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MENTOR
  MENTEE
  COMPANY
  SOURCE
}

// The admin tier of an ADMIN account (#1567). Additive on purpose: `Role` is
// never widened or split (that is the drop-and-recreate `db push` cannot be
// trusted with), so the tier is its own nullable column on User.
//
// There is deliberately no SUPER_ADMIN value. The platform operator is
// `User.isSuperAdmin` — read from the database per request and scoped to its
// world (src/lib/superAdmin.ts, docs/worlds.md); a second "super admin" stored
// here would be a second source of truth that the JWT could carry stale for
// 12h. Adding a value to this enum later is additive; removing one is not, so
// the value waits until something needs it.
enum AdminLevel {
  ORG_ADMIN // everything inside one tenant (today's ADMIN)
  PROGRAM_ADMIN // only the cohorts/companies named in its AdminScopeGrant rows
  OBSERVER // read-only, across its own tenant (grants are not read)
}

enum MentorshipStatus {
  ACTIVE
  COMPLETED
}

// Per-tenant plan tier (#547). Concrete limits per plan live in
// src/lib/orgPlans.ts (client-safe), not the DB.
enum OrgPlan {
  FREE
  PRO
  ENTERPRISE
}

// Where a tenant's meetings get their video room (#2007). The rule itself —
// pasted link → organiser's saved room → built-in room — is
// src/lib/conferencingRule.ts; this only names the three answers.
//   BUILTIN           today's behaviour: a room of ours unless a link is pasted
//   PREFER_PERSONAL   the organiser's saved personal room when they have one
//   REQUIRE_EXTERNAL  never a room of ours — the organiser must supply a link
enum ConferencingPolicy {
  BUILTIN
  PREFER_PERSONAL
  REQUIRE_EXTERNAL
}

enum InteractionType {
  Meeting
  Feedback
  Email
  Call
  WhatsApp
}

// Mentee'nin staj/işe alım sürecindeki granular aşaması (Excel status kolonunun karşılığı)
enum PipelineStatus {
  APPLICATION_100 // 100 tr: ilk temas
  APPROVAL_PENDING_220 // 220 tr: staj için onay bekliyor
  INTERVIEW_PENDING_250 // 250 tr: görüşülecek
  INTRODUCTION_PENDING_270 // 270 tr: tanıştırılacak
  INTERNSHIP_STARTING_300 // 300 tr: staj başlayacak
  INTERNSHIP_IN_PROGRESS_450 // 450 tr: staj devam ediyor
  INTERNSHIP_DROPPED_460 // 460 tr: staj yarım bıraktı
  INTERNSHIP_COMPLETED_490 // 490 tr: staj bitti
  JOB_SEEKING_500 // 500 tr: iş arıyor
  HIREABLE_600 // 600 tr: işe alınabilir
  HIRED_660 // 660 tr: işe alındı
  EMPLOYED_700 // 700 tr: iş buldu
  INTERNSHIP_FOUND_ELSEWHERE_800 // 800 tr: başka yerde staj buldu
}

// Tenant/organization for multi-tenancy (#543). Phase 1: additive & nullable —
// every tenant-scoped row is backfilled to a single default org and nothing
// enforces isolation yet, so behaviour is unchanged. Enforcement (query
// filtering, per-org uniqueness) lands in a later, guarded slice.
model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  // Per-tenant plan tier (#547). Limits per plan live in src/lib/orgPlans.ts
  // (client-safe catalogue), not the DB. New tenants start on FREE; the
  // backfilled legacy "default" org is grandfathered to ENTERPRISE (unlimited)
  // so single-tenant production is never constrained. Limits are advisory in
  // this phase (surfaced as usage-vs-limit), not hard-enforced.
  plan             OrgPlan  @default(FREE)
  // Which PRODUCT this tenant is (#2350, epic #2348). coreCRM is one core with
  // several verticals: INTERNSHIP is the mentorship/placement product this repo
  // started as, MARKETING the second one. It is a property of the TENANT, not of
  // the deployment — two orgs on the same container can be different products,
  // which is why this is a column and not an env var.
  //
  // A String, not an enum, on purpose: `Role` (schema.prisma, SUPER_ADMIN note)
  // is the worked example of why widening a role enum is expensive, and a
  // vertical is a catalogue key that product will add to. The catalogue lives in
  // src/lib/verticals.ts; an unknown key falls back to INTERNSHIP rather than to
  // "no product", so a bad write can never blank a tenant's UI.
  //
  // Literal default, so `db push` fills existing rows itself (#2298 only bites
  // client-side defaults and required columns without one).
  vertical         String   @default("INTERNSHIP")
  // White-label branding (#546). All optional — when null the app falls back to
  // its own defaults (see src/lib/branding.ts). These are stored per tenant and
  // resolved once per-tenant chrome application lands (needs tenant resolution,
  // the #543 enforcement slice); until then they are managed but not applied to
  // the live single-tenant UI.
  brandName        String?
  brandLogoUrl     String?  @db.Text
  brandColor       String?
  supportEmail     String?
  // Per-organization brand (#2922, docs/white-label.md). The rule is pure in
  // src/lib/brandRule.ts: a field left null falls back to the vertical's
  // default on its own, and a row with none of them set IS the default. All
  // nullable, so `db push` is additive (#2298).
  //   brandTileColor   #rrggbb behind the mark on every generated icon
  //   brandAccent      the default accent: a key of ACCENT_COLORS, or 'brand'
  //   brandPalette     the 'brand' accent's exact ramp, ten hexes 50…900
  //                    (super admin only; generated from brandColor when unset)
  //   brandMarkVersion the current generated icon set (BrandAsset.version);
  //                    null = the vertical's static files under public/
  brandTileColor   String?
  brandAccent      String?
  brandPalette     String?  @db.Text
  brandMarkVersion String?
  // Enterprise SSO config (#545). All optional; nothing is active until
  // ssoEnabled is true AND a valid config is present (see src/lib/sso.ts).
  // Actual assertion handling requires the tenant's IdP metadata and a SAML
  // library — see docs/sso-saml.md; this stores/validates the config and gates
  // the (documented, not-yet-wired) auth code path.
  ssoEnabled       Boolean  @default(false)
  ssoProvider      String? // 'saml' | 'oidc'
  ssoIssuer        String? // IdP entity ID / issuer
  ssoEntryPoint    String?  @db.Text // IdP SSO sign-in URL
  ssoCertificate   String?  @db.Text // IdP x509 signing certificate (PEM)
  // Enforced SSO (#1950): when true, NO password-derived path may mint a
  // session for this tenant's users — sign-in, remember-me silent re-auth,
  // password reset/SET_INITIAL, invitation registration and password change all
  // refuse. The single rule lives in src/lib/ssoEnforcement.ts; every door calls
  // it. Two safety interlocks: the write boundary refuses to switch this on
  // unless isSsoActive(org) AND the org has at least one active, ssoExempt
  // ADMIN (anti-lockout), and enforcement only *applies* while SSO is still
  // active — a plan downgrade or a broken config falls back to password login
  // rather than locking the tenant out of its own data. See docs/sso-saml.md.
  ssoEnforced      Boolean  @default(false)
  // IdP role mapping (#1940): when true, a RETURNING SSO user's role is
  // re-resolved from their claims on every login (logged at warning level,
  // old -> new). Off by default: a locally elevated user must not be demoted by
  // a misconfigured claim. The mappings themselves are SsoClaimMapping rows.
  ssoSyncRole      Boolean  @default(false)
  // SAML Single Logout (#1952, docs/sso-saml.md § Single Logout). The IdP's
  // SingleLogoutService (part of the IdP trust: a super admin sets it, #1575),
  // and OUR per-org SP signing key — generated on first use, the private half
  // sealed with secretBox (purpose 'sso-sp-signing-key'), the self-signed
  // public certificate published in the SP metadata.
  ssoLogoutUrl     String?  @db.Text
  ssoSpKey         String?  @db.Text
  ssoSpCert        String?  @db.Text
  // Billing identity (#1731, epic #1727). All optional and additive: the
  // Organization is the ONE billing subject (a Company is a role inside it),
  // and this is where the invoice is addressed. Nothing here talks to Stripe
  // yet — `stripeCustomerId` is the column the later checkout task fills, kept
  // unique so one customer can never be attached to two tenants.
  stripeCustomerId String?  @unique
  billingEmail     String?
  vatId            String?
  // ISO-3166 alpha-2 ("DE", "TR"). Decides VAT treatment, so it is stored,
  // never inferred from an IP or a locale.
  billingCountry   String?
  // The public hostname whose sessionless forms write into THIS tenant (#2569):
  // the marketing landing's demo form on one of the marketing hosts
  // (MARKETING_HOSTS) lands in the org whose `publicHost` is exactly that host
  // name. An explicit mapping, never a
  // heuristic ("the first MARKETING org"): a marketing host no org claims is a
  // CLOSED form, not the internship tenant's inbox. Lowercase hostname, no port,
  // no wildcard — the same exact-match rule as src/lib/servedHosts.ts. Unique, so
  // one host can never name two tenants. Resolution + trust reasoning:
  // src/lib/publicHostOrg.ts. Nullable, so `db push` is additive (#2298).
  publicHost       String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Conferencing policy (#2007): which video room this tenant's meetings get.
  // On the Organization, NOT on Setting — Setting is keyed by a `String @id`,
  // and giving it an orgId re-keys the table (a drop-and-recreate under
  // `db push`). Literal default, so `db push` fills existing rows itself.
  conferencingPolicy ConferencingPolicy @default(BUILTIN)

  users                   User[]
  sources                 Source[]
  cohorts                 Cohort[]
  programSteps            ProgramStep[]
  companies               Company[]
  projects                Project[]
  relations               MentorshipRelation[]
  pipelineStages          PipelineStage[]
  evaluationTemplates     EvaluationTemplate[]
  stageSlas               StageSla[]
  slaBreaches             SlaBreach[]
  tags                    Tag[]
  skills                  Skill[]
  skillAliases            SkillAlias[]
  skillEdges              SkillEdge[]
  unmappedSkillTerms      UnmappedSkillTerm[]
  mentorApplications      MentorApplication[]
  companyInquiries        CompanyInquiry[]
  documentRequirements    DocumentRequirement[]
  weeklyReports           WeeklyReport[]
  // Scheduled report delivery (#1905).
  reportSubscriptions     ReportSubscription[]
  reportSubscriptionSends ReportSubscriptionSend[]
  // Nightly relationship-health snapshots (#1901).
  relationHealthSnapshots RelationHealthSnapshot[]
  surveys                 Survey[]
  formDefinitions         FormDefinition[]
  formResponses           FormResponse[]
  surveyCampaigns         SurveyCampaign[]
  savedViews              SavedView[]
  // Org-defined segmentation attributes (#1920).
  orgAttributes           OrgAttribute[]
  aiArtifacts             AiArtifact[]
  aiFeatureSettings       AiFeatureSetting[]
  meetingAttendance       MeetingAttendance[]
  evaluationDues          EvaluationDue[]
  surveyInvitations       SurveyInvitation[]
  surveyResponses         SurveyResponse[]
  meetingFeedback         MeetingFeedback[]
  offers                  Offer[]
  requisitions            Requisition[]
  interviewRequests       InterviewRequest[]
  applications            Application[]
  messageTemplates        MessageTemplate[]
  apiKeys                 ApiKey[]
  matchFeedback           MatchFeedback[]
  matchRuleSets           MatchRuleSet[]
  matchRules              MatchRule[]
  settings                Setting[]
  programCosts            ProgramCost[]
  placements              Placement[]
  rosterFeeds             RosterFeed[]
  subscription            Subscription?
  orgEntitlements         OrgEntitlement[]
  usageRollups            UsageRollup[]
  planChangeRequests      PlanChangeRequest[]
  companyUsage            CompanyUsage[]
  contactPermissions      ContactPermission[]
  integrationEvents       IntegrationEvent[]
  integrationSources      IntegrationSource[]
  companyContacts         CompanyContact[]
  postCampaigns           PostCampaign[]
  postRecipients          PostCampaignRecipient[]
  contactSuppressions     ContactSuppression[]
  companyChannels         CompanyChannel[]
  webhooks                Webhook[]
  auditDrains             AuditDrain[]
  adminScopeGrants        AdminScopeGrant[]
  announcements           Announcement[]
  newsletters             Newsletter[]
  trialReminders          TrialReminder[]
  outboundDrafts          OutboundDraft[]
  relationValues          RelationValue[]
  ssoClaimMappings        SsoClaimMapping[]
  agendaTemplates         AgendaTemplate[]
  safeguardingFlags       SafeguardingFlag[]
  brandAssets             BrandAsset[]
}

// Per-tenant customizable pipeline stages (#747, part of white-label #546).
// Phase A is additive + behavior-preserving: an org with NO rows here uses the
// built-in canonical stages (the PipelineStatus enum, src/lib/pipeline.ts), so
// single-tenant production is unchanged. An org that defines rows overrides the
// label / order / color / on-path grouping for the stages it lists. `key` is the
// stable identifier (the enum value for the canonical set; a slug for custom
// stages once storage moves off the enum in a later slice).
// Per-stage service level (#817): "nobody should wait more than N days here".
//
// Deliberately NOT a column on PipelineStage, even though that is where stage
// configuration lives. Custom stages are premium-gated and their editor
// replaces the whole set on every save, so putting the SLA there would (a)
// paywall a candidate-experience feature and (b) wipe every SLA whenever an
// admin renamed a stage. A separate row keyed by stage KEY works for an org on
// the built-in stages and an org with its own, and survives stage edits.
//
// DAYS ARE CALENDAR DAYS, not business days. A candidate waiting over a weekend
// still waited — the SLA measures their experience, not our working hours.
// Business-day arithmetic would need a holiday calendar per country and per
// org; calendar days can only ever fire the warning EARLIER, never later.
//
// Since #1439 the row carries a SECOND, independent per-stage number: the
// board's work-in-progress limit. The two share a row because they answer the
// same shape of question about the same stage ("how long may somebody wait
// here", "how many people may pile up here") and an org configures them on one
// screen — which is also why `days` had to become nullable: a stage may have a
// WIP limit and no service level, or the other way round. A row with neither is
// deleted by the endpoint rather than kept as an empty rule.
// Free-form labels on a person (#887).
//
// NOT a replacement for Cohort or Source, and the distinction matters or the
// three blur into each other:
//   · Cohort — the official period group a candidate belongs to. Exactly ONE.
//   · Source — where a candidate came from. Exactly ONE.
//   · Tag    — whatever this org needs to mark, MANY per person, invented by
//              the people doing the work rather than configured up front.
//
// Org-scoped by construction (orgId required): a tenant must never see another
// tenant's vocabulary, let alone who carries it.
model Tag {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  // Optional hex swatch; the management screen (a separate task) owns picking it.
  color       String?
  createdById String?
  createdAt   DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users UserTag[]

  @@unique([orgId, name])
  @@index([orgId])
}

// Deleting a Tag removes the label, never the person: the cascade runs from
// Tag → UserTag and from User → UserTag, and stops there.
model UserTag {
  id        String   @id @default(cuid())
  userId    String
  tagId     String
  addedById String?
  addedAt   DateTime @default(now())

  user User @relation("UserTags", fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([tagId])
  @@index([userId])
}

// ─── Canonical skill taxonomy (#1815, epic #1810) ──────────────────────────
// The vocabulary a skill list resolves TO. Same shape as Tag/UserTag: required
// orgId, unique per org, cascade from Organization. Purely additive — the
// free-text `User.skills` / `Requisition.requiredSkills` JSON keeps being
// written as it is today. The pure rules live in src/lib/skillTaxonomyRule.ts,
// the DB-side resolver in src/lib/skillsResolve.ts; the starter rows come from
// src/lib/skillSeed.ts (#1816).
//
// `status` and `kind` are Strings (like Requisition.status) so the vocabulary
// can grow without an enum change under `db push`.
model Skill {
  id           String   @id @default(cuid())
  orgId        String
  // The fold of the canonical name (`skillKey()`), or the seed key for a
  // starter skill ("react"). Never renamed: aliases, edges and user rows
  // point at the row, but a backfill matches on this.
  key          String   @db.VarChar(64)
  labelEn      String   @db.VarChar(60)
  labelTr      String   @db.VarChar(60)
  labelDe      String   @db.VarChar(60)
  category     String?  @db.VarChar(32)
  // ACTIVE | RETIRED. A retired skill is no longer offered, but the rows that
  // point at it keep their meaning.
  status       String   @default("ACTIVE") @db.VarChar(16)
  // Set when an admin merges this skill into another: the row stays so every
  // old reference still resolves (the resolver follows the chain).
  mergedIntoId String?
  createdById  String?
  createdAt    DateTime @default(now())

  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  mergedInto   Skill?             @relation("SkillMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Skill[]            @relation("SkillMerge")
  aliases      SkillAlias[]
  edgesFrom    SkillEdge[]        @relation("SkillEdgeFrom")
  edgesTo      SkillEdge[]        @relation("SkillEdgeTo")
  users        UserSkill[]
  requisitions RequisitionSkill[]

  @@unique([orgId, key])
  @@index([orgId, status])
  @@index([mergedIntoId])
}

// A spelling people type ("ReactJS", "React.js"), folded. Unique per org, so
// an alias can never point at two canonical skills.
model SkillAlias {
  id      String @id @default(cuid())
  orgId   String
  skillId String
  key     String @db.VarChar(64)

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  skill Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([skillId])
}

// "Close enough to be worth showing for the other". ADJACENT is undirected
// (stored once, read both ways); BROADER / NARROWER read from → to only.
// weight is 0..1 and is what adjacency-aware scoring multiplies by (#1821).
model SkillEdge {
  id          String @id @default(cuid())
  orgId       String
  fromSkillId String
  toSkillId   String
  weight      Float  @default(0.5)
  kind        String @default("ADJACENT") @db.VarChar(16)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  from Skill        @relation("SkillEdgeFrom", fields: [fromSkillId], references: [id], onDelete: Cascade)
  to   Skill        @relation("SkillEdgeTo", fields: [toSkillId], references: [id], onDelete: Cascade)

  @@unique([orgId, fromSkillId, toSkillId])
  @@index([toSkillId])
}

// A person holds a canonical skill. Reached only through its User (scoped) or
// its Skill (scoped), exactly like UserTag — so no orgId and deliberately not
// in TENANT_MODELS. Removing a skill removes the row, never the person.
// Proficiency columns are #1814's.
model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  // Where the row came from: SELF | ADMIN | BACKFILL | CV | IMPORT.
  source    String   @default("SELF") @db.VarChar(16)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
}

// A requisition asks for a canonical skill. Child of Requisition (scoped),
// same reasoning as UserSkill: no orgId, not in TENANT_MODELS.
model RequisitionSkill {
  id            String  @id @default(cuid())
  requisitionId String
  skillId       String
  required      Boolean @default(true)

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([requisitionId, skillId])
  @@index([skillId])
}

// A free-text skill the backfill (#1819) could not resolve onto the org's
// vocabulary — parked for an admin instead of guessed or dropped. One row per
// org × folded term; `occurrences` is recomputed absolutely on every run
// (people holding it + requisitions asking for it), so a re-run is a no-op.
// The admin's decision (PROMOTED to a new skill, ALIASED onto an existing one,
// DISCARDED) is never overwritten by the backfill.
model UnmappedSkillTerm {
  id              String    @id @default(cuid())
  orgId           String
  // `skillKey()` fold of the term — what makes "Yazılım" and "yazilim" one row.
  normalizedKey   String    @db.VarChar(64)
  // The spelling seen most often, for display.
  term            String    @db.VarChar(60)
  occurrences     Int       @default(0)
  firstSeenAt     DateTime  @default(now())
  // PENDING | PROMOTED | ALIASED | DISCARDED
  resolution      String    @default("PENDING") @db.VarChar(16)
  resolvedSkillId String?
  resolvedById    String?
  resolvedAt      DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, normalizedKey])
  @@index([orgId, resolution, occurrences])
}

model StageSla {
  id                String   @id @default(cuid())
  orgId             String
  // The stage this applies to. A plain key, not a relation: it must work for
  // an org that has no PipelineStage rows at all (i.e. uses the built-ins).
  stageKey          String
  /// Calendar days somebody may wait at this stage before the mentor is warned.
  /// NULL = no service level here (the row then exists only for `wipLimit`).
  days              Int?
  /// Board work-in-progress limit for this stage (#1439): the column's count
  /// turns amber above this many cards. NULL = inherit the org-wide
  /// `boardWipLimit` setting; a stored 0 means "never warn about this stage",
  /// which is a different statement and is why it is stored rather than
  /// normalised away. The rule lives in src/lib/boardWip.ts.
  wipLimit          Int?
  /// Escalation ladder (#1722): once a breach of this stage's `days` has stood
  /// this many further calendar days without the stage moving, the org's
  /// administrators are told too. NULL = the ladder stops at the mentor, which
  /// is exactly what every org had before. Meaningless without `days`.
  escalateAfterDays Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, stageKey])
  @@index([orgId])
}

// One stage deadline that passed (#1722) — the state the escalation ladder
// climbs and the breach queue (#1723) lists. Opened by the daily sweep the
// first time it sees a relation past `stageDeadline`, keyed by the exact
// deadline it breached, so a hand-moved deadline opens a fresh breach rather
// than inheriting the old one's level. Closed (`resolvedAt`) by a stage move,
// a cleared or future deadline, or the relation leaving ACTIVE — never by a
// delete, because the compliance rate is computed from these rows.
// The rules are pure in src/lib/slaLadderRule.ts; src/lib/slaBreach.ts is
// the only writer.
model SlaBreach {
  id               String    @id @default(cuid())
  orgId            String?
  relationId       String
  stageKey         String    @db.VarChar(64)
  /// The `stageDeadline` this breach is about.
  dueAt            DateTime
  /// 1 = the mentor was told, 2 = the org's administrators were told.
  level            Int       @default(1)
  lastEscalatedAt  DateTime?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  /// No escalation before this instant. The reason goes to the ActivityLog.
  snoozedUntil     DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org      Organization?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@unique([relationId, dueAt])
  @@index([orgId, resolvedAt])
  @@index([relationId, resolvedAt])
}

model PipelineStage {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key        String
  /// A label the tenant actually typed, shown verbatim in every language — or
  /// "" meaning "use the built-in localized label for this key" (#2268). Always
  /// read it through resolvePipelineStages()/useResolvedStages(), never raw.
  label      String
  order      Int
  isTerminal Boolean      @default(false)
  isOffPath  Boolean      @default(false)
  color      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([orgId, key])
  @@index([orgId, order])
}

model User {
  orgId                   String?
  org                     Organization? @relation(fields: [orgId], references: [id])
  id                      String        @id @default(cuid())
  // A row of the starter pack's sample programme (#2066): synthetic, labelled,
  // removed as a set by DELETE /api/admin/organizations/[id]/sample-data.
  sampleData              Boolean       @default(false)
  // NOT globally unique any more (worlds, epic #2348): one PERSON may hold one
  // account per WORLD — the internship product and the marketing product are
  // two different tenants, and the host a person signs in on decides which one
  // they are in. Uniqueness is per (email, org) at the database and per
  // (email, vertical) in the app: src/lib/userWorld.ts is the only place that
  // looks an account up by e-mail, and it always answers "in which world?".
  // Read docs/worlds.md before adding a lookup — `findUnique({ where: { email } })`
  // no longer type-checks, and a bare `findFirst({ where: { email } })` is
  // exactly the bug that would sign a person into the wrong product.
  email                   String
  password                String
  role                    Role          @default(MENTEE)
  fullName                String
  phone                   String?
  university              String?
  department              String?
  graduationYear          Int?
  skills                  Json          @default("[]")
  // Languages a mentor speaks; distinct from preferredLanguage (the UI locale).
  languages               Json          @default("[]")
  // Mentee self-assessment: { "<skill>": 1..5 }
  skillLevels             Json          @default("{}")
  cvUrl                   String?
  avatarUrl               String?
  whatsapp                String?
  city                    String?
  birthDate               DateTime?
  referralSource          String?
  // Person-level referral (#51): which *person* brought this user in — the
  // mentee, mentor or admin whose invite/referral link they signed up through.
  // Orthogonal to `sourceId` (an institution/channel) and `referralSource`
  // (free text typed by whoever created the record).
  referredById            String?
  // Stable personal referral code behind /auth/register?ref=<code>. Generated
  // on first use so existing rows need no backfill.
  referralCode            String?       @unique
  // Personal ICS calendar-feed credential (#915): unguessable, generated on
  // demand, revocable by nulling. Null = no feed exposed for this user.
  icsFeedToken            String?       @unique
  // How this user's name appears on a published testimonial (#1096):
  // "fullname" | "initials". Null = initials — the privacy-first default;
  // showing the full name is an explicit choice next to the consent toggle.
  testimonialNameStyle    String?
  // Whether the public profile shows the projects/tasks showcase (#1091).
  // The data is the user's own work in PUBLIC projects only, so it rides the
  // publicProfile switch — this just lets them turn that one section off.
  publicShowProjects      Boolean       @default(true)
  // Extended profile (all optional; safe to add to existing rows).
  displayName             String?
  bio                     String?       @db.Text
  country                 String?
  timezone                String?
  linkedinUrl             String?
  githubUrl               String?
  portfolioUrl            String?
  // The organiser's own video room (#2007): a Zoom PMI, a Meet room, a Teams
  // "meet now" link. Used for the meetings this person organises when their
  // tenant's conferencingPolicy allows it (src/lib/conferencingRule.ts).
  // Validated on write like the profile URLs — https only, no credentials,
  // never one of our own hosts — and sized to fit Meeting.meetLink.
  personalMeetingUrl      String?
  // Mentee: interests / target position. Mentor: max concurrent mentees.
  interests               String?       @db.Text
  targetPosition          String?
  mentorCapacity          Int?
  // Mentor's own "I can take new mentees right now" preference (#941) —
  // distinct from mentorCapacity (a headcount ceiling): a mentor under
  // capacity can still switch this off (e.g. going on leave), and one at
  // capacity could in principle switch it on. Null = no preference set yet;
  // availability then falls back to a capacity-derived guess (see
  // src/lib/mentorAvailability.ts).
  acceptingMentees        Boolean?
  // Set the first time a MENTOR lands on their dashboard (#911), so the
  // one-time redirect to the mentor onboarding wizard never fires twice —
  // stamped before the redirect, not after the wizard is finished/skipped.
  mentorOnboardingSeenAt  DateTime?
  // Default true so existing rows stay writable after the column is added;
  // new self-registrations are created with false until they verify by email.
  emailVerified           Boolean       @default(true)
  // Admin can deactivate a user; inactive users cannot sign in.
  isActive                Boolean       @default(true)
  // Instance-level capability (#1535): may manage EVERY tenant's Organization
  // row — create tenants, change plans, and write SSO config (the IdP entry
  // point and signing certificate, i.e. who may mint a login). A plain ADMIN is
  // a *tenant* admin and may only ever touch their own org.
  //
  // Deliberately a flag, not a `SUPER_ADMIN` value on `Role`: `role` is copied
  // into the JWT and compared to 'ADMIN' in dozens of guards, so widening the
  // enum would change all of them at once. It is also never put in the token —
  // `src/lib/superAdmin.ts` reads it from the database per request so revoking
  // it takes effect on the next request, like `sessionsValidFrom`.
  isSuperAdmin            Boolean       @default(false)
  // The admin tier inside a tenant (#1567, docs/role-access-matrix.md §
  // Admin tiers). NULL means "no tier recorded"; `role` stays the source of
  // truth for MENTOR/MENTEE/COMPANY/SOURCE and a non-ADMIN never holds a tier,
  // whatever this column says. PROGRAM_ADMIN's reach is its AdminScopeGrant
  // rows — none means none. The platform tier is NOT here: that is
  // `isSuperAdmin` above, read live and per world (src/lib/superAdmin.ts).
  adminLevel              AdminLevel?
  // Break-glass exemption from the tenant's enforced SSO (#1950). Only an
  // active ADMIN may hold one, only an admin may grant it, and every grant and
  // revocation is audited (`sso.exempt_granted` / `sso.exempt_revoked`). It is
  // deliberately NOT time-boxed: an exemption that silently expires recreates
  // exactly the lockout it exists to prevent — an IdP outage on the day it
  // lapses leaves nobody who can sign in and switch enforcement off. The
  // narrowing is "who", not "how long".
  ssoExempt               Boolean       @default(false)
  // Set only when the `selfRegistration` setting is 'manual': the account was
  // created by open sign-up and is waiting for an admin to let it in. Lets the
  // sign-in page tell "we haven't reviewed you yet" apart from "an admin
  // deactivated you" — both are isActive=false. Cleared on activation.
  pendingApproval         Boolean       @default(false)
  // Roster-feed deprovisioning (#1966, docs/roster-feeds.md). `rosterAbsentSince`
  // is when a feed first stopped mentioning this person — stamped by the first
  // successful run they are absent from, cleared the moment they reappear, and
  // what the grace period counts from. `deactivatedBy` says WHO switched the
  // account off: "roster:<feedId>" for a feed, a user id for a human. A feed
  // reactivates only what a feed deactivated; null (every deactivation before
  // this column) reads as a human's decision and is never undone by a file.
  rosterAbsentSince       DateTime?
  deactivatedBy           String?       @db.VarChar(64)
  // Opt-in: expose a limited, PII-free public profile at /p/[id].
  publicProfile           Boolean       @default(false)
  // For COMPANY-role users: which company they observe (read-only).
  companyId               String?
  // Mentee's referral source (where they came from).
  sourceId                String?
  // How many times this user's public profile has been viewed.
  profileViews            Int           @default(0)
  // When the user accepted the privacy/data terms (consent). Also the anchor
  // for retention re-consent: data is kept no longer than retentionMonths past
  // this date without renewal.
  consentAt               DateTime?
  // Set when a retention/re-consent reminder was last emailed (avoids resending
  // on every cron run). Cleared when the user renews consent.
  retentionReminderSentAt DateTime?
  // The re-engagement pool (#834). On the CANDIDATE, not on MentorshipRelation:
  // the pool is a promise between the organisation and the person ("we will
  // write in September"), and a relation is precisely the thing that ends when
  // the cycle ends — hanging the promise on it would kill the promise at the
  // moment it becomes due. It would also let someone with two relations sit in
  // the pool twice on two different dates, which is incoherent as a commitment.
  reEngageAt              DateTime?
  reEngageNote            String?       @db.Text
  // Idempotency for the reminder cron: stamped when the "let's talk again"
  // message goes out, so a tick that runs twice does not mail twice.
  reEngageNotifiedAt      DateTime?
  // Opt-out switch for transactional email (messages, announcements). In-app
  // notifications are always created regardless.
  emailNotifications      Boolean       @default(true)
  // Per-category email toggles, e.g. {"messages":false}. Nullable so existing
  // rows aren't touched (avoids MariaDB json_valid CHECK issues); unset = on.
  notificationPrefs       Json?
  // Optional TOTP two-factor auth. The secret is only meaningful once enabled.
  twoFactorEnabled        Boolean       @default(false)
  twoFactorSecret         String?
  // Highest TOTP time step already accepted for this account. Three codes are
  // valid at any moment (±1 step for clock skew, ~90s), so without this a code
  // captured by a phishing page or over someone's shoulder could be replayed
  // inside that window (#865). A code must beat this value to be accepted.
  lastTotpStep            Int?
  // "Sign out of all devices": any JWT issued before this instant is rejected at
  // the session callback. Null = never revoked. Set to now() to invalidate every
  // existing session (including the current one) on demand.
  sessionsValidFrom       DateTime?
  // Preferred UI language ('en' | 'tr' | 'de'); applied at sign-in.
  preferredLanguage       String?
  // UI theme preference ('light' | 'dark' | 'system'); applied at sign-in.
  theme                   String?
  // UI font-size preference ('sm' | 'md' | 'lg' | 'xl'); applied at sign-in.
  fontSize                String?
  // UI density preference ('comfortable' | 'compact'); applied at sign-in.
  // Null = comfortable (the default spacing).
  density                 String?
  // UI accent color (one of ACCENT_COLORS in src/lib/accent.ts, e.g. 'blue' | 'magenta');
  // drives the app's primary color via data-accent. Null = environment default
  // (green in preview, blue in production).
  accentColor             String?
  // Last successful sign-in; powers "X days since login" in activity reports.
  lastLoginAt             DateTime?
  // Last time the user was seen active (page-view heartbeat, consent-gated).
  lastSeenAt              DateTime?
  // The HR system's own identifier for this person, when a roster feed carries
  // one (#1965). Nullable and unbackfilled: only people who arrive through a
  // feed keyed on EXTERNAL_ID ever have it. It is what makes an e-mail change
  // readable as an update instead of a leaver plus a joiner - matching on the
  // address alone cannot tell those apart, and #1966 would deprovision the
  // "leaver". Not unique: the uniqueness that matters is per tenant, and MySQL
  // treats NULLs in a unique index as distinct, so a composite unique over a
  // nullable pair would stop de-duplicating anything at all (the same reasoning
  // as Job.idempotencyKey).
  externalId              String?       @db.VarChar(191)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  mentorRelations                   MentorshipRelation[]          @relation("MentorRelations")
  menteeRelations                   MentorshipRelation[]          @relation("MenteeRelations")
  statusChanges                     StatusChange[]                @relation("StatusChangedBy")
  passwordResetTokens               PasswordResetToken[]
  emailVerificationTokens           EmailVerificationToken[]
  tags                              UserTag[]                     @relation("UserTags")
  // Canonical skills (#1815). `skills` above stays the free-text JSON until a
  // separate contract PR retires it; this is the joinable twin.
  skillRows                         UserSkill[]
  cvFile                            CvFile?
  avatarFile                        AvatarFile?
  notifications                     Notification[]
  pushSubscriptions                 PushSubscription[]
  nativePushTokens                  NativePushToken[]
  conversationParticipants          ConversationParticipant[]
  ownedProjects                     Project[]                     @relation("ProjectOwner")
  projectMemberships                ProjectMember[]               @relation("ProjectMemberships")
  availabilitySlots                 AvailabilitySlot[]
  availabilityExceptions            AvailabilityException[]       @relation("AvailabilityExceptions")
  bookingPolicy                     MentorBookingPolicy?          @relation("MentorBookingPolicy")
  company                           Company?                      @relation("CompanyUsers", fields: [companyId], references: [id])
  source                            Source?                       @relation(fields: [sourceId], references: [id])
  documents                         Document[]                    @relation("DocumentOwner")
  personalNotes                     PersonalNote[]
  consents                          UserConsent[]
  contributorTermsAcceptances       ContributorTermsAcceptance[]
  googleCalendar                    GoogleCalendarConnection?
  companyInterests                  CompanyInterest[]             @relation("CompanyInterestMentee")
  companyNeedAlerts                 CompanyNeedAlert[]            @relation("CompanyNeedAlertMentee")
  mentorshipRequests                MentorshipRequest[]           @relation("MentorshipRequests")
  decidedRequests                   MentorshipRequest[]           @relation("DecidedMentorshipRequests")
  preferredInRequests               MentorshipRequest[]           @relation("PreferredMentorRequests")
  decidedMentorApplications         MentorApplication[]           @relation("DecidedMentorApplications")
  handledCompanyInquiries           CompanyInquiry[]              @relation("HandledCompanyInquiries")
  supportTickets                    SupportTicket[]               @relation("SupportRequester")
  assignedSupportTickets            SupportTicket[]               @relation("SupportAssignee")
  supportMessages                   SupportMessage[]              @relation("SupportMessageSender")
  authoredRelationNotes             RelationNote[]                @relation("RelationNoteAuthor")
  sessionNotes                      SessionNote[]                 @relation("SessionNoteAuthor")
  sessionNoteRevisions              SessionNoteRevision[]         @relation("SessionNoteRevisionAuthor")
  pageViews                         PageView[]
  referredBy                        User?                         @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers                     User[]                        @relation("UserReferrals")
  sentInvitations                   InvitationToken[]             @relation("InvitationInviter")
  assignedProjectTasks              ProjectTask[]                 @relation("ProjectTaskAssignee")
  authoredProjectTasks              ProjectTask[]                 @relation("ProjectTaskAuthor")
  projectJoinRequests               ProjectJoinRequest[]          @relation("JoinRequester")
  decidedJoinRequests               ProjectJoinRequest[]          @relation("JoinRequestDecider")
  taskTemplates                     ProjectTaskTemplate[]         @relation("TaskTemplateAuthor")
  agendaTemplates                   AgendaTemplate[]              @relation("AgendaTemplateAuthor")
  mentorOnboardings                 MenteeOnboarding[]            @relation("OnboardingMentor")
  menteeOnboarding                  MenteeOnboarding[]            @relation("OnboardingMentee")
  missingDocumentReminderSubjects   DocumentRequirementReminder[] @relation("MissingDocumentReminderSubject")
  missingDocumentReminderRecipients DocumentRequirementReminder[] @relation("MissingDocumentReminderRecipient")
  weeklyReportReminders             WeeklyReportReminder[]        @relation("WeeklyReportReminderRecipient")
  createdOffers                     Offer[]                       @relation("OfferCreatedBy")
  decidedOffers                     Offer[]                       @relation("OfferDecidedBy")
  reviewedWeeklyReports             WeeklyReport[]                @relation("WeeklyReportReviewer")
  // Report subscriptions this user receives (#1905); removed with the user.
  reportSubscriptions               ReportSubscription[]          @relation("ReportSubscriptionRecipient")
  surveyInvitations                 SurveyInvitation[]            @relation("SurveyInvitee")
  savedViews                        SavedView[]                   @relation("SavedViewAuthor")
  // Segmentation attribute values (#1920); removed with the user.
  attributeValues                   UserAttributeValue[]
  aiArtifacts                       AiArtifact[]                  @relation("AiArtifactSubject")
  attendanceRecords                 MeetingAttendance[]           @relation("AttendanceSubject")
  attendanceRecorded                MeetingAttendance[]           @relation("AttendanceRecorder")
  surveyResponses                   SurveyResponse[]              @relation("SurveyRespondent")
  formResponses                     FormResponse[]
  meetingFeedback                   MeetingFeedback[]             @relation("MeetingFeedbackRater")
  ownedRequisitions                 Requisition[]                 @relation("RequisitionOwner")
  interviewRequests                 InterviewRequest[]            @relation("InterviewRequestMentee")
  applications                      Application[]                 @relation("ApplicationMentee")
  applicationEvents                 ApplicationEvent[]            @relation("ApplicationEventActor")
  decidedInterviewRequests          InterviewRequest[]            @relation("InterviewRequestDecider")
  cancelledInterviewRequests        InterviewRequest[]            @relation("InterviewRequestCanceller")
  newsletterSends                   NewsletterSend[]
  trustedDevices                    TrustedDevice[]
  signInDevices                     SignInDevice[]
  ownedMessageTemplates             MessageTemplate[]             @relation("MessageTemplateOwner")
  authoredMessageTemplates          MessageTemplate[]             @relation("MessageTemplateAuthor")
  createdApiKeys                    ApiKey[]                      @relation("ApiKeyCreatedBy")
  suggestedAsMentee                 MatchFeedback[]               @relation("MatchFeedbackMentee")
  suggestedAsMentor                 MatchFeedback[]               @relation("MatchFeedbackMentor")
  matchFeedbackActions              MatchFeedback[]               @relation("MatchFeedbackActor")
  /// Direct reporting line (#1781) — what the "never the direct manager"
  /// matching rule reads. Nullable and populated by hand or import for now.
  managerId                         String?
  manager                           User?                         @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports                     User[]                        @relation("UserManager")
  guidanceStates                    UserGuidanceState[]
  createdProgramCosts               ProgramCost[]                 @relation("ProgramCostCreatedBy")
  placements                        Placement[]                   @relation("PlacementMentee")
  twoFactorRecoveryCodes            TwoFactorRecoveryCode[]
  loginLinkTokens                   LoginLinkToken[]
  adminScopeGrants                  AdminScopeGrant[]
  // Text-only practice interviews (#2051).
  practiceSessions                  PracticeSession[]             @relation("PracticeSessions")
  safeguardingReviews               SafeguardingFlag[]            @relation("SafeguardingReviewer")

  // One account per e-mail per tenant. MySQL treats NULLs in a unique index as
  // distinct, so a row whose orgId is still NULL (the default org, until the
  // next deploy's backfill stamps it) is NOT covered by this index — the
  // per-world rule in src/lib/userWorld.ts (`emailTakenInWorld`) is what stops
  // a second one, and it is checked on every create path.
  @@unique([email, orgId])
  @@index([role])
  @@index([referredById])
  @@index([orgId, externalId])
  // The /api/v1 keyset (#1988): candidates page over (updatedAt, id) within one org.
  @@index([orgId, updatedAt, id])
}

// Per-user state for in-product guidance surfaces (#2068): "I have seen this"
// and "I dismissed this", keyed by a surface string (e.g. `checklist:ADMIN`).
// One generic table rather than a flag per surface — a new tip or tour adds a
// key, never a column. It stores only the ACKNOWLEDGEMENT: whether a checklist
// step is done stays derived from the real rows, because a stored "I did it"
// flag can disagree with reality and a derived one cannot.
model UserGuidanceState {
  id          String    @id @default(cuid())
  userId      String
  key         String
  seenAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

// Consent-gated activity trail: one row per page visit, with the dwell time on
// the previous page. Powers the "pages visited / time on site" section of the
// mentee activity report. Only written when the user has granted
// ACTIVITY_TRACKING consent (see src/lib/consent.ts + /api/track/pageview).
model PageView {
  id          String   @id @default(cuid())
  userId      String
  // App-relative path only (query string stripped), capped in the API.
  path        String
  // Seconds spent on this page before navigating away (0 for the entry hit,
  // filled by the next beacon / an unload beacon).
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  /// The retention sweep (#1678) asks the one question the composite index
  /// above cannot serve: "the oldest rows across ALL users, older than X". With
  /// only a userId-leading index that is a full scan plus a filesort on every
  /// batch — on the table that grows fastest in the product, which is exactly
  /// the table the sweep exists for. This is the only schema change #1678 needs.
  @@index([createdAt])
}

// Reusable, auditable per-user consent (GDPR). A consent is "active" when
// grantedAt is set and revokedAt is null. Gates optional processing such as
// sending CV text to an AI provider (see ConsentType).
enum ConsentType {
  AI_CV_PARSING
  // Acceptance of the privacy notice & terms at registration. `version` records
  // which policy version was accepted (GDPR Art. 7 demonstrability).
  PRIVACY_POLICY
  // Opt-in to detailed activity tracking (pages visited + time on site) that
  // feeds the mentee activity report shared with the mentor/admin.
  ACTIVITY_TRACKING
  // Explicit opt-in to being visible to companies (talent-pool search,
  // need-match alerts, early access). GDPR basis for company-facing exposure —
  // required IN ADDITION to publicProfile (#527). Default off.
  TALENT_POOL_VISIBILITY
  // Opt-in to sending the mentee's interaction-log text to the AI provider for
  // the mentor-facing auto-summary (Faz 2, #534). Default off.
  AI_INTERACTION_SUMMARY
  // Mentor's explicit opt-in to being listed in the mentee-facing /mentors
  // directory (#937) — required IN ADDITION to publicProfile, mirroring
  // TALENT_POOL_VISIBILITY. Shown: name, expertise, languages, capacity
  // status, bio. Never: email, phone, mentee list. Default off.
  MENTOR_DIRECTORY_VISIBILITY
  // Opt-in to an excerpt of an evaluation being published on marketing pages
  // (#1096). An evaluation is third-party personal data, so BOTH sides must
  // hold this consent — the author (their words) and the subject (it is about
  // them). Revoking unpublishes immediately (revokePublishedFor). Default off.
  TESTIMONIAL
  // "Write to me again when there is a place" (#834) — permission to be
  // CONTACTED in a later cycle. Deliberately NOT the same thing as permission
  // to keep storing the data: that one is anchored on User.consentAt and
  // governed by lib/retention. Conflating them would turn "yes, get in touch in
  // September" into indefinite retention, which is the exact behaviour this
  // feature exists to end. Joining the pool never moves consentAt.
  RE_ENGAGEMENT_POOL
}

model UserConsent {
  id        String      @id @default(cuid())
  userId    String
  type      ConsentType
  // For versioned consents (e.g. PRIVACY_POLICY): the accepted policy version.
  version   String?
  grantedAt DateTime?
  revokedAt DateTime?
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// Contributor terms as DATA, not code (#1025, design in
// docs/legal/contributor-terms-in-app.md). Terms are versioned rows rather than
// a constant because the click-wrap only holds up if the exact text a person
// accepted can be produced later — and because a second project may one day
// have different IP rules, keyed separately.
model ContributorTerms {
  key             String // 'default' | 'project-x' …
  version         String // '1.0'; changing the text means a NEW row, never an edit
  locale          String // 'en' | 'tr' | 'de'
  // Exactly one locale per (key, version) is the binding text; the others are
  // informative translations. Which one it is has to be recorded, not assumed.
  isAuthoritative Boolean  @default(false)
  body            String   @db.Text // markdown
  effectiveFrom   DateTime
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())

  @@unique([key, version, locale])
  @@index([key, effectiveFrom])
}

// Evidence, not preference: who accepted which version, when, and from where.
// A row is written on acceptance and never updated — a later version produces
// another row, so the history is the record.
model ContributorTermsAcceptance {
  id         String   @id @default(cuid())
  userId     String
  termsKey   String
  version    String
  // null = platform-level acceptance (onboarding). A project id scopes the
  // acceptance to that project — § 40 UrhG is why this is a chain of specific
  // acceptances rather than one blanket future-works consent.
  projectId  String?
  acceptedAt DateTime @default(now())
  // Hashed, never raw: the evidence question is "was it the same client", not
  // "what is their address". Same treatment the rest of the app gives an IP.
  ipHash     String?
  uaHash     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsKey, version, projectId])
  @@index([userId])
  @@index([termsKey, version])
}

// A referral source — the education/agency a mentee came from, or (#2421/#2570)
// the channel a marketing lead came in through: `affiliate:<code>`,
// `utm:<source>/<medium>/<campaign>`, `channel:<acquisition_source>` — the
// naming rule is src/lib/leadSourceName.ts. Admin-managed so reporting can
// group people by where they were sourced.
//
// The name is unique PER ORG (#2570), not globally: two tenants may both have a
// "Google Ads". It was a global `@unique`, which made a second tenant's create
// a 409 about a row it cannot see. The tenant is never encoded into the name
// (an "<orgId>:Google" prefix was rejected — a second scoping mechanism living
// in the data). A NULL orgId is a legacy row of the default org
// (src/lib/tenantFilter.ts); MySQL does not compare NULLs in a unique index, so
// the create paths read the tenant (NULL rows included) before they insert —
// src/lib/leadSource.ts `findOrCreateSource()`.
model Source {
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])
  id           String        @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  createdAt    DateTime      @default(now())

  users User[]

  @@unique([orgId, name])
  @@index([name])
}

enum MessageChannel {
  IN_APP
  EMAIL
}

// Conversation layer for messaging: DIRECT is 1:1, GROUP is project/group chat.
model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType
  // Group conversations can be bound to a project; DIRECT conversations may
  // leave this null.
  projectId String?
  // Deterministic identity for a DIRECT (1:1) conversation: the two participant
  // ids sorted and joined with '|'. Unique, so create-or-get can lean on the
  // constraint instead of a read-then-write race (two simultaneous "message
  // this person" clicks would otherwise create two conversations for the same
  // pair). Null for GROUP conversations — MySQL permits many NULLs in a unique
  // index, so groups are unconstrained.
  directKey String?          @unique
  createdAt DateTime         @default(now())
  // @default(now()) as well as @updatedAt: without a default, adding this
  // required column to the already-deployed table would fail `db push` on any
  // non-empty Conversation table.
  updatedAt DateTime         @default(now()) @updatedAt

  project      Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
  meetings     Meeting[]

  // MySQL permits multiple NULL values, so DIRECT conversations remain
  // unaffected while each project can have only one GROUP conversation.
  @@unique([type, projectId])
}

enum ConversationType {
  DIRECT
  GROUP
}

// Membership for a conversation. Authorization can be derived from
// participants rather than MentorshipRelation ownership.
model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  // When the participant joined the conversation (kept as addedAt for backward
  // compatibility with the already-deployed column from #784).
  addedAt        DateTime  @default(now())
  // Last time this participant read the conversation — powers per-conversation
  // unread counts without a per-message read row.
  lastReadAt     DateTime?
  // Per-viewer inbox state (#1609, src/lib/conversationState.ts). Nullable,
  // no default, no index — additive columns only (see the warning below about
  // indexes on this table). Archived hides the thread behind a filter (nothing
  // is deleted), mutedUntil silences push / e-mail / bell / digest for this
  // viewer until then, pinnedAt sorts the thread first.
  archivedAt     DateTime?
  mutedUntil     DateTime?
  pinnedAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // No explicit @@index([userId]): MySQL already maintains an index on the FK
  // column (ConversationParticipant_userId_fkey), so lookups by userId are
  // covered. Declaring one here makes `db push` try to *rename* that index into
  // ConversationParticipant_userId_idx, and MySQL refuses to drop an index a
  // foreign key depends on ("Can't DROP INDEX ..._userId_fkey"). Harmless when
  // Prisma creates the table itself, fatal on the already-deployed table (#784).

  @@unique([conversationId, userId])
}

// A message in a mentorship thread (legacy) and/or a conversation (new).
// Sent in-app or mirrored from an email; powers mentor ↔ mentee conversations.
model Message {
  id                   String         @id @default(cuid())
  // New conversation-layer link. Nullable for backward compatibility while
  // legacy relation-bound messages still rely on relationId.
  conversationId       String?
  // Legacy mentorship-thread link. Nullable so conversation-only messages can be
  // written; every pre-existing row keeps its relationId, so the mentorship
  // messaging path is untouched.
  relationId           String?
  senderId             String
  body                 String         @db.Text
  channel              MessageChannel @default(IN_APP)
  readAt               DateTime?
  createdAt            DateTime       @default(now())
  // Set once this message has been included in an unread-digest email so the
  // hourly digest cron never re-sends the same message (#667).
  digestedAt           DateTime?
  // Set when the sender edits the message (shows an "(edited)" label).
  editedAt             DateTime?
  // Set when the sender (or an admin) deletes the message for everyone; the body
  // is masked server-side and a "message deleted" placeholder is shown to all.
  deletedForEveryoneAt DateTime?
  // RFC Message-ID of the email this message came from, for messages created by
  // the inbound mail bridge. Unique so an IMAP replay (at-least-once delivery)
  // can never post the same reply twice. Null for messages written in-app.
  inboundMessageId     String?        @unique

  relation          MentorshipRelation? @relation(fields: [relationId], references: [id], onDelete: Cascade)
  conversation      Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  attachments       MessageAttachment[]
  // Per-user "delete for me" — hides the message only from these users' view.
  hiddenFor         MessageHiddenFor[]
  // Emoji reactions (👍❤️😂…) from thread participants.
  reactions         MessageReaction[]
  // Safeguarding flags raised on this message (#2056). Detection never blocks
  // the message; these rows are the admin review queue's record of it.
  safeguardingFlags SafeguardingFlag[]

  @@index([conversationId])
  @@index([relationId])
  // A thread is read a page at a time, newest first (#1609): these let MySQL
  // walk one thread's rows in createdAt order and stop after a page, instead of
  // sorting the whole thread on every open. Added BESIDE the single-column
  // indexes, never in place of them — those back the foreign keys, and asking
  // db push to drop or rename an FK-backing index is what MySQL refuses (#784).
  @@index([conversationId, createdAt])
  @@index([relationId, createdAt])
  // One sender's messages over a window (#1608): the activity report's sent/
  // received counts (`senderId` + `createdAt: { gte }`), the message-retention
  // sweep (`senderId: { in }` + `createdAt: { lt }`, #2056) and erasure.
  @@index([senderId, createdAt])
}

// A single emoji reaction on a message by one user (WhatsApp/Slack style).
// One row per (message, user, emoji) — a user can add several distinct emojis to
// the same message but not the same emoji twice.
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// "Delete for me": a message hidden from a single user's view (the message and
// attachments stay for everyone else). WhatsApp-style per-user deletion.
model MessageHiddenFor {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// A file/image attached to a message (DB bytes, same approach as CvFile/
// Document — no external object storage needed).
model MessageAttachment {
  id          String   @id @default(cuid())
  messageId   String
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// Reusable 1:1 message text — "canned responses" (#1871). The sentence a mentor
// writes forty times a cohort ("send me your CV as a PDF and I'll look at it
// before Friday") becomes one click, in whichever of the three languages the
// writer is working in.
//
// Deliberately the same shape as ProjectTaskTemplate (the trilingual reusable
// text we already ship): `title` is the canonical wording — the fallback when a
// reader's language has no entry, and the key the pool dedupes on — while
// `translations` ({ en?, tr?, de? }) carries the per-locale body. What gets
// inserted into the composer is a plain string resolved once from the *writer's*
// own locale, so nothing downstream (Message, the email mirror, the SSE bus) has
// to know a template was involved at all.
//
// Tenant-anchored: it holds an organisation's own wording, so `orgId` is here and
// the model is in TENANT_MODELS (src/lib/orgContext.ts) — unlike
// ProjectTaskTemplate, which is reached through Project.
model MessageTemplate {
  id      String  @id @default(cuid())
  orgId   String?
  // Null = org-wide, which is what /admin/message-templates manages and what
  // every writer in the tenant is offered. Set = personal, offered to its owner
  // only. Only the org-wide half has a management screen today; the read path
  // already honours both so a "save this reply" affordance is additive.
  ownerId String?

  title             String    @db.Text
  translations      Json?
  // Locales filled by machine translation and not yet reviewed (#2055): a
  // JSON array like ["tr","de"]. A locale leaves it when an admin edits
  // or confirms it; null/[] = everything here was written by a person.
  machineTranslated Json?
  // How many times this text has been inserted — the picker sorts by it, so the
  // replies actually used float to the top and the pool stays usable as it grows.
  useCount          Int       @default(0)
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // Retired from the picker, not deleted (same reasoning as ProjectTaskTemplate,
  // #1113): `useCount` is the only record of which wording a program actually
  // leans on, and re-adding the same text revives this row rather than starting
  // a second one from zero. Nothing here is referenced by a sent Message — the
  // insert is a copy — so this is about the pool's own history.
  archivedAt        DateTime?

  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner     User?         @relation("MessageTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("MessageTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  // No @@unique on the wording: `title` is @db.Text (a canned reply is a
  // paragraph, not a label), which MySQL cannot index without a prefix length,
  // and a nullable orgId/ownerId would not be constrained by it anyway — the
  // same reason /api/admin/goal-templates dedupes by hand.
  @@index([orgId, ownerId, archivedAt])
  @@index([ownerId, archivedAt])
  @@index([createdById])
}

// In-app notification for a user.
model Notification {
  id             String   @id @default(cuid())
  userId         String
  type           String
  // Long-form text (e.g. a broadcast announcement fanned out to every user) —
  // TEXT, not the default VARCHAR(191), so long messages aren't truncated/rejected.
  // Nullable since #921: rows written through the i18n contract carry `params`
  // instead and are rendered from the dictionary in the recipient's locale;
  // `text` remains for announcements (free-form copy) and legacy rows.
  text           String?  @db.Text
  // i18n payload (#921): interpolation values for the dictionary template keyed
  // by `type` (e.g. { from: "Aylin" } for message.new). Null on legacy/announcement rows.
  params         Json?
  // VarChar(500) to match the 500-char cap the announcement API validates; the
  // VARCHAR(191) default rejected long tracking URLs with an unhandled 500.
  link           String?  @db.VarChar(500)
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
  // Set on the rows a broadcast fanned out, so editing the announcement can
  // correct the copy sitting in everyone's bell and deleting it can take those
  // rows with it (#1162). Nullable: every other notification type has no
  // announcement behind it, and an existing row predates this column — a
  // NOT NULL addition here would need a backfill on a live table.
  announcementId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([announcementId])
  // The nightly retention sweep (#1646) selects the oldest out-of-window rows
  // in bounded batches. Without an index every batch is a filesort over the
  // whole table — the exact shape of load the batching exists to avoid.
  //
  // `read` LEADS, and it is not cosmetic: the sweep's predicate is
  // `read = 1 AND createdAt < cutoff ORDER BY createdAt ASC`, and an unread row
  // is never deleted at any age. On a bare `[createdAt]` those permanently
  // undeletable rows sit inside the scanned range for good, so the prefix each
  // batch walks grows every night instead of shrinking. With `read` as the
  // equality prefix they are not in the range at all, and `createdAt` still
  // supplies both the range and the ordering.
  @@index([read, createdAt])
}

// One Web Push endpoint a user has granted us (#1464, #675 Kademe 2).
//
// A push subscription belongs to a *browser profile*, not to a person: the same
// user signing in on a laptop and a phone produces two rows, and clearing site
// data produces a third while orphaning the first. `endpoint` is therefore the
// identity — it is what the push service hands out and what we POST to — and it
// is unique so a re-subscribe updates the row instead of accumulating duplicates
// that would each deliver the same notification.
model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  // The push service's URL for this browser. VarChar(500), not the VARCHAR(191)
  // default: FCM/Mozilla/Apple endpoints are comfortably longer than 191 chars,
  // and 500 * 4 bytes stays inside InnoDB's 3072-byte key limit for the unique
  // index below.
  endpoint     String   @unique @db.VarChar(500)
  // The subscription's public key and auth secret, used to encrypt each payload
  // for this endpoint (RFC 8291). Base64url, so plain VarChar.
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  // Which browser this is, so /account can list "Chrome on Android" rather than
  // an opaque endpoint. Free-form and untrusted — display only.
  userAgent    String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  // Bumped every time the browser re-confirms the subscription, so a row that
  // has not been seen for months can be recognised as dead weight.
  lastSeenAt   DateTime @default(now())
  // Consecutive delivery failures that were NOT a definitive 404/410 (those
  // delete the row immediately). A transient outage must not drop a valid
  // subscription, but a permanently broken one must not be retried forever.
  failureCount Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // No explicit @@index([userId]): MySQL maintains one for the foreign key
  // already, and declaring it makes `db push` try to rename that index — see the
  // same note on ConversationParticipant.
}

// One installed copy of the native app that may be pushed to, for one account
// (#2775, docs/mobile-push.md). The mobile twin of PushSubscription: same
// failure counter, same "never let push disturb the caller" rule, no orgId —
// a token belongs to a User ROW, and a row already lives in exactly one world.
//
// Keyed by (token, host), not by token alone: ONE phone has ONE Expo token, and
// a person signed in to both products on it is two User rows on two hosts. A
// token-unique key would let the second sign-in steal the first product's row.
// Within one host a device holds one account, so a re-registration by another
// account of that product takes the row over (the endpoint rule of
// PushSubscription).
model NativePushToken {
  id           String   @id @default(cuid())
  userId       String
  // `ExponentPushToken[…]` — the address the Expo push service delivers to.
  // A delivery credential: it never leaves the server (src/lib/pushDevices.ts).
  token        String   @db.VarChar(200)
  // The served hostname the app registered on (the product it was signed in
  // to). Sent back as `data.host` so a tap opens the right product.
  host         String   @db.VarChar(255)
  // 'android' | 'ios'. Display only — delivery is platform-neutral.
  platform     String   @db.VarChar(16)
  appVersion   String?  @db.VarChar(32)
  createdAt    DateTime @default(now())
  // Bumped when the app re-confirms the token at launch — the proof that it is
  // still installed and signed in. A delivery does not move it: Expo accepting
  // a message says nothing about the phone.
  lastSeenAt   DateTime @default(now())
  // Consecutive failures that were NOT a definitive DeviceNotRegistered (that
  // one deletes the row at once). Same ceiling as PushSubscription.
  failureCount Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // No explicit @@index([userId]) — the foreign key's own index serves it (see
  // PushSubscription).

  @@unique([token, host])
}

// One row per broadcast admin announcement (distinct from the per-recipient
// Notification rows it fans out to) — lets the admin UI show a history of
// what was sent, by whom, and to how many people.
model Announcement {
  id                String   @id @default(cuid())
  // Broadcast body — TEXT, not the default VARCHAR(191), so admins can publish
  // long-form announcements (release notes, articles) without hitting a limit.
  text              String   @db.Text
  // { en?, tr?, de? } — the announcement in each language it was written in
  // (#1163). `text` above stays the canonical wording and the fallback for a
  // reader whose language has no entry here, so every row written before this
  // column existed keeps working untouched. Nullable for the same reason.
  // Resolved per reader in src/lib/announcementText.ts.
  translations      Json?
  // Locales filled by machine translation and not yet reviewed (#2055): a
  // JSON array like ["tr","de"]. A locale leaves it when an admin edits
  // or confirms it; null/[] = everything here was written by a person.
  machineTranslated Json?
  // VarChar(500) to match the API's 500-char cap — see Notification.link.
  link              String?  @db.VarChar(500)
  sentById          String
  recipientCount    Int
  emailedCount      Int      @default(0)
  createdAt         DateTime @default(now())

  // Optional attached image. Deliberately NOT mirrored into an `imageUrl`
  // column: the URL is a pure function of the announcement id
  // (/api/announcements/<id>/image), so storing it would only add a second write
  // and a field that can disagree with reality.
  image AnnouncementImage?

  // The tenant this announcement belongs to (#2357). Nullable + backfilled.
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([orgId])
}

// An image attached to a broadcast announcement, stored in the database (same
// approach as AvatarFile/CvFile — no object storage, so it survives container
// redeploys). Served via /api/announcements/[id]/image.
model AnnouncementImage {
  id             String   @id @default(cuid())
  announcementId String   @unique
  contentType    String
  size           Int
  data           Bytes
  uploadedAt     DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// E-mail newsletter (#1440)
//
// Distinct from Announcement on purpose, even though both broadcast a body to
// many people. An announcement is operational and time-bound ("the meeting has
// started") — read a week late it is noise, which is why the reader feed hides
// anything older than the account. A newsletter issue is *content*: career tips
// that are as useful in November as they were in August, sent on a schedule,
// addressed to a role (mentees, mentors, or both) rather than to everyone, and
// unsubscribable on its own without silencing the operational mail.
//
// Which is also why the two cannot share a table: targeting, scheduling, an
// archive that stays readable, and a per-recipient delivery record are all
// things Announcement deliberately does not have.
// ─────────────────────────────────────────────────────────────────────────────

enum NewsletterAudience {
  // The default. Everything in the curated library is written for the person
  // looking for a placement.
  MENTEE
  // Mentor-facing issues (how to coach a CV review, what to ask in a mock
  // interview). Never sent to mentees.
  MENTOR
  // One issue, both audiences — mentors additionally get the `mentorNote`
  // block, so the same content reaches a coach with a coaching angle.
  BOTH
}

enum NewsletterStatus {
  // Being written. Never sent by the scheduler, whatever `scheduledAt` says.
  DRAFT
  // Queued: the dispatcher picks it up once `scheduledAt` has passed.
  SCHEDULED
  // Claimed by a dispatch run. A row stuck here means a run died mid-send —
  // resuming is safe because NewsletterSend is unique per (issue, address).
  SENDING
  SENT
  // Pulled before it went out. Kept rather than deleted: "we decided not to
  // send this" is itself part of the record.
  CANCELED
}

model Newsletter {
  id String @id @default(cuid())

  // The curated library entry this issue started from
  // (src/lib/newsletterContent.ts), or null when an admin wrote it from
  // scratch. Only ever a provenance marker: the content below is a full copy,
  // so editing the library never rewrites an issue that already went out.
  templateKey String? @db.VarChar(64)

  audience NewsletterAudience @default(MENTEE)
  status   NewsletterStatus   @default(DRAFT)

  // The canonical (default-locale) subject line — the fallback for a reader
  // whose language this issue was never written in, and what the admin history
  // and the activity log show.
  subject String @db.VarChar(300)

  // { en?: NewsletterIssueContent, tr?: …, de?: … } — the whole issue per
  // language: subject, preheader, intro, tips[], optional CTA and mentorNote.
  // Shape and normalisation live in src/lib/newsletter.ts; Json rather than a
  // table of blocks because an issue is only ever read and written whole.
  content Json

  // When the dispatcher should send it. Null for a draft.
  scheduledAt DateTime?
  // When the dispatch run actually finished. The archive orders by this.
  sentAt      DateTime?

  createdById String

  // Filled in by the dispatch run. Kept as counters next to the per-recipient
  // rows below so the history list needs no aggregate query per issue.
  recipientCount Int @default(0)
  sentCount      Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image NewsletterImage?
  sends NewsletterSend[]

  // The tenant this issue belongs to (#2357). Nullable + backfilled; the
  // dispatcher scopes recipients to it so a marketing issue never reaches an
  // internship tenant's members.
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The dispatcher's own query: "SCHEDULED and due".
  @@index([status, scheduledAt])
  @@index([orgId])
  @@index([sentAt])
  @@index([createdAt])
}

// The hero image of an issue, stored in the database like AnnouncementImage
// (no object storage, so it survives a container redeploy). Attached to the
// e-mail inline via cid: and served to the archive from
// /api/newsletters/[id]/image.
model NewsletterImage {
  id           String   @id @default(cuid())
  newsletterId String   @unique
  contentType  String
  size         Int
  data         Bytes
  uploadedAt   DateTime @default(now())

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
}

// One row per recipient per issue — the delivery record ("gönderilmiş bülten
// geçmişi"). EmailLog already logs every outgoing message, but it is keyed by
// address and pruned after 90 days, so it cannot answer "who has already been
// sent issue X?" — which is exactly what makes a resumed dispatch safe.
//
// The @@unique below is that guarantee: a second run over the same issue
// re-sends to nobody.
model NewsletterSend {
  id           String  @id @default(cuid())
  newsletterId String
  // Null once the account is hard-deleted through a path that predates this
  // table; normally set. PII in `email` is cleared by both erasure modes —
  // see forgetEmailLog in src/lib/accountErasure.ts.
  userId       String?
  email        String  @db.VarChar(320)
  // The language this recipient was actually served, which is worth keeping:
  // it is the only place the per-reader resolution is visible afterwards.
  locale       String  @db.VarChar(8)

  status EmailStatus @default(SENT)
  error  String?     @db.Text
  sentAt DateTime    @default(now())

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsletterId, email])
  @@index([userId])
  @@index([sentAt])
}

// One generated image of an organization's brand icon set (#2922). An upload
// renders ~27 of these under one `version` — every served kind (the bare mark,
// manifest icons, maskable icon, apple-touch icon, favicon, shortcut icons, one
// iOS launch image per device) plus the original as `source`, which is kept so
// a tile-colour change can re-render the set and is NEVER served. Writer:
// src/lib/brandAssets.ts. Reader: the public route under src/app/brand/, by
// (version, kind) only — the version is a hash that carries no organization
// id, and the route runs with no tenant context (the middleware does not scope
// it). Registered in TENANT_MODELS so every other reader stays inside its
// tenant. Stored in the database like AvatarFile: there is no object store,
// and a redeploy must not lose the icons.
model BrandAsset {
  id          String   @id @default(cuid())
  orgId       String
  version     String
  kind        String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([version, kind])
  @@index([orgId])
}

// A user's profile picture, stored in the database (same approach as CvFile).
model AvatarFile {
  id          String   @id @default(cuid())
  userId      String   @unique
  contentType String
  size        Int
  data        Bytes
  uploadedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A user's CV stored in the database (no external object storage needed, so it
// survives container redeploys). Served via /api/cv/[userId].
model CvFile {
  id          String   @id @default(cuid())
  userId      String   @unique
  filename    String
  contentType String
  size        Int
  data        Bytes
  uploadedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum DocumentType {
  CV
  CONTRACT
  CERTIFICATE
  OTHER
}

// Organization-defined document names and applicability. Completion is never
// stored here: it is derived from documents carrying this requirement id.
model DocumentRequirement {
  id             String   @id @default(cuid())
  orgId          String
  key            String
  labels         Json
  appliesToStage String?
  appliesToRole  String?
  mandatory      Boolean  @default(true)
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org       Organization                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents Document[]
  reminders DocumentRequirementReminder[]

  @@unique([orgId, key])
  @@index([orgId, active, order])
  @@index([orgId, appliesToStage])
  @@index([orgId, appliesToRole])
}

// Delivery-only weekly idempotency marker. Missing/completed state is not
// stored here and is always derived from DocumentRequirement + Document.
model DocumentRequirementReminder {
  id            String   @id @default(cuid())
  requirementId String
  menteeId      String
  recipientId   String
  weekStart     DateTime @db.Date
  createdAt     DateTime @default(now())

  requirement DocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  mentee      User                @relation("MissingDocumentReminderSubject", fields: [menteeId], references: [id], onDelete: Cascade)
  recipient   User                @relation("MissingDocumentReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requirementId, menteeId, recipientId, weekStart])
  @@index([menteeId])
  @@index([recipientId])
  @@index([weekStart])
}

// A stored document (DB bytes, like CvFile). Belongs to a user, or is an
// admin-managed template (ownerId null + isTemplate) available to everyone.
// Re-uploading the same (owner, type) keeps prior rows and bumps `version`.
model Document {
  id            String       @id @default(cuid())
  ownerId       String?
  uploaderId    String
  type          DocumentType @default(OTHER)
  title         String
  filename      String
  contentType   String
  size          Int
  data          Bytes
  version       Int          @default(1)
  isTemplate    Boolean      @default(false)
  requirementId String?
  createdAt     DateTime     @default(now())

  owner       User?                @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  requirement DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([requirementId])
  @@index([ownerId, requirementId, version])
  @@index([isTemplate])
}

model Company {
  orgId           String?
  org             Organization? @relation(fields: [orgId], references: [id])
  id              String        @id @default(cuid())
  // A row of the starter pack's sample programme (#2066): synthetic, labelled,
  // removed as a set by DELETE /api/admin/organizations/[id]/sample-data.
  sampleData      Boolean       @default(false)
  name            String
  // TEXT: the company form offers 2 000 characters, far past VARCHAR(191).
  description     String?       @db.Text
  contactEmail    String?
  // The primary contact on the account (#2407) — "who do we call", beside the
  // address column that already existed. Three plain columns rather than a
  // `CompanyContact` table on purpose: there is no Contact model here, a
  // `companyId` User would hand a phone number an auth identity it does not
  // need, and CompanyInquiry's contact columns are an inbound-request record
  // rather than an address book. A real table waits until several contacts per
  // account are actually needed (epic-07).
  //
  // READ EXPOSURE: `GET /api/companies` and `GET /api/companies/[id]` gate on
  // "is there a session" and read the row with `include` and no `select`, so
  // every Company scalar reaches every authenticated user of the tenant. That
  // broad read is #2431. A named person's direct line and a tax identification
  // number are a different category from name/industry/address, so these three
  // plus `vatId` are stripped for non-ADMIN readers at both routes
  // (`src/lib/companyVisibility.ts`) until #2431 scopes the whole payload.
  //
  // Deliberately NO unique constraint on contactEmail. A global `@unique` — what
  // the inherited Marketing schema had on `Contact.email` — punches straight
  // through the tenant boundary (docs/tenant-isolation.md): two tenants may each
  // hold the same merchant, and one would then be unable to save its own row.
  // Were uniqueness ever wanted here it could only be `@@unique([orgId, ...])`.
  contactName     String?
  contactPhone    String?
  // The primary contact's role at the account ("Geschäftsführer"). The three
  // contact columns plus this one ARE the primary contact; CompanyContact holds
  // everyone else (#2442, docs/company-contacts.md).
  contactPosition String?
  // VAT identification number (#2405). The account's strongest identity across
  // systems, and therefore the account import's FIRST matching key; the fallback
  // is normalized name + country (docs/marketing-import.md).
  //
  // Unique per ORG, never globally: the same merchant may legitimately be an
  // account of two tenants. MySQL permits many NULLs inside a unique index, so
  // accounts that carry no VAT number are unconstrained — which is every row the
  // internship product has today, and why this can be added to a populated
  // table at all.
  vatId           String?
  // ISO-3166-1 alpha-2, upper case. The other half of the fallback match key:
  // `address` is free text and cannot answer "which country is this account
  // in", so two merchants of the same name in two countries were one row.
  country         String?       @db.VarChar(2)
  industry        String?
  logoUrl         String?
  size            String?
  address         String?
  quota           Int?
  // The account's id in the source system the tenant's feeds key on (#2446) —
  // an opaque string the upstream source system assigned, never interpreted
  // here. Nullable and unbackfilled: a company typed in by hand, or
  // imported from the old spreadsheet, never has one, and a required column
  // would fail the import that creates it.
  //
  // NOT `@unique`, for the same reason User.externalId (see its comment) and
  // Job.idempotencyKey are not: a global unique reaches across the tenant
  // boundary, and the per-tenant version buys nothing it is asked for — MySQL
  // treats NULLs in a unique index as DISTINCT, so `@@unique([orgId, externalId])`
  // de-duplicates nothing at all while every row still holds a null, i.e. today.
  //
  // `vatId` above IS `@@unique([orgId, vatId])`, and the difference is who
  // writes: a VAT number is typed by a human through the account form and the
  // import, where a rejected write is an answerable message about the row in
  // front of them. An external id is stamped by a background feed with nobody
  // watching, and this epic's rule is that an ambiguous id is REPORTED (count +
  // sample), never guessed at and never turned into a failed chunk at 03:00.
  // The index below is what that lookup reads ("which company of THIS org is
  // external id X?"). Contracts: docs/usage-feed.md and
  // docs/integrations/account-events.md.
  externalId      String?       @db.VarChar(191)
  // The slug of the registered integration source (`IntegrationSource.slug`)
  // whose account event CREATED this row (#2959), stamped in the same insert by
  // the account-event writer (src/lib/accountEventIngest.ts). NULL for every
  // account a person, the demo form or a file import created — and for any
  // account a feed only MATCHED and moved. It is the one reliable answer to
  // "what did this source create?", which the rollback CLI
  // (prisma/wipe-integration-source.mjs) needs: `IntegrationEvent.companyId`
  // is also set by an event that merely moved an existing account. Nullable
  // and unbackfilled: only events ingested after it exists carry it.
  createdBySource String?       @db.VarChar(40)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  needs              CompanyNeed[]
  mentorships        MentorshipRelation[]
  users              User[]                  @relation("CompanyUsers")
  projects           Project[]               @relation("CompanyProjects")
  interests          CompanyInterest[]
  entitlements       CompanyEntitlement[]
  needAlerts         CompanyNeedAlert[]
  offers             Offer[]
  requisitions       Requisition[]
  interviewRequests  InterviewRequest[]
  applications       Application[]
  placements         Placement[]
  // The enquiries this company was created from (#1863). A list rather than a
  // single row because nothing stops a second enquiry from the same company
  // later being linked to the account it already has.
  fromInquiries      CompanyInquiry[]        @relation("ConvertedFromInquiry")
  usage              CompanyUsage[]
  // May we write to / call this account, and on what basis (#2577)? One row
  // per channel; docs/contact-permission.md.
  contactPermissions ContactPermission[]
  // The postal campaigns this account was a recipient of (#2697).
  postRecipients     PostCampaignRecipient[]
  contacts           CompanyContact[]
  // The marketplaces, shop systems and carriers it works on (#2408).
  channels           CompanyChannel[]
  adminScopeGrants   AdminScopeGrant[]

  // Org-scoped, not global — see the `vatId` comment above.
  @@unique([orgId, vatId])
  // Tenant-leading, like every other lookup index in TENANT_MODELS: under
  // MT_ENFORCE_ISOLATION the middleware injects `orgId` into the feed's
  // `findMany({ where: { externalId } })`, and without this it would filter the
  // whole table row by row.
  @@index([orgId, externalId])
  @@index([orgId, createdBySource])
  // The /api/v1 keyset (#1990).
  @@index([orgId, updatedAt, id])
}

// One sales channel of one account (#2408): a marketplace, a shop system or a
// carrier the merchant works on. `channel` is a STRING key from
// src/lib/salesChannels.ts, never an enum — a new marketplace is a code change,
// not a schema change. `status`: USING / INTERESTED / DROPPED. The import
// writes USING and only ADDS rows (a file never removes a channel or overrides
// a status a person set); people edit them on the account page.
model CompanyChannel {
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id])
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel   String        @db.VarChar(40)
  status    String        @default("USING") @db.VarChar(16)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([companyId, channel])
  @@index([orgId, channel, status])
}

// One day of product usage for one account (#2446, story #2399).
//
// The grain is ACCOUNT × DAY, and that is the whole reason this table exists
// next to `UsageRollup` rather than inside it: UsageRollup is the billing meter
// — (org, metric, calendar MONTH), written absolutely by the nightly rollup
// (src/lib/metering.ts) — and a churn signal made of monthly totals arrives six
// weeks after the merchant stopped trading. Nothing here is billable and
// nothing here gates anything; it is a signal.
//
// Filled by the nightly usage sync (#2447) from the feed described in
// docs/usage-feed.md. No job, endpoint or screen
// reads it yet — this slice is the table and the contract only.
model CompanyUsage {
  id String @id @default(cuid())

  // Nullable, mirroring Company's own `orgId` (the phase-1 tenant models): a
  // single-tenant installation has companies with no org, and a required column
  // here would make them unable to hold usage at all. Registered in
  // TENANT_MODELS (src/lib/orgContext.ts), which also means every SESSIONLESS
  // writer — the cron sync, a backfill — must bind `runWithOrg(feed.orgId, …)`
  // or pass `orgId` itself, exactly as src/lib/rosterIngestStore.ts does.
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id])
  companyId String
  // A DAY, not an instant. `@db.Date` for the same reason ProgramCost's period
  // is: usage belongs to a calendar day at the source, and a DateTime would
  // shift it by a timezone offset when it is read back on another continent —
  // which for this table would mean two rows for the same day, or none.
  date      DateTime      @db.Date

  // Counts, both absolute (never deltas): re-fetching an overlapping window
  // OVERWRITES a day rather than adding to it, which is what makes the sync
  // idempotent. `orders` is optional because the feed may not carry it.
  transactions Int  @default(0)
  orders       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // The upsert key: one row per account per day, so the overlapping re-fetch
  // the sync doctrine prescribes cannot produce a second row for a day it
  // already has. It doubles as the index the 90-day sparkline range scan reads
  // — a separate `@@index([companyId, date])` would be a byte-identical second
  // B-tree, maintained on every insert into the fastest-growing table here.
  @@unique([companyId, date])
  // Date-leading, for the one question the composite index above cannot serve:
  // "the oldest rows across ALL accounts, older than X". That is precisely the
  // PageView lesson (see its `@@index([createdAt])` and the note on it) — the
  // retention sweep in src/lib/retentionEntries.ts asks exactly that, nightly,
  // on a table that gains one row per account per day for ever.
  @@index([date])
}

// Premium entitlement (freemium — Faz 0). One row per enabled feature per
// company; the row's PRESENCE means the feature is on (see src/lib/entitlements.ts).
// Mentor/mentee functionality is always free and never gated by this table.
model CompanyEntitlement {
  id        String   @id @default(cuid())
  companyId String
  // A key from PREMIUM_FEATURES (src/lib/entitlements.ts), stored as text so
  // adding features needs no migration.
  feature   String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, feature])
  @@index([companyId])
}

// Support tickets (#586/#592): a relation-independent channel between any user
// and the admins. Deliberately separate from Message (which is bound to a
// MentorshipRelation) — clean boundary, no relation baggage.
enum SupportStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model SupportTicket {
  id              String        @id @default(cuid())
  requesterId     String
  status          SupportStatus @default(OPEN)
  subject         String?
  assignedAdminId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  closedAt        DateTime?

  requester     User             @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedAdmin User?            @relation("SupportAssignee", fields: [assignedAdminId], references: [id])
  messages      SupportMessage[]

  @@index([requesterId])
  @@index([status])
}

model SupportMessage {
  id        String    @id @default(cuid())
  ticketId  String
  senderId  String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  readAt    DateTime?

  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User                @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([ticketId])
}

model SupportAttachment {
  id          String   @id @default(cuid())
  messageId   String
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// A mentee's self-serve request for mentorship (#590). One PENDING request at
// a time; an admin approves (choosing a mentor -> MentorshipRelation) or
// rejects. Powers the self-registration intake (#585).
enum MentorshipRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model MentorshipRequest {
  id                 String                  @id @default(cuid())
  menteeId           String
  status             MentorshipRequestStatus @default(PENDING)
  message            String?                 @db.Text
  targetPosition     String?
  // Structured, NON-BINDING matching preferences (#939): the subject area the
  // mentee wants help with, the languages they can be mentored in, and an
  // optional specific mentor picked from the consent-gated /mentors directory.
  // Admins see these in the approval queue; nothing is auto-assigned.
  preferredField     String?
  preferredLanguages Json                    @default("[]")
  preferredMentorId  String?
  // Re-match (#1801): when set, this request asks to REPLACE the named live
  // pairing rather than to open a first one. The reason code is required at the
  // API (a code from END_REASON_CODES, src/lib/relationLifecycle.ts); the free
  // text note is optional. Both are read by ADMINS ONLY — the outgoing mentor
  // is told the pairing ended and is never shown either field.
  replacesRelationId String?
  rematchReason      String?
  rematchNote        String?                 @db.Text
  decidedById        String?
  decidedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  mentee           User                @relation("MentorshipRequests", fields: [menteeId], references: [id], onDelete: Cascade)
  decidedBy        User?               @relation("DecidedMentorshipRequests", fields: [decidedById], references: [id])
  // SetNull: a mentor leaving must not take pending requests with them — the
  // preference simply disappears while the request survives.
  preferredMentor  User?               @relation("PreferredMentorRequests", fields: [preferredMentorId], references: [id], onDelete: SetNull)
  // SetNull for the same reason: a deleted relation must not delete the record
  // that a re-match was asked for.
  replacesRelation MentorshipRelation? @relation("RematchRequests", fields: [replacesRelationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([menteeId])
  @@index([preferredMentorId])
  @@index([replacesRelationId])
}

// A public, unauthenticated application to become a mentor (#904). No User
// account is created on submission — an admin reviews the queue and, when
// approving, is what turns an applicant into an account (a later task). One
// PENDING application at a time per email, same shape as MentorshipRequest.
enum CompanyInquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// A company asking to be shown the product, submitted from the public
// /for-companies page (internship) or the demo form on the MARKETING landing
// (#2569) — which tenant receives it is decided by the host, see
// src/lib/publicHostOrg.ts. Companies have no self-service sign-up — a COMPANY user
// is only born from an InvitationToken — so this is the bridge: the enquiry is
// stored (rather than only emailed) so a request cannot quietly go missing in
// an inbox, and so an admin can see what is still unanswered.
model CompanyInquiry {
  orgId                     String?
  org                       Organization?        @relation(fields: [orgId], references: [id])
  id                        String               @id @default(cuid())
  companyName               String
  contactName               String
  email                     String
  phone                     String?
  // Roles they are hiring for, and anything else they typed.
  openRoles                 String?              @db.Text
  message                   String?              @db.Text
  // Preferred UI language ('en' | 'tr' | 'de') — the language they read the
  // page in, so a reply can be written in it.
  locale                    String?
  status                    CompanyInquiryStatus @default(NEW)
  // When they accepted the privacy terms — set server-side on submit.
  consentAt                 DateTime?
  // WHICH privacy text they accepted (#2569): PRIVACY_POLICY_VERSION
  // (src/lib/privacy.ts) at the moment of submit, stamped by the server — a
  // consent record without the text version cannot say what was agreed to.
  consentTextVersion        String?
  // The separate, UNCHECKED-by-default "send me product news" box on the
  // marketing form (#2569). A REQUEST, never a send permission: it is a single
  // opt-in anyone could tick for anyone's address, and under UWG §7(2) Nr. 2 it
  // proves nothing until the address owner confirms it (double opt-in). NULL =
  // the form that produced this row never asked (the internship form).
  marketingOptInRequested   Boolean?
  // WHICH product-news wording they ticked (MARKETING_OPT_IN_TEXT_VERSION,
  // src/lib/privacy.ts), stamped by the server — separate from the privacy text
  // version above; the language it was shown in is `locale`. NULL when unticked.
  marketingOptInTextVersion String?
  // When the address owner CONFIRMED it (double opt-in, #2577): the moment
  // they pressed the button behind the link in the confirmation mail. While it
  // is NULL nothing may be mailed on the strength of the request; once set it
  // becomes the account's DOI_CONFIRMED `ContactPermission`
  // (docs/contact-permission.md).
  marketingOptInConfirmedAt DateTime?
  // When the confirmation mail for this request went out (#2577). NULL = none
  // was sent: the box was not ticked, or the per-recipient cap (one per address
  // per day, `ContactConfirmationMailCap`) had already been spent.
  marketingOptInMailSentAt  DateTime?
  // When the address owner said "no" through the opt-out link (#2577). After
  // this the request can no longer be confirmed, and the account's e-mail
  // permission is revoked.
  marketingOptOutAt         DateTime?
  // Marketplaces they sell on (MARKETING form), free text.
  marketplaces              String?              @db.Text
  // Where the request came from (#2569): the host that received it and the
  // campaign parameters / referrer the browser carried. Stored RAW; binding
  // them to a `Source` row is #2570's mapping. No IP is stored.
  receivedHost              String?
  utmSource                 String?
  utmMedium                 String?
  utmCampaign               String?
  utmTerm                   String?
  utmContent                String?
  referrer                  String?              @db.Text
  handledAt                 DateTime?
  handledById               String?
  note                      String?              @db.Text
  createdAt                 DateTime             @default(now())
  // What this enquiry BECAME (#1863). An admin converts a warm lead into a real
  // Company plus an invited COMPANY login in one action; these two columns are
  // the record of that. Their presence is also the idempotence key: the convert
  // endpoint claims the enquiry with a conditional UPDATE on
  // `convertedCompanyId: null`, so a double-click (or two admins on the same
  // row) produces one Company and one invitation, and the loser gets a
  // 409 `already_converted` naming what it already became.
  //
  // The enquiry itself is never deleted — it is the record of where the
  // relationship came from — so this is a link, not a replacement.
  //
  // In a MARKETING org the conversion is a funnel record instead (#2569,
  // src/lib/inquiryLead.ts), written by the marketing import in its own
  // transaction, so the claim is taken BEFORE it: `convertedAt` set while
  // `convertedCompanyId` is still null means "being converted right now" (a
  // claim older than ten minutes is a crashed attempt and may be retaken).
  convertedCompanyId        String?
  convertedAt               DateTime?

  handledBy        User?    @relation("HandledCompanyInquiries", fields: [handledById], references: [id])
  convertedCompany Company? @relation("ConvertedFromInquiry", fields: [convertedCompanyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([orgId])
  @@index([convertedCompanyId])
}

// ── Contact permission (#2577, story #2575) ─────────────────────────────────
//
// "May we write to this account, and can we prove it?" — UWG §7 / DSGVO. One
// row per account × channel holds the CURRENT basis plus its evidence. The rule
// of who may write which basis is ONE file, src/lib/contactPermissionRule.ts
// (dependency-free, unit-tested), and the only writer is
// src/lib/contactPermission.ts. Full design: docs/contact-permission.md.
//
// Company-level, not a `ConsentType` on the lead User: the person we write to
// is the account's contact (`Company.contactEmail`), who is not a User — the
// stand-in lead User has a synthetic address nobody reads.
enum ContactChannel {
  EMAIL
  PHONE
  POST
}

// The legal basis. The same four terms as the channel-rules document (#2576).
//   DOI_CONFIRMED          — the address owner clicked the confirmation link.
//   EXISTING_CUSTOMER_7_3  — §7(3) UWG: a PAYING customer's address, set by an
//                            admin by hand, with a written reason.
//   INQUIRY_REPLY          — they asked us (demo form): we may answer THAT
//                            request, which is not advertising permission.
//   NONE                   — no basis. What every machine path writes.
enum ContactPermissionBasis {
  DOI_CONFIRMED
  EXISTING_CUSTOMER_7_3
  INQUIRY_REPLY
  NONE
}

// Who wrote the current basis — part of the evidence.
enum ContactPermissionSource {
  DOI_LINK
  INQUIRY
  ADMIN
  IMPORT
  INGEST
}

// An account's address book beyond its primary contact (#2442). The primary
// contact stays in Company.contactName/Email/Phone/Position — the columns the
// contact permission (#2577), letter campaigns, the import and the export
// already read — so "exactly one primary" is structural: making a row primary
// SWAPS it with those columns in one transaction (src/lib/companyContacts.ts).
// Deliberately not a User: a contact is no auth principal and never signs in.
// Deliberately not a funnel carrier (docs/marketing-vertical/pipeline-record.md).
model CompanyContact {
  // Registered in TENANT_MODELS; every writer passes the company's own orgId.
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id])
  id        String        @id @default(cuid())
  // Cascade: deleting the account deletes its address book.
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  // Lower-cased on write. Unique per COMPANY, never globally: two tenants may
  // hold the same merchant (see Company.contactEmail).
  email     String?
  phone     String?
  position  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([companyId, email])
  @@index([orgId])
}

// One event a machine source sent us (#2450/#2451): the idempotency claim and
// the per-account high-water mark. The row is inserted FIRST (the unique index
// is the claim, the CompanyInquiry `convertedCompanyId` pattern), so a repeated
// `event_id` writes nothing a second time; `outcome` records what the event did.
// Written only by src/lib/accountEventIngest.ts, which always passes `orgId`.
// Contract: docs/integrations/account-events.md.
model IntegrationEvent {
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  id         String       @id @default(cuid())
  // The source's slug: `IntegrationSource.slug` of the same org.
  provider   String       @db.VarChar(40)
  // The source's own id for this event, lower-cased; unique per org × source.
  eventId    String       @db.VarChar(64)
  eventType  String       @db.VarChar(40)
  // Lower-cased, as Company.externalId stores it.
  externalId String?      @db.VarChar(191)
  occurredAt DateTime
  // processing | applied | stale | refused_backward | recorded | unknown_account | conflict
  outcome    String       @db.VarChar(40)
  detail     String?      @db.VarChar(500)
  companyId  String?
  createdAt  DateTime     @default(now())

  @@unique([orgId, provider, eventId])
  @@index([orgId, provider, externalId, occurredAt])
}

// One machine source a tenant registered (#2914): what the `[source]` segment
// of POST /api/integrations/<slug>/events resolves to. The slug is DATA — the
// code names no source. It is looked up inside the API key's org, so another
// tenant's slug is the same 404 as an unknown one. `slug` is the
// `IntegrationEvent.provider` of this source's events and is immutable: a
// rename would split the dedupe claim and the high-water mark, so a new name
// is a new source. Registered by prisma/register-integration-source.mjs
// (operator CLI; the demo seed adds a `demo-feed` one); read only by
// src/lib/integrationSources.ts.
// Contract: docs/integrations/account-events.md.
model IntegrationSource {
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id        String       @id @default(cuid())
  // Lower-case `^[a-z0-9][a-z0-9-]{1,39}$`, never a static sibling route
  // (src/lib/accountEventRule.ts: SOURCE_SLUG_PATTERN, RESERVED_SOURCE_SLUGS).
  slug      String       @db.VarChar(40)
  // Display name; also the prefix of a placeholder account name
  // ("<label> <external id>") when an event carries no company or person.
  label     String       @db.VarChar(80)
  // A disabled source answers 404, exactly like an unregistered one.
  enabled   Boolean      @default(true)
  // Optional binding: when set, only this `companies:write` key may post for
  // the source (403 `wrong_source_key`); null = any such key of the org.
  apiKeyId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([orgId, slug])
}

model ContactPermission {
  // Nullable like Company's own orgId. Registered in TENANT_MODELS; every
  // sessionless writer (the DOI click, an inquiry placed by the form, the
  // import) passes orgId itself — src/lib/contactPermission.ts.
  orgId       String?
  org         Organization?           @relation(fields: [orgId], references: [id])
  id          String                  @id @default(cuid())
  // Cascade: erasing the account erases its permission rows (#2559). The
  // opt-out stays provable where it matters — on the enquiry row, which keeps
  // its own `marketingOptOutAt` for as long as enquiries are retained.
  companyId   String
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel     ContactChannel
  basis       ContactPermissionBasis  @default(NONE)
  source      ContactPermissionSource
  // The address (EMAIL) the basis was established for. A permission is for an
  // address, not for whatever `contactEmail` says later: if the contact
  // changes, the old confirmation does not cover the new person.
  address     String?                 @db.VarChar(320)
  // Evidence of a DOI: the opt-in wording version and language shown, when the
  // box was ticked and when the link was confirmed. No IP address (data
  // minimisation — the demo form promises none; the signed link bound to the
  // address plus the two timestamps is the proof).
  textVersion String?
  textLocale  String?                 @db.VarChar(5)
  requestedAt DateTime?
  confirmedAt DateTime?
  // The enquiry the evidence came from. No foreign key: enquiries have their
  // own retention, and the copy above is what must survive them.
  inquiryId   String?
  // EXISTING_CUSTOMER_7_3 / manual changes: who and why. Plain id, no FK — the
  // ActivityLog carries the actor too.
  grantedById String?
  reason      String?                 @db.Text
  // Revocation (opt-out link, or an admin). The basis is kept so the history
  // still says what was revoked; an effective permission needs this NULL.
  revokedAt   DateTime?
  revokedVia  String?                 @db.VarChar(16)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([companyId, channel])
  @@index([orgId, channel, basis])
}

// The per-recipient cap on confirmation mails (#2577, #2569 § 9): at most ONE
// double-opt-in mail per address per UTC day, whichever tenant's form asked.
// The key is HMAC-SHA256(server secret, normalised address) + ':' + day, so this table holds no
// address, and the cap is enforced by the primary key — two concurrent
// submits cannot both insert it. Deliberately no orgId: the cap protects the
// RECIPIENT, whose inbox is not per tenant. Rows older than a day are swept on
// the next insert.
// ── Outbound acquisition: postal advertising (#2697) ────────────────────────
//
// In Germany the one lawful COLD outbound channel to a business is the letter
// (Briefwerbung): e-mail, LinkedIn DM and list-dialled phone calls need a
// consent we do not have (UWG § 7 Abs. 2; docs/marketing-vertical/
// outreach-compliance.md § 2). A letter needs no UWG consent but it does need
// the DSGVO record: where the address came from (Art. 14 Abs. 2 lit. f), a
// written balancing of interests (Art. 6 Abs. 1 lit. f), the Art. 14 notice on
// the letter and a permanent block list for whoever objects (Art. 21 Abs. 3).
// These three tables are that record. Rule: src/lib/postCampaignRule.ts; store:
// src/lib/postCampaign.ts; design: docs/marketing-vertical/postal-campaigns.md.

enum PostCampaignStatus {
  DRAFT
  // Printed and posted. From here the campaign is EVIDENCE: what was sent, to
  // whom, on what stated basis — no edit, no recipient change, no delete.
  SENT
}

model PostCampaign {
  orgId         String?
  org           Organization?      @relation(fields: [orgId], references: [id])
  id            String             @id @default(cuid())
  name          String             @db.VarChar(120)
  // Art. 14 Abs. 2 lit. f: where the addresses came from, printed on the back
  // of every letter of this campaign.
  dataSource    String             @db.Text
  // Art. 6 Abs. 1 lit. f: the written balancing of interests. Not printed —
  // kept as the accountability record (Art. 5 Abs. 2).
  balancingNote String             @db.Text
  letterBody    String             @db.Text
  // The campaign code: utm_campaign on the letter's link and the short path
  // /b/<code>. Lower-case [a-z0-9-]; unique per org.
  code          String             @db.VarChar(60)
  status        PostCampaignStatus @default(DRAFT)
  sentAt        DateTime?
  createdById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  recipients PostCampaignRecipient[]

  @@unique([orgId, code])
  @@index([orgId, createdAt])
}

model PostCampaignRecipient {
  orgId         String?
  org           Organization? @relation(fields: [orgId], references: [id])
  id            String        @id @default(cuid())
  campaignId    String
  campaign      PostCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // The address block as it was printed — the account's address may change
  // after the letter went out, and the record is of the letter.
  recipientName String?       @db.VarChar(191)
  addressBlock  String        @db.Text
  sentAt        DateTime?
  createdAt     DateTime      @default(now())

  @@unique([campaignId, companyId])
  @@index([orgId, companyId, sentAt])
}

// The block list (Sperrliste, Art. 21 Abs. 3 DSGVO). A person who objected to
// direct marketing must never be written to again — also after their account
// is deleted, which is exactly when an ordinary "revoked" row disappears with
// it (onDelete: Cascade). So this table holds only a keyed HMAC of each
// identifying key (VAT id, name+country, e-mail, postal address), never the
// key itself: it can answer "is this one blocked?" and nothing else.
model ContactSuppression {
  orgId     String?
  org       Organization?  @relation(fields: [orgId], references: [id])
  id        String         @id @default(cuid())
  channel   ContactChannel
  keyHash   String         @db.VarChar(64)
  createdAt DateTime       @default(now())

  @@unique([orgId, channel, keyHash])
}

model ContactConfirmationMailCap {
  key       String   @id @db.VarChar(80)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum MentorApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model MentorApplication {
  orgId        String?
  org          Organization?           @relation(fields: [orgId], references: [id])
  id           String                  @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  // Areas the applicant can mentor in — same shape as User.skills.
  expertise    Json                    @default("[]")
  // Free-form professional background.
  experience   String?                 @db.Text
  // Why they want to mentor.
  motivation   String?                 @db.Text
  // Max concurrent mentees they could take on — mirrors User.mentorCapacity.
  capacity     Int?
  linkedinUrl  String?
  // Preferred UI language ('en' | 'tr' | 'de'), mirrors User.preferredLanguage.
  locale       String?
  status       MentorApplicationStatus @default(PENDING)
  decidedAt    DateTime?
  decidedById  String?
  // Set when rejecting; explains the decision to the reviewing admin later.
  // Written ONLY by the reject action — never by the "save a note" action,
  // which used to overwrite it and destroy the reason (#1806).
  rejectReason String?                 @db.Text
  // Free-form review note an admin keeps while working through the queue.
  // Private to admins and NEVER sent to the applicant — unlike rejectReason,
  // which at least documents a decision that was communicated, this is
  // internal commentary and no e-mail template may ever read it.
  adminNote    String?                 @db.Text
  // When the applicant accepted the privacy/data terms — set server-side on
  // submit, mirrors User.consentAt.
  consentAt    DateTime?
  createdAt    DateTime                @default(now())

  decidedBy User? @relation("DecidedMentorApplications", fields: [decidedById], references: [id])

  @@index([status])
  @@index([email])
  @@index([orgId])
}

// An offer extended to a mentee within a mentorship (#809). `status` is a free
// String (not an enum) — same reasoning as MentorshipRelation.pipelineStatus —
// validated + transitioned through the central state machine in
// src/lib/offers.ts (DRAFT -> SENT -> ACCEPTED|DECLINED|EXPIRED|WITHDRAWN).
// `compensationNote` is sensitive: only ADMIN and the offer's own MENTEE may
// ever have it selected server-side (enforced in the API layer, not just hidden
// in the UI).
model Offer {
  id                   String             @id @default(cuid())
  orgId                String?
  org                  Organization?      @relation(fields: [orgId], references: [id])
  relationId           String
  relation             MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  // Optional link to the company's staffing need this offer fills. Plain id,
  // not a FK — CompanyNeed rows aren't guaranteed to persist for the life of
  // the offer, and the offer must remain readable even if the need is edited.
  requisitionId        String?
  // When this offer's acceptance was counted into its requisition's `filled`
  // (#1411/#1854). Stamped in the same transaction as the increment, and only
  // when the increment happened — so it is both the idempotency guard (a
  // replayed accept cannot count twice) and the record of which offers `filled`
  // is made of. Null for an offer that was never accepted, has no requisition,
  // or was accepted into a requisition that was already full.
  requisitionCountedAt DateTime?
  companyId            String?
  company              Company?           @relation(fields: [companyId], references: [id])
  status               String             @default("DRAFT")
  position             String
  startDate            DateTime?
  compensationNote     String?            @db.Text
  // Structured compensation (#1851). The free-text note above STAYS as the
  // elaboration; these are the figures a benchmark can read. Same money rule
  // as ProgramCost/Placement (see "MONEY IS ALWAYS AN INTEGER IN MINOR UNITS"
  // below): integer minor units + ISO 4217 code, never a Float or a Decimal.
  // Every one of these rides the compensationNote visibility rule
  // (canSeeCompensation, src/lib/offers.ts) — ADMIN and the offer's own
  // MENTEE, nobody else, and never SELECTed for anyone else.
  // `basePeriod` HOURLY|MONTHLY|YEARLY and `contractType`
  // INTERNSHIP|WORKING_STUDENT|FIXED_TERM|PERMANENT are Strings validated
  // against the whitelists in src/lib/compensation.ts, not enums — the
  // `db push` reasoning at Organization.planKey applies.
  currency             String?            @db.VarChar(3)
  baseAmountMinor      Int?
  basePeriod           String?            @db.VarChar(10)
  signingBonusMinor    Int?
  otherBonusMinor      Int?
  equityNote           String?            @db.VarChar(500)
  hoursPerWeek         Int?
  contractType         String?            @db.VarChar(20)
  expiresAt            DateTime?
  sentAt               DateTime?
  decidedAt            DateTime?
  declineReasonCode    String?
  // Optional free-text elaboration on the decline reason (never required).
  declineNote          String?            @db.Text
  createdById          String
  createdBy            User               @relation("OfferCreatedBy", fields: [createdById], references: [id])
  decidedById          String?
  decidedBy            User?              @relation("OfferDecidedBy", fields: [decidedById], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([orgId, status])
  @@index([relationId])
  @@index([orgId, currency])
  // The /api/v1 keyset (#1990).
  @@index([updatedAt, id])
}

// Dedupe marker for premium CompanyNeed match alerts (Faz 1, #530). One row per
// company+mentee: once a matching candidate has triggered an alert for a
// company, we never re-notify for the same candidate (the "*SentAt" pattern).
model CompanyNeedAlert {
  id        String   @id @default(cuid())
  companyId String
  menteeId  String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mentee  User    @relation("CompanyNeedAlertMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([companyId, menteeId])
  @@index([companyId])
}

// One row per successful AI provider call (Faz 2, #537) — the metering behind
// the monthly AI quota (Setting.aiMonthlyQuota). scope identifies the feature
// (e.g. "cv_extract"); userId/companyId record who consumed it (companyId
// prepares per-company quotas for multi-tenancy).
model AiUsage {
  id        String   @id @default(cuid())
  scope     String
  userId    String?
  companyId String?
  // The tenant whose monthly AI quota this call consumed. Nullable so the column
  // is appliable to a populated table; legacy rows are attributed by
  // prisma/backfill-ai-usage-org.mjs (user → company), the rest fall to the
  // default org in backfill-organization.mjs. Registered in TENANT_MODELS.
  orgId     String?
  createdAt DateTime @default(now())

  // How the call ended (#2024): 'ok', 'parse_error' (the provider answered,
  // the reply was not the JSON asked for — the task fell back) or
  // 'provider_error' (it never answered). Only the first two consume quota:
  // a failure must stay visible without costing the tenant anything.
  outcome String @default("ok") @db.VarChar(20)

  // What the call was and what it cost (#2022). All nullable so the columns
  // apply to the populated table; rows from before them carry NULL (the deploy
  // runs prisma/backfill-ai-usage-task.mjs to copy `scope` into `taskId`).
  // `taskId` is the registry key (src/lib/ai/tasks.ts) — the same string as
  // `scope`, which stays as the historic column every reader already groups on.
  // `costMicros` is the provider's list price in MICRO-DOLLARS
  // (src/lib/ai/pricing.ts); null when the model is not in the rate table,
  // never an estimate. `latencyMs` is the time spent waiting on the provider
  // across the attempts of this one logical call.
  taskId       String? @db.VarChar(64)
  provider     String? @db.VarChar(32)
  model        String? @db.VarChar(64)
  inputTokens  Int?
  outputTokens Int?
  costMicros   Int?
  latencyMs    Int?
  // The prompt-injection tripwire's hits over the call's untrusted input
  // (#2026, src/lib/ai/injection.ts), comma-joined — e.g.
  // "instruction_override,prompt_exfiltration". A flag, never a block: the call
  // ran normally. Null when nothing tripped. Never the text itself.
  flags        String? @db.VarChar(191)

  @@index([createdAt])
  @@index([scope])
  @@index([orgId, createdAt])
  @@index([taskId, createdAt])
}

// Per-task AI switches and quota overrides of ONE organisation (#2032). The
// org-wide kill switch is the `aiEnabled` Setting; this table holds what is
// decided per task: off, or a monthly allowance of its own (null = the org's
// `aiMonthlyQuota`). No row means "on, inherit" — the chain lives in
// src/lib/ai/policy.ts and is the only reader. Tenant configuration, so it is
// in TENANT_MODELS; `taskId` is a registry key (src/lib/ai/tasks.ts), not a
// foreign key, so a retired task's row is harmless and a typo never compiles
// into the gate.
model AiFeatureSetting {
  id           String   @id @default(cuid())
  orgId        String
  taskId       String   @db.VarChar(64)
  enabled      Boolean  @default(true)
  monthlyQuota Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, taskId])
  @@index([orgId])
}

// What an AI call PRODUCED (#2044) — AiUsage above is the meter (that a call
// happened); this is the artefact, so a result survives a reload, can be shared
// with a mentor, and an identical request inside the task's TTL is answered
// from here without a provider call or a unit of quota. Written by
// runAiGated's `persist` option; read and shared through src/lib/ai/artifacts.ts.
//
// `subjectUserId` — whose data it is about — is a REAL relation with
// onDelete: Cascade (unlike AiUsage.userId), so erasing the person erases what
// was generated about them. `taskId` is runAiGated's `scope` until the #2022
// registry exists. `visibility`: PRIVATE | SHARED_WITH_MENTOR | SHARED_WITH_ADMIN.
model AiArtifact {
  id            String        @id @default(cuid())
  orgId         String?
  org           Organization? @relation(fields: [orgId], references: [id])
  taskId        String        @db.VarChar(64)
  subjectUserId String?
  subject       User?         @relation("AiArtifactSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  relationId    String?
  requisitionId String?
  createdById   String
  inputHash     String        @db.VarChar(64)
  content       String        @db.Text
  contentJson   Json?
  model         String?       @db.VarChar(80)
  visibility    String        @default("PRIVATE") @db.VarChar(24)
  pinned        Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([subjectUserId, taskId, createdAt])
  @@index([inputHash])
  @@index([orgId, createdAt])
}

// A company's read/interest signal on a candidate they're linked to via a
// MentorshipRelation (EPIC: company shortlist). One record per company+mentee
// pair; re-setting the status updates it in place.
enum InterestStatus {
  INTERESTED
  SHORTLISTED
  PASS
}

model CompanyInterest {
  id            String         @id @default(cuid())
  companyId     String
  menteeId      String
  requisitionId String?
  // Stable application-derived discriminator: legacy:<companyId>:<menteeId>
  // or requisition:<requisitionId>:<menteeId>. Unlike nullable compound
  // uniques, this remains reliable on MySQL when requisitionId is null.
  scopeKey      String?        @unique
  status        InterestStatus
  // TEXT: the shortlist API accepts 1 000 characters, past VARCHAR(191).
  note          String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mentee      User         @relation("CompanyInterestMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  requisition Requisition? @relation(fields: [requisitionId], references: [id], onDelete: Restrict)

  @@index([companyId, menteeId])
  @@index([menteeId])
  @@index([requisitionId])
}

// Outgoing webhook subscription (admin-managed). Events are sent as signed
// POSTs (HMAC-SHA256 of the body in the X-Signature header).
model Webhook {
  id        String        @id @default(cuid())
  // The tenant this webhook belongs to (#2357). Nullable + backfilled to the
  // default org so existing rows keep working; every dispatch filters by it, so
  // one tenant's event never fires another tenant's endpoint.
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    Json          @default("[]")
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  // A subscription a connector made for itself through POST /api/v1/hooks
  // (#2002): the key that owns it — the only key that may list or delete it —
  // and where it came from (`admin` | `api`). Both null on every admin-created
  // row; additive and nullable on purpose, never a re-key of Webhook. A
  // revoked or expired owner key stops its deliveries (src/lib/webhooks.ts).
  apiKeyId  String?
  apiKey    ApiKey?       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  source    String?       @db.VarChar(20)

  @@index([orgId, active])
  @@index([apiKeyId])
}

// Read-only programmatic access key. Only the SHA-256 hash is stored.
// A minted programmatic credential for the public /api/v1 surface.
//
// Lifecycle (#1545): a key is no longer just "a name and a hash". It knows WHO
// minted it (createdById), WHEN it stops being valid (expiresAt), WHAT it may
// read (scopes) and WHETHER it was withdrawn (revokedAt).
//
// Revocation is SOFT on purpose: the row is never deleted. The
// `apikey.revoked` ActivityLog entry points at this id, and a hard delete would
// leave that audit trail pointing at nothing — the evidence of what the key did
// would disappear together with the key.
//
// `scopes` is a comma-separated list in the canonical `<resource>:<action>`
// shape (see src/lib/apiScopes.ts). One value exists today — `candidates:read`,
// the only /api/v1 route — but the shape is fixed now so later resources slot
// in without a migration. ENFORCEMENT of expiry/revocation/scope at the door is
// #1546; this model only stores the facts.
model ApiKey {
  orgId           String?
  org             Organization?       @relation(fields: [orgId], references: [id])
  id              String              @id @default(cuid())
  name            String
  hashedKey       String              @unique
  // Comma-separated `<resource>:<action>` scopes. Defaulted (not nullable) so
  // `db push` fills existing rows non-destructively; the backfill normalises
  // any row that ended up empty.
  scopes          String              @default("candidates:read")
  // The admin who minted the key. Nullable: rows that predate #1545 have no
  // recorded owner, and a deleted admin must not take the key's history away.
  createdById     String?
  createdBy       User?               @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])
  // Null means "never expires" — allowed, but flagged in the admin UI.
  expiresAt       DateTime?
  // Set by the soft revoke; the row itself stays forever.
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime            @default(now())
  // Period allowance (#2010). Both null = no period quota (the per-minute
  // limit still applies) — every key minted before this stays exactly as it
  // was. `quotaPeriod` is 'day' | 'month' (UTC calendar periods).
  quotaPeriod     String?             @db.VarChar(10)
  quotaLimit      Int?
  usage           ApiKeyUsage[]
  idempotencyKeys ApiIdempotencyKey[]
  webhooks        Webhook[]
  exports         ApiExport[]

  @@index([orgId])
  @@index([createdById])
}

// Requests per API key per quota period (#2010) — the only counter model the
// per-key quota adds. Written in BATCHES by src/lib/apiKeyQuota.ts (an
// in-process tally flushed every few seconds as one `increment` upsert per
// key), never once per request: a write per request would turn the meter into
// an amplifier for the traffic it measures. The increment is atomic in the
// database, so replicas add up rather than overwrite each other, and the
// count survives a restart (minus at most one unflushed window).
model ApiKeyUsage {
  id          String   @id @default(cuid())
  apiKeyId    String
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  orgId       String?
  periodStart DateTime
  requests    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([apiKeyId, periodStart])
  @@index([orgId])
}

// One Idempotency-Key a key sent to an /api/v1 write (#1994). The first request
// claims the row (responseStatus null while it runs); a retry with the same
// key AND the same request hash replays the stored 2xx response instead of
// writing twice; the same key with a different hash is 409
// `idempotency_key_reused`. Only successes are kept — a refused or failed
// write frees its key so the caller can retry. Rows older than
// IDEMPOTENCY_TTL_MS are ignored and swept nightly. A brand-new model: the
// key must never be attached by re-keying ApiKey (drop-and-recreate under
// --accept-data-loss).
model ApiIdempotencyKey {
  id             String   @id @default(cuid())
  orgId          String
  apiKeyId       String
  apiKey         ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  key            String   @db.VarChar(200)
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(191)
  // sha256 hex of method + path + raw body.
  requestHash    String   @db.Char(64)
  responseStatus Int?
  // Capped (IDEMPOTENT_BODY_MAX); a larger response is replayed without its body.
  responseBody   String?  @db.Text
  createdAt      DateTime @default(now())

  @@unique([apiKeyId, key])
  @@index([orgId])
  @@index([createdAt])
}

// An asynchronous snapshot of one /api/v1 resource (#3002): queued by
// POST /api/v1/exports, written by the `api.export` job as gzipped NDJSON
// (src/lib/api/v1Exports.ts), fetched only through a signed link that expires,
// and deleted after `expiresAt`. Stored in the database like CvFile — there is
// no object storage, and a file on one replica's disk is not on the other's.
model ApiExport {
  id         String    @id @default(cuid())
  orgId      String
  apiKeyId   String
  apiKey     ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  resource   String    @db.VarChar(40)
  // Interaction note bodies included — the key's `interactions:read_notes` at
  // request time, re-checked when the file is fetched.
  withNotes  Boolean   @default(false)
  // PENDING | RUNNING | READY | FAILED
  status     String    @default("PENDING") @db.VarChar(16)
  rowCount   Int?
  byteSize   Int?
  // gzip(NDJSON); null until READY.
  content    Bytes?
  // A stable code (`too_many_rows`, `too_large`, `key_inactive`), never a message.
  error      String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  expiresAt  DateTime

  @@index([orgId])
  @@index([apiKeyId, status])
  @@index([expiresAt])
}

// Key-value system settings, admin-editable (e.g. reminder cadence, support
// email). Values are stored as strings; callers parse as needed.
//
// Resolved per tenant with a global fallback (#1553) — the ONE place that rule
// lives is src/lib/settings.ts; never read this table directly.
//
//   orgId = <tenant>  → that tenant's override
//   orgId = NULL      → the GLOBAL layer, inherited by every tenant that has no
//                       row of its own (and the only layer a single-tenant
//                       installation ever writes)
//
// The natural key is (orgId, key), but a nullable column cannot be part of a
// primary key, so the table carries a surrogate `id` and enforces the pair with
// a unique index. MySQL treats NULLs as distinct in a unique index, so that
// index constrains the per-tenant rows only; uniqueness of the global layer is
// held by settings.ts being the single writer (read-modify-write, never a blind
// insert).
model Setting {
  id        String   @id @default(cuid())
  orgId     String?
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

// A project must be owned by exactly one of: an admin, a mentor, or a company.
enum ProjectOwnerType {
  ADMIN
  MENTOR
  MENTEE
  COMPANY
}

// An internship project. May belong to a company (owner=COMPANY) or be a
// community project owned by an admin/mentor. Mentees are assigned via
// MentorshipRelation.projectId. Ownership is transferable (audited).
model Project {
  orgId          String?
  org            Organization?    @relation(fields: [orgId], references: [id])
  id             String           @id @default(cuid())
  name           String
  description    String?          @db.Text
  technologies   Json             @default("[]")
  repoUrl        String?
  demoUrl        String?
  boardUrl       String?
  status         ProjectStatus    @default(ACTIVE)
  isPublic       Boolean          @default(false)
  goals          String?          @db.Text
  startDate      DateTime?
  endDate        DateTime?
  ownerType      ProjectOwnerType
  ownerUserId    String?
  ownerCompanyId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Which contributor terms this project's members accept, and whether it asks
  // at all (#1026). A key rather than a foreign key: the terms are versioned
  // rows, and a project follows the *document*, not one frozen version of it —
  // pointing at a row would pin the project to wording that has been superseded.
  // null → the platform default. `contributorTermsRequired = false` is for a
  // project that genuinely has no IP question (a reading group, a demo).
  contributorTermsKey      String?
  contributorTermsRequired Boolean @default(true)

  ownerUser     User?                 @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  ownerCompany  Company?              @relation("CompanyProjects", fields: [ownerCompanyId], references: [id])
  relations     MentorshipRelation[]
  tasks         ProjectTask[]
  members       ProjectMember[]
  conversations Conversation[]
  meetingSeries MeetingSeries[]
  meetings      Meeting[]
  taskTemplates ProjectTaskTemplate[]
  joinRequests  ProjectJoinRequest[]

  @@index([ownerUserId])
  @@index([ownerCompanyId])
}

// Person-level project membership (#617): a project can have several OWNERs
// (admins/mentors) and several MENTORs. Company ownership stays on
// ownerCompanyId; legacy ownerType/ownerUserId are kept in sync with the
// OWNER rows for backward compatibility until every consumer reads members.
enum ProjectMemberRole {
  OWNER
  MENTOR
  MENTEE
}

// Functional (job) role of a project member — orthogonal to the structural
// role above (owner/mentor/mentee). Optional; used mainly for mentee members
// so a project can show who does what (#51).
enum ProjectFunctionalRole {
  DEVELOPER
  TESTER
  MARKETING
}

model ProjectMember {
  id             String                 @id @default(cuid())
  projectId      String
  userId         String
  role           ProjectMemberRole      @default(MENTOR)
  functionalRole ProjectFunctionalRole?
  addedAt        DateTime               @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
}

// One to-do. Three shapes, one model, because one person reads them in a single
// list (/todos):
//   - a project goal            — projectId set, assigneeId null: open, claimable
//   - a to-do handed to someone — projectId set, assigneeId set
//   - a personal to-do          — projectId null, assigneeId set: written by the
//                                 person for themselves (or by their mentor)
//
// `templateId` is what makes a to-do *shared* (#1113): the wording then lives in
// the template, in every language, and this row only tracks that the person was
// given it and whether they are done. `title` is a snapshot for search,
// notifications and the day the template row disappears.
model ProjectTask {
  id          String    @id @default(cuid())
  // Null = a personal to-do that belongs to no project.
  projectId   String?
  title       String
  done        Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  // Optional owner of the task (#51). Null = an unassigned project-wide goal
  // that any member may claim ("üstlen"); set = a personal goal, which is what
  // a mentor sends a fresh member from the template pool.
  assigneeId  String?
  // Who wrote it — so "your mentor gave you this" and "you wrote this yourself"
  // are distinguishable on the to-do list.
  createdById String?
  // Who ticked it off, and when — so a mentor can see progress per person
  // without reading the activity log.
  doneAt      DateTime?
  // Finished and put away by the assignee. The row stays (it is the record that
  // the work was done), it just leaves the active list.
  archivedAt  DateTime?
  // Set when this to-do came from the shared pool: the text is read from the
  // template, in the reader's language, every time it is displayed.
  templateId  String?
  // When it is meant to be finished (#2440). Nullable and nullable it stays: a
  // to-do without a date is the normal case, so "overdue" is a claim only about
  // the rows that carry one, and undated ones sort to the END of the list.
  // Read as a CALENDAR DAY, never as an instant — src/lib/taskDue.ts is the one
  // place that decides what "late" means.
  dueDate     DateTime?

  project     Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?                  @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  author      User?                  @relation("ProjectTaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  // A template is archived rather than deleted, so this normally stays intact;
  // SetNull is the safety net that leaves the snapshot title behind.
  template    ProjectTaskTemplate?   @relation("TaskFromTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  // The minutes line this to-do was promoted from (#1849), when it was.
  minutesItem SessionNoteActionItem?

  @@index([projectId])
  @@index([assigneeId])
  @@index([templateId])
  @@index([createdById])
}

// Reusable goal/task text (#51). Every task written for a project member is
// worth keeping: a new member usually gets the same starter goals. A template
// with `projectId` set belongs to that project; `projectId = null` makes it
// available everywhere (the shared starter pool).
// Not tenant-anchored: reached through Project / User, like the other child
// models (see TENANT_MODELS in src/lib/orgContext.ts).
model ProjectTaskTemplate {
  id                String    @id @default(cuid())
  projectId         String?
  // The fallback wording, and the key the pool dedupes on. A localized title
  // lives in `translations`; `title` is what a member sees when their language
  // has no entry there.
  title             String
  // { en?, tr?, de? } — the goal in each language it has been written in. The
  // task created from a template is a plain string, resolved once from the
  // assignee's own language (src/lib/goalTemplates.ts).
  translations      Json?
  // Locales filled by machine translation and not yet reviewed (#2055): a
  // JSON array like ["tr","de"]. A locale leaves it when an admin edits
  // or confirms it; null/[] = everything here was written by a person.
  machineTranslated Json?
  createdById       String?
  // How many times this template has been handed to someone — the pool sorts
  // by it so the goals actually used float to the top.
  useCount          Int       @default(0)
  createdAt         DateTime  @default(now())
  // Retired from the pool, not deleted (#1113). Handing a to-do out creates a
  // live reference to this row, so removing it would blank the wording for
  // everyone who was ever given it. Archived means "don't offer this again";
  // adding the same wording back revives the row.
  archivedAt        DateTime?
  // The tenant whose pool this template is in (cross-world isolation). The
  // shared (`projectId: null`) half used to be ONE global pool offered to every
  // organization, so a MARKETING admin saw — and could reword — the internship
  // starter goals. Nullable for the expand step (#2298);
  // prisma/backfill-task-template-org.mjs stamps legacy rows from their project,
  // else their author, else the default org. NULL reads as the default org.
  orgId             String?

  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("TaskTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     ProjectTask[] @relation("TaskFromTemplate")

  // One template per wording per project, so capturing a goal that already
  // exists is a no-op. MySQL allows many NULLs here, so the shared (global)
  // pool is not constrained by it.
  @@unique([projectId, title])
  @@index([projectId])
  @@index([orgId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A request to join a *public* project (#51). Anyone signed in may ask; the
// project's owner (or an admin) approves, which creates the ProjectMember row.
model ProjectJoinRequest {
  id             String                 @id @default(cuid())
  projectId      String
  userId         String
  message        String?                @db.Text
  // What the applicant wants to do on the project; carried onto the member row.
  functionalRole ProjectFunctionalRole?
  status         JoinRequestStatus      @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?                @db.Text
  createdAt      DateTime               @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("JoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  // One open-or-decided request per person per project; re-applying reuses the row.
  @@unique([projectId, userId])
  @@index([status])
}

// Mentor-side onboarding checklist for a mentee (#51). Created lazily the first
// time the mentor opens the wizard for a mentee who joined the site or one of
// their projects. `steps` holds { "<stepKey>": true } so adding a step later
// never needs a migration.
model MenteeOnboarding {
  id          String    @id @default(cuid())
  mentorId    String
  menteeId    String
  // The project whose membership triggered the wizard, when it was a project
  // join rather than a plain site signup. Informational.
  projectId   String?
  steps       Json      @default("{}")
  dismissedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  mentor User @relation("OnboardingMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee User @relation("OnboardingMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([mentorId, menteeId])
  @@index([menteeId])
}

// A mentor's recurring weekly availability window.
model AvailabilitySlot {
  id        String   @id @default(cuid())
  mentorId  String
  weekday   Int // 0 = Sunday .. 6 = Saturday
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  createdAt DateTime @default(now())

  // Set → a ONE-OFF on that calendar date (#2001), offered once, never repeated.
  // `weekday` stays non-null and is derived from it on write, so every existing
  // query keeps working. A past one-off is filtered out of the read.
  date DateTime? @db.Date
  // "office hours", "interview prep" — shown next to the hours.
  note String?   @db.VarChar(120)

  // Block length for this window (#2003), overriding the mentor's
  // MentorBookingPolicy.defaultSlotMinutes; null → that default.
  slotMinutes Int?

  mentor User @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
}

// A mentor's booking guardrails (#2003): one row per person, because these
// are person-level rules — a copy per slot would have to be edited in ten
// places. Minutes everywhere, never hours: #1808's admin CSV import writes
// `minNoticeMinutes` and `maxPerMonth` into this row, and those names and units
// are the contract with it. Every column null = no rule. Enforced in one place,
// src/lib/bookingPolicy.ts, on every write path; judged by the pure
// src/lib/bookingPolicyRule.ts.
//
// No `orgId`, deliberately: like AvailabilitySlot it hangs off User and is
// reached only through `mentorId`; writes go through src/lib/availabilityAccess.ts.
model MentorBookingPolicy {
  id                 String   @id @default(cuid())
  mentorId           String   @unique
  minNoticeMinutes   Int?
  bufferMinutes      Int?
  maxPerWeek         Int?
  maxPerMonth        Int?
  defaultSlotMinutes Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  mentor User @relation("MentorBookingPolicy", fields: [mentorId], references: [id], onDelete: Cascade)
}

// A stretch of days a mentor is away (#2001) — holiday, exams, a busy month.
// Every slot occurrence whose date, in the MENTOR's zone, falls inside
// [startDate, endDate] (both inclusive) is not offered; the weekly pattern
// underneath is untouched, so coming back needs no rebuilding.
//
// No `orgId`, deliberately: like AvailabilitySlot this hangs off User and is
// reached only through `mentorId`, and neither is in TENANT_MODELS
// (src/lib/orgContext.ts). A model that is not anchored gets no automatic
// tenant protection, so every reader makes the `mentorId → User` hop itself —
// see src/lib/availabilityAccess.ts.
model AvailabilityException {
  id        String   @id @default(cuid())
  mentorId  String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?  @db.VarChar(120)
  createdAt DateTime @default(now())

  mentor User @relation("AvailabilityExceptions", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
}

// A cohort groups mentees/internships by intake period for comparison.
model Cohort {
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id])
  id        String        @id @default(cuid())
  name      String
  term      String?
  createdAt DateTime      @default(now())

  relations        MentorshipRelation[]
  programCosts     ProgramCost[]
  steps            ProgramStep[]
  adminScopeGrants AdminScopeGrant[]
}

// ── Program journey (#1852) ──────────────────────────────────────────────────
// "What happens in week 6": one scheduled step of a programme's journey, an
// offset from an anchor (the relation's start, the programme's start, or the
// day the relation entered a stage). Hangs off the programme container — the
// Cohort row, which #1622 renames to Program behind @@map("Cohort"), so this FK
// survives that rename untouched. The vocabularies (anchor, audience, action,
// the skip conditions in payload) are whitelists in src/lib/programJourneyRule.ts,
// free Strings here by repo convention. A step is live only once published and
// until archived; it is never deleted while it has runs, so the journey of a
// relation can still say what it was sent.
model ProgramStep {
  id           String    @id @default(cuid())
  orgId        String?
  programId    String
  order        Int       @default(0)
  // The milestone the builder groups the step under (#1853) — a label, not a
  // row: a journey stays one flat, serialisable list a template can copy.
  milestone    String?   @db.VarChar(120)
  // RELATION_START | PROGRAM_START | STAGE_ENTRY (payload.stageKey names the stage).
  anchor       String    @default("RELATION_START") @db.VarChar(32)
  offsetDays   Int       @default(0)
  // MENTOR | MENTEE | BOTH — who of the pair receives it.
  audience     String    @default("BOTH") @db.VarChar(16)
  // NUDGE | ASSIGN_TODO | PUBLISH_CONTENT | SUGGEST_AGENDA | GROUP_SESSION
  action       String    @db.VarChar(32)
  // Per-action detail: { stageKey?, url?, agendaTemplateId?, skipIf? }.
  payload      Json?
  // The fallback wording; `translations` carries { en?, tr?, de? }.
  title        String    @db.VarChar(191)
  translations Json?
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org     Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  program Cohort           @relation(fields: [programId], references: [id], onDelete: Cascade)
  runs    ProgramStepRun[]

  @@index([orgId])
  @@index([programId, order])
}

// One step delivered (or deliberately skipped) for one relation. The unique is
// the claim: two sweeps on the same day — or two replicas — insert one row, and
// the loser's P2002 is the "already done" answer, not a query beforehand.
// Reached through its step, which is tenant-scoped; deliberately not in
// TENANT_MODELS (no orgId of its own, the same shape as ApplicationEvent).
model ProgramStepRun {
  id            String    @id @default(cuid())
  stepId        String
  relationId    String
  dueAt         DateTime
  deliveredAt   DateTime?
  // Why it was recorded and not delivered (e.g. "satisfied:meeting_exists").
  skippedReason String?   @db.VarChar(64)
  createdAt     DateTime  @default(now())

  step     ProgramStep        @relation(fields: [stepId], references: [id], onDelete: Cascade)
  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@unique([stepId, relationId])
  @@index([relationId])
}

model CompanyNeed {
  id        String @id @default(cuid())
  companyId String
  position  String
  count     Int
  period    String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model MentorshipRelation {
  orgId                   String?
  org                     Organization?    @relation(fields: [orgId], references: [id])
  id                      String           @id @default(cuid())
  // A row of the starter pack's sample programme (#2066): synthetic, labelled,
  // removed as a set by DELETE /api/admin/organizations/[id]/sample-data.
  sampleData              Boolean          @default(false)
  mentorId                String
  menteeId                String
  companyId               String?
  projectId               String?
  cohortId                String?
  startDate               DateTime         @default(now())
  status                  MentorshipStatus @default(ACTIVE)
  // When the relation was marked COMPLETED. Anchors the post-mentorship CV and
  // document access window (#854) — without it, "access ended six months ago"
  // is unanswerable and mentors keep reading a former mentee's CV forever.
  // Cleared if the relation is reopened as ACTIVE.
  completedAt             DateTime?
  // The /api/v1 keyset (#1990). @default(now()) so db push can add it to a
  // table with rows; existing rows start at the deploy instant.
  updatedAt               DateTime         @default(now()) @updatedAt
  // Stage key. Free String (was the PipelineStatus enum) so tenants can define
  // their own stages (#747). The enum below is kept as the canonical default
  // key registry; values are unchanged for existing rows (ENUM→VARCHAR keeps
  // them), so single-tenant behaviour is identical.
  pipelineStatus          String           @default("APPLICATION_100")
  // WHY the relation exists (#1503): PLACEMENT (the person is in the hiring
  // funnel — every placement count reads only these) or COACHING (mentoring
  // with no placement goal; its stage means nothing to a funnel). Free String,
  // not an enum, for the same reason as pipelineStatus (#747): changing an
  // enum under `db push` is an ENUM→VARCHAR migration. Vocabulary and guard:
  // src/lib/placementKind.ts.
  kind                    String           @default("PLACEMENT") @db.VarChar(16)
  // WHOSE outcome a hire is (#1503): THROUGH_US | SELF_FOUND | ALREADY_EMPLOYED.
  // NULL = not stated; never backfilled, and read as THROUGH_US for rows from
  // before the column (the UNSPECIFIED pattern of #810).
  employmentAttribution   String?          @db.VarChar(24)
  // When the relation (re-)entered the placement funnel: the start for a
  // PLACEMENT, the moment of a COACHING → PLACEMENT switch. NULL → readers fall
  // back to startDate.
  funnelEnteredAt         DateTime?
  // Optional deadline for the current pipeline stage; powers overdue flagging
  // and deadline reminders.
  stageDeadline           DateTime?
  // Set when an overdue-stage reminder was last sent (avoids re-notifying daily).
  deadlineReminderSentAt  DateTime?
  // Set when a stale-mentee in-app notification was last sent; cleared once the
  // mentee has a recent interaction again, so each staleness episode notifies the
  // mentor only once (#573).
  stalenessReminderSentAt DateTime?
  // Dormant first contact (#1501). Stamped by the daily sweep when the relation
  // is still parked in the pipeline's FIRST stage, an outreach already went out
  // and nothing came back (lib/dormantFirstContact.ts). Cleared the moment any
  // sign of life appears, so a later silence can flag — and nudge — again.
  dormantSince            DateTime?
  // "Still interested?" check-ins sent to the MENTEE for the current dormancy
  // episode: how many (capped at DORMANT_MAX_NUDGES) and when the last one went
  // out. Both reset with dormantSince, so a person who comes back and goes quiet
  // months later is written to again rather than being silently written off.
  dormantNudgeCount       Int              @default(0)
  dormantNudgeSentAt      DateTime?
  // The contractual trial window of a MARKETING funnel record (#2413, story
  // #2392). Both nullable and both additive: a mentorship relation never has a
  // trial, and a marketing record only has one once it reaches the TRIAL_ACTIVE
  // stage — so an untouched row keeps meaning exactly what it meant before, and
  // `db push` can add the columns over a populated table.
  //
  // NO NEW TABLE, and deliberately NOT `stageDeadline`. `stageDeadline` is an
  // INTERNAL service level: src/lib/stageSla.ts rewrites it on every stage
  // change and the deadline sweep warns once after it is breached. A trial end
  // is the opposite kind of date — it is agreed with the customer, it survives
  // every stage change, and it is the thing the reminders are counted back
  // from. Storing it in `stageDeadline` would make an SLA edit move a
  // contractual date, and moving the record to another stage would erase it.
  trialStartedAt          DateTime?
  trialEndsAt             DateTime?
  // A won customer's notice period (#2841): the day
  // their contract ends after they gave notice. Same class of date as
  // `trialEndsAt` — agreed, contractual, survives every stage change — so the
  // same reasoning against `stageDeadline` applies. Set only on a DEAL_WON
  // record (src/lib/contractEndRule.ts); cleared when the customer withdraws
  // the notice. The record stays DEAL_WON until a human moves it to DEAL_LOST.
  contractEndsAt          DateTime?
  // When the end-day bell went out, so a re-run never rings twice. Cleared
  // with the date.
  contractEndRemindedAt   DateTime?
  // The owner's own "next step" on this record (#2563): a date and a short
  // line — "call Thursday about pricing". All three nullable and additive, so
  // `db push` adds them over a populated table and an untouched row means what
  // it meant before.
  //
  // Deliberately NOT `stageDeadline`, for the same reason the trial dates above
  // are not: `stageDeadline` is the internal SLA that src/lib/stageSla.ts
  // rewrites on every stage change. A follow-up date is set by a person and
  // must survive every stage move — no stage write path touches these columns.
  // Stored as a UTC calendar day (midnight UTC); the rule, including what
  // "due" and "overdue" mean, is src/lib/nextActionRule.ts.
  //
  // Two columns, not a table: a record has ONE next step, and what was done
  // before it is already the InteractionLog. The note is owner/ADMIN prose, so
  // the read paths that hand relation scalars to the MENTEE strip all three
  // (stripNextActionFor in the same module).
  nextActionAt            DateTime?
  nextActionNote          String?          @db.VarChar(280)
  // Set when the due-day reminder for the CURRENT nextActionAt went out, by a
  // conditional claim in checkNextActionReminders(); a write that moves the
  // date clears it, so each date reminds its owner exactly once.
  nextActionRemindedAt    DateTime?
  // The state the pairing is in (#1768): ACTIVE | PAUSED | COMPLETED |
  // ENDED_REMATCHED | ENDED_REASSIGNED | ENDED_CHURNED — keys, transitions and
  // the one derivation of `status` live in src/lib/relationLifecycle.ts. It
  // started (#1801) as "how did it END"; it now says every state, and `status`
  // is the derived liveness flag (statusForLifecycle) that the many existing
  // ACTIVE/COMPLETED readers keep reading unchanged — a PAUSED pair is still
  // status ACTIVE.
  //
  // A free String, NOT an enum — same reasoning as `pipelineStatus` (#747): an
  // ENUM→VARCHAR change is a migration we cannot review under `db push`, and a
  // new state must never need one. Don't tidy it into an enum.
  //
  // Nullable with a DB default: expand → backfill → contract (#2298). New rows
  // get 'ACTIVE'; rows written before #1768 hold NULL until
  // prisma/backfill-relation-lifecycle.mjs fills them on deploy. Making it
  // required is a later, separate contract step.
  lifecycleState          String?          @default("ACTIVE")
  // When the pairing was paused (#1768); cleared on resume. Never on a live,
  // unpaused row.
  pausedAt                DateTime?
  // Why the pairing ended, as picked by the person who ended it (#2289): a code
  // from src/lib/relationLifecycle.ts (ADMIN_END_REASON_CODES). Nullable and
  // never backfilled — a relation closed before this column existed, or closed
  // as an honest COMPLETED, carries none.
  //
  // A CODE, and deliberately no free-text column beside it. Several read paths
  // return a relation's scalars to the mentor or the mentee (they use Prisma
  // `include`, which selects every column), so prose stored here would reach
  // the very person it is about — #1801 makes "the outgoing mentor is never
  // shown the reason" a rule, and a candid note only stays candid if it is not
  // read back. A coarse code is the same kind of fact `StatusChange.reasonCode`
  // already exposes on those paths; the admin's free-text elaboration lives in
  // the ActivityLog entry, which only admins read.
  endReasonCode           String?
  // The pairing this one continues (#2289). Set on the relation CREATED by a
  // mentor transfer, pointing at the one that was closed as ENDED_REASSIGNED —
  // so the incoming mentor's blank page has a readable predecessor and the
  // mentee's history is reachable instead of merely still existing somewhere.
  // NOTHING is moved between the two: every child row (interactions,
  // evaluations, notes, messages) stays on the relation it was written under,
  // because re-pointing `relationId` would re-attribute the outgoing mentor's
  // work to the incoming one — InteractionLog has no author column of its own.
  previousRelationId      String?

  mentor                User                     @relation("MentorRelations", fields: [mentorId], references: [id])
  mentee                User                     @relation("MenteeRelations", fields: [menteeId], references: [id])
  company               Company?                 @relation(fields: [companyId], references: [id])
  project               Project?                 @relation(fields: [projectId], references: [id])
  cohort                Cohort?                  @relation(fields: [cohortId], references: [id])
  interactions          InteractionLog[]
  statusChanges         StatusChange[]
  slaBreaches           SlaBreach[]
  meetings              Meeting[]
  // Who attended its meetings (#2014), kept even when a meeting is deleted.
  attendance            MeetingAttendance[]
  messages              Message[]
  evaluations           Evaluation[]
  // INTERIM/FINAL due dates and their reminders (#1891).
  evaluationDues        EvaluationDue[]
  programStepRuns       ProgramStepRun[]
  goals                 Goal[]
  sessionAgendas        SessionAgenda[]
  sessionNotes          SessionNote[]
  meetingRequests       MeetingRequest[]
  questions             MentorQuestion[]
  relationNotes         RelationNote[]
  offers                Offer[]
  weeklyReports         WeeklyReport[]
  weeklyReportReminders WeeklyReportReminder[]
  trialReminders        TrialReminder[]
  placement             Placement?
  // The record's ESTIMATED monthly value (#2422) — its own row, never a scalar
  // here; see model RelationValue for why.
  value                 RelationValue?
  rematchRequests       MentorshipRequest[]      @relation("RematchRequests")
  previousRelation      MentorshipRelation?      @relation("RelationChain", fields: [previousRelationId], references: [id], onDelete: SetNull)
  // At most one successor in practice (a closed relation is transferred once),
  // but the FK cannot express that, so Prisma types it as a list.
  nextRelations         MentorshipRelation[]     @relation("RelationChain")
  // Standing 1:1 rules on this pairing (#2013).
  meetingSeries         MeetingSeries[]
  // Nightly health snapshots (#1901); removed with the relation.
  healthSnapshots       RelationHealthSnapshot[]

  // The promised meeting cadence, in weeks (#2014); null = no promise made,
  // so the pair is never "off cadence" (src/lib/meetingCadence.ts).
  expectedMeetingIntervalWeeks Int?

  @@index([status])
  @@index([lifecycleState])
  @@index([pipelineStatus])
  @@index([kind])
  @@index([previousRelationId])
  // The daily trial sweep asks for one org's relations in one stage whose trial
  // ends inside the next week; this is the column that narrows it.
  @@index([trialEndsAt])
  // The daily follow-up sweep asks for the ACTIVE relations whose next action
  // falls on or before today (#2563).
  @@index([nextActionAt])
  // The /api/v1 keyset (#1990).
  @@index([orgId, updatedAt, id])
}

// A mentor's structured evaluation of a mentee within a mentorship.
enum EvaluationType {
  INTERIM
  FINAL
  // A scorecard written during a hiring interview (#824). Unlike the other two
  // it may exist before any mentorship does, which is why relationId is
  // nullable and subjectId names the candidate directly.
  INTERVIEW
}

enum GoalStatus {
  OPEN
  DONE
}

// When an INTERIM or FINAL evaluation is due, and whether the mentor has been
// reminded (#1891). One row per relation and type — the unique is the claim,
// so two sweeps (or two replicas) create one row. `dueAt` comes from the org's
// schedule (src/lib/evaluationDue.ts): N days after the relation entered the
// configured stage. `completedAt` is stamped by POST /api/evaluations when the
// mentor (or an admin) writes that type — not by polling — and stops the
// reminders at once. At most two reminders, ever (EVALUATION_MAX_REMINDERS).
model EvaluationDue {
  id             String             @id @default(cuid())
  orgId          String?
  org            Organization?      @relation(fields: [orgId], references: [id])
  relationId     String
  relation       MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  type           EvaluationType
  dueAt          DateTime
  remindersSent  Int                @default(0)
  lastRemindedAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())

  @@unique([relationId, type])
  @@index([orgId])
  @@index([completedAt, dueAt])
}

model Evaluation {
  id          String         @id @default(cuid())
  // Nullable since #824: an interview happens before a mentorship exists (a
  // company round especially), so a scorecard has no relation to hang off.
  // Every pre-existing row and every INTERIM/FINAL evaluation still carries one
  // — the existing queries all filter by it or traverse the relation, so they
  // are unaffected.
  relationId  String?
  // Who is being evaluated. Only set for relation-less rows (interviews); for a
  // relation-backed row the subject is relation.menteeId, and duplicating it
  // would mean a backfill and a second source of truth.
  subjectId   String?
  // The interview panel this scorecard belongs to (#824).
  panelId     String?
  // Blind scoring: a scorecard counts — and becomes visible to the rest of the
  // panel — only once submitted. Null means its author has not committed to it.
  // INTERIM/FINAL rows are submitted the moment they are written.
  submittedAt DateTime?
  authorId    String
  type        EvaluationType @default(INTERIM)
  scores      Json           @default("{}") // { criterion: 1..5 }
  comment     String?        @db.Text
  createdAt   DateTime       @default(now())
  // When this record was last CORRECTED inside its edit window (#1893). Null
  // means "never corrected", which is also every row written before #1893.
  //
  // Deliberately NOT a Prisma `@updatedAt`: an Evaluation row is written by
  // several flows that change nothing about the author's judgement — drafting a
  // testimonial excerpt, approving or declining it, publishing, unpublishing,
  // and the bulk revoke when a mentee withdraws consent. A generic last-write
  // column would mark all of those as "corrected", which is precisely the
  // mislabelling this flag exists to prevent. Only PATCH
  // /api/evaluations/[id] ever writes it.
  correctedAt DateTime?
  // Which rubric this was scored against (#822). Null means the built-in 4+4
  // criteria, which is every row written before org templates existed and every
  // row in an org that never defined one. Stamped at write time so a record
  // keeps rendering with the labels of its own era even after the org rewrites
  // its framework — criteria are deactivated, never deleted, for the same
  // reason.
  templateId  String?

  // Consent-based testimonial publishing (#1096/#1098). The original comment
  // is never published or edited: the admin drafts publicExcerpt, the AUTHOR
  // approves that exact wording (excerptApprovedAt — cleared on every edit),
  // and only then can publish set publishedAt + sharedPublicly. Revoking the
  // TESTIMONIAL consent on either side clears the publish fields immediately.
  sharedPublicly    Boolean   @default(false)
  publishedAt       DateTime?
  publicExcerpt     String?   @db.Text
  excerptApprovedAt DateTime?

  relation MentorshipRelation? @relation(fields: [relationId], references: [id], onDelete: Cascade)
  panel    InterviewPanel?     @relation(fields: [panelId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: losing a template must never delete the evaluations
  // written against it.
  template EvaluationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([relationId])
  @@index([sharedPublicly, publishedAt])
  @@index([templateId])
  @@index([subjectId])
  @@index([panelId])
}

// Structured interview scoring (#824).
//
// The point of a panel is the ORDER: every interviewer scores independently and
// cannot see anyone else's scorecard, and only once the panel is complete does
// the calibration view show them side by side. Break that order and the
// scorecard is theatre — an interviewer who reads a colleague's 2 before
// writing their own does not produce an independent signal.
//
// That rule is enforced in the API, never merely hidden in the UI.
model InterviewPanel {
  id                   String    @id @default(cuid())
  orgId                String?
  // The candidate being interviewed.
  subjectId            String
  // The rubric to score against (#822). Null = the org's built-in mentee
  // criteria, resolved at read time like everywhere else.
  templateId           String?
  title                String?
  scheduledAt          DateTime?
  createdById          String?
  // Set when an admin closes the panel early — a no-show interviewer must not
  // hold the calibration view hostage for ever. Closing reveals the scorecards
  // that were submitted.
  closedAt             DateTime?
  // The calendar entry this panel scores (#1846): set when an interview
  // request is scheduled with `createPanel`, so `scheduledAt` is the meeting's
  // and the interviewers are on a calendar.
  meetingId            String?   @unique
  // The decision a closed panel produced (#1846): ADVANCE | REJECT | OFFER,
  // written once by POST /api/interview-panels/[id]/outcome and never by a
  // side effect. The application it moved is kept so the funnel can be read
  // back from the panel.
  outcome              String?
  outcomeAt            DateTime?
  outcomeById          String?
  outcomeApplicationId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  members          InterviewPanelMember[]
  scorecards       Evaluation[]
  meeting          Meeting?               @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  interviewRequest InterviewRequest?

  @@index([orgId, subjectId])
  @@index([subjectId, createdAt])
}

model InterviewPanelMember {
  id      String @id @default(cuid())
  panelId String
  userId  String

  panel InterviewPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, userId])
  @@index([userId])
}

// Per-tenant competency framework (#822), the same shape #747 gave pipeline
// stages: an org that defines nothing keeps exactly the built-in criteria, and
// one that defines a template replaces them for that scope.
//
// `scope` is a plain String validated against a whitelist in code
// (src/lib/evaluation.ts), not a Prisma enum — the same convention the rest of
// this repo uses for status-like values, so adding a scope is not a migration.
model EvaluationTemplate {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  // 'MENTEE' (mentor scores the mentee) | 'MENTOR' (mentee scores the mentor).
  scope     String
  // Only one active template per org+scope is used; the rest are history.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  criteria    EvaluationCriterion[]
  evaluations Evaluation[]

  @@index([orgId, scope, active])
}

model EvaluationCriterion {
  id         String  @id @default(cuid())
  templateId String
  // The key stored inside Evaluation.scores. Stable: renaming a criterion
  // changes its labels, never its key, or historical scores stop matching.
  key        String
  // { en?, tr?, de? } — the label in each language it was written in. A missing
  // language falls back to English, then to the key itself, so a half-translated
  // framework still renders.
  labels     Json
  order      Int     @default(0)
  // Retired, not deleted (#822): an evaluation scored against this criterion
  // still has to render its label years later.
  active     Boolean @default(true)

  template EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId, order])
}

// A structured question from a mentee to their mentor, with an optional answer.
// Distinct from chat: each question has an answered/unanswered state.
model MentorQuestion {
  id         String    @id @default(cuid())
  relationId String
  askedById  String
  question   String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
}

enum MeetingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A mentee-initiated meeting request. The mentor accepts (creating a Meeting)
// or declines. Distinct from Meeting, which is the confirmed event.
model MeetingRequest {
  id            String               @id @default(cuid())
  relationId    String
  requestedById String
  topic         String
  proposedAt    DateTime
  status        MeetingRequestStatus @default(PENDING)
  createdAt     DateTime             @default(now())

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
}

// A mentee's private personal note (only the author can see it).
model PersonalNote {
  id        String   @id @default(cuid())
  userId    String
  // 'MEETING' | 'FEEDBACK' | 'TASKS' | 'PERSONAL' — validated in the API, not
  // a DB enum, so new categories don't need a schema change.
  category  String   @default("PERSONAL")
  // Which meeting this note was taken in (#1056). Null for a free-standing note.
  // SetNull rather than Cascade: deleting the meeting must not delete what was
  // written in it — the note is the durable part.
  meetingId String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([meetingId])
}

// A mentor-private note on a mentorship relation (impressions, prep notes,
// red flags) — visible only to the authoring mentor and admins, never the
// mentee (EPIC: mentor private notes).
model RelationNote {
  id         String   @id @default(cuid())
  relationId String
  authorId   String
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  author   User               @relation("RelationNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([relationId])
}

// The pair's SHARED minutes (#1847): one record of what was said and agreed,
// readable and editable by both the mentor and the mentee (an admin reads).
// Deliberately a THIRD model beside PersonalNote (author-private, "only the
// author can see it") and RelationNote (mentor-private): rows in those two were
// written under an explicit privacy promise, and a visibility flag on either
// would break it retroactively. `meetingId` and `agendaId` are SetNull for the
// PersonalNote reason — deleting the meeting or the agenda must not delete what
// was written in it; the minutes are the durable part.
//
// No `orgId`, deliberately: this is a child of MentorshipRelation, which IS in
// TENANT_MODELS (src/lib/orgContext.ts), so it is reached only through a scoped
// parent — the same arrangement as MeetingGuest under Meeting. Worth stating,
// because a model that is not anchored gets no automatic tenant protection and
// every reader has to know that on purpose.
model SessionNote {
  id          String   @id @default(cuid())
  relationId  String
  meetingId   String?
  agendaId    String?
  body        String   @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  relation    MentorshipRelation      @relation(fields: [relationId], references: [id], onDelete: Cascade)
  meeting     Meeting?                @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  agenda      SessionAgenda?          @relation(fields: [agendaId], references: [id], onDelete: SetNull)
  createdBy   User?                   @relation("SessionNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  revisions   SessionNoteRevision[]
  actionItems SessionNoteActionItem[]

  @@index([relationId])
  @@index([meetingId])
}

// A `- [ ]` line of the minutes promoted to a to-do (#1849): the link that
// keeps the two in step — ticking the to-do ticks the line, ticking the line
// ticks the to-do. `text` is the line as promoted, which is how the line is
// found again after the body is edited (lines move; wording rarely does). One
// to-do per line, one line per to-do (taskId @unique). Cascade from the note:
// without the minutes there is nothing to keep in step; the to-do itself
// stays (SetNull on the task side would be wrong — the row IS the link).
// Reached through SessionNote → MentorshipRelation, so no `orgId` either.
model SessionNoteActionItem {
  id        String   @id @default(cuid())
  noteId    String
  taskId    String   @unique
  text      String
  createdAt DateTime @default(now())

  note SessionNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

// Who changed the minutes after the meeting (#1847): an append-only trail, one
// row per saved edit holding the body AS SAVED and who saved it. The routes
// keep the last SESSION_NOTE_REVISIONS_KEPT rows per note; there is no diff UI.
// Reached through SessionNote → MentorshipRelation, so no `orgId` either.
model SessionNoteRevision {
  id        String   @id @default(cuid())
  noteId    String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  note   SessionNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author User?       @relation("SessionNoteRevisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([noteId, createdAt])
}

// A goal set within a mentorship — supports goal setting + tracking (checklist 7).
model Goal {
  id              String     @id @default(cuid())
  relationId      String
  title           String
  description     String?    @db.Text
  status          GoalStatus @default(OPEN)
  dueDate         DateTime?
  createdAt       DateTime   @default(now())
  // Set when the goal is marked DONE (cleared if reopened); powers the
  // "completed todos" line of the activity report.
  completedAt     DateTime?
  // Which side created the goal (mentor vs mentee), so it's clear at a glance.
  createdByRole   Role?
  // Who created it (#1858) — the one reader of a PRIVATE goal. Null on rows
  // older than the column; src/lib/goalVisibilityRule.ts falls back to
  // createdByRole for those.
  createdById     String?
  // "How you will know it is achieved" — free text beside the title (#1858).
  successCriteria String?    @db.Text
  // The date the pair aims at, distinct from dueDate (the deadline).
  targetDate      DateTime?
  // 0-100, entered by hand until sub-tasks derive it (#1858).
  progress        Int?
  // Sharing scope: PAIR (default) | PROGRAM | PRIVATE. Enforced at the route
  // level by src/lib/goalVisibilityRule.ts, never only in the component.
  visibility      String     @default("PAIR")

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
}

// ── Session agendas (#1841) ──────────────────────────────────────────────────
// "What are we going to talk about." Two pairs of tables: a reusable,
// trilingual guided-conversation LIBRARY (AgendaTemplate + its items), and the
// per-session INSTANCE a pair works through (SessionAgenda + its items), which
// hangs off a MentorshipRelation and optionally off the Meeting it was held in.
// Same shape as ProjectTaskTemplate / ProjectTask on purpose: the canonical
// string is the dedupe key and the fallback wording, `translations` carries the
// per-locale text, and a templated item resolves its wording LIVE from the
// template in the reader's language (src/lib/agendas.ts) — rewording a prompt
// in the library reaches every session that was given it. UI is #1843.
model AgendaTemplate {
  id           String    @id @default(cuid())
  // The tenant whose library this is. Nullable like ProjectTaskTemplate.orgId
  // (#2298): the starter set may be seeded before the default org exists on a
  // first deploy, and NULL reads as the default org.
  orgId        String?
  // The Program (#1622) this conversation belongs to. Nullable until that
  // model lands; a plain id on purpose so this change does not wait for it.
  programId    String?
  // Who the conversation is for. PAIR today; a group session gets its own value.
  audience     String    @default("PAIR")
  // The fallback wording, and the key the library dedupes on (@@unique below).
  title        String
  // { en?, tr?, de? } — the title in each language it has been written in.
  translations Json?
  // { en?, tr?, de? } — one or two sentences on when to hold this conversation.
  summary      Json?
  // How many sessions were instantiated from it — the picker sorts by it.
  useCount     Int       @default(0)
  createdAt    DateTime  @default(now())
  // Retired from the library, not deleted (#1113): instantiating one creates a
  // live reference from SessionAgenda.templateId, and removing the row would
  // blank the wording of every session that was held from it. Archived means
  // "don't offer this again".
  archivedAt   DateTime?
  createdById  String?

  org       Organization?        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?                @relation("AgendaTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  items     AgendaTemplateItem[]
  sessions  SessionAgenda[]

  // One template per wording per tenant, so re-seeding is a no-op. MySQL does
  // not enforce it across NULL orgIds; the seeder checks by title itself.
  @@unique([orgId, title])
  @@index([orgId])
  @@index([programId])
}

// One prompt of a template, in order — the EvaluationCriterion shape.
model AgendaTemplateItem {
  id           String  @id @default(cuid())
  templateId   String
  order        Int     @default(0)
  // The fallback wording of the prompt; `translations` carries the locales.
  prompt       String
  translations Json?
  // Facilitation notes for the mentor: why ask this, what to listen for. Not
  // shown to the mentee.
  guidance     String? @db.Text

  template     AgendaTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sessionItems SessionAgendaItem[]

  @@index([templateId, order])
}

// The agenda of ONE session of a pair. `meetingId` is unique: a meeting has at
// most one agenda, and an agenda may exist before the meeting is scheduled.
// `templateId` is SetNull so retiring a template never blanks a held session.
//
// No `orgId`, deliberately: this is a child of MentorshipRelation, which IS in
// TENANT_MODELS (src/lib/orgContext.ts), so it is reached only through a scoped
// parent — the same arrangement as MeetingGuest under Meeting. Worth stating,
// because a model that is not anchored gets no automatic tenant protection and
// every reader has to know that on purpose.
model SessionAgenda {
  id          String   @id @default(cuid())
  relationId  String
  meetingId   String?  @unique
  templateId  String?
  createdById String?
  createdAt   DateTime @default(now())

  relation MentorshipRelation  @relation(fields: [relationId], references: [id], onDelete: Cascade)
  meeting  Meeting?            @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  template AgendaTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items    SessionAgendaItem[]
  notes    SessionNote[]

  @@index([relationId])
  @@index([templateId])
}

// One line of a session agenda. Templated (`templateItemId` set — the text
// resolves live from the template in the reader's language, `text` is the
// snapshot fallback) or ad hoc (`templateItemId` null — `text` is the wording).
model SessionAgendaItem {
  id                String    @id @default(cuid())
  agendaId          String
  order             Int       @default(0)
  text              String    @db.Text
  templateItemId    String?
  done              Boolean   @default(false)
  doneAt            DateTime?
  // The item of a PREVIOUS session this one continues ("carried over"). A
  // plain id, not a self-relation: the previous agenda may be deleted with
  // its relation, and the link is informational.
  carriedFromItemId String?

  agenda       SessionAgenda       @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  templateItem AgendaTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)

  @@index([agendaId, order])
  @@index([templateItemId])
}

model InteractionLog {
  id         String          @id @default(cuid())
  relationId String
  date       DateTime
  // Optional short topic/subject line — the free-form `notes` field carries
  // the detail; this is what a filtered list scans/displays at a glance.
  subject    String?
  // TEXT, not the default VARCHAR(191): a meeting note is prose and overflowed
  // the 191-char default after ~three sentences, which surfaced as an opaque
  // 500 (Prisma P2000) *after* the mentor's email had already been sent.
  notes      String          @db.Text
  type       InteractionType
  // The /api/v1 keyset (#1990); @default(now()) so db push can add it to a table with rows.
  updatedAt  DateTime        @default(now()) @updatedAt
  // Written by the system rather than typed by a mentor (#1489) — a meeting
  // that took place is logged on its own, so the interaction history is the
  // history and not "whatever anybody remembered to re-type afterwards".
  // A plain boolean and not just `meetingId != null`: the link below is
  // SetNull, so deleting the meeting must not turn its log into a hand-written
  // one retroactively.
  autoLogged Boolean         @default(false)
  // Which meeting produced this log. Also the idempotency key: @unique means
  // one meeting can never write two logs, whichever path gets there first (the
  // "end meeting" click or the sweep that catches meetings nobody ended).
  // SetNull rather than Cascade — deleting the meeting row must not delete the
  // record that the meeting happened (same reasoning as PersonalNote).
  meetingId  String?         @unique
  // Idempotency key of a log written from outside (#2809): `bcc:<hash>` for a
  // mail copied to the org's CRM address — a hash of its Message-ID, so one
  // mail delivered twice is still one log per funnel record. NULL for every
  // hand-written log; MySQL lets any number of NULLs share the unique below.
  sourceRef  String?

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  meeting  Meeting?           @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@unique([relationId, sourceRef])
  // The /api/v1 keyset (#1990).
  @@index([updatedAt, id])
}

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Is this meeting still on? (#1980)
//
// Deliberately two values, not four. "Happened" is `endedAt` and "declined" is
// `rsvp` — both already exist and mean something narrower than a status would;
// folding them in here would give the same fact two homes. CANCELLED is the one
// thing the schema could not say: the meeting was called off, so it must drop
// out of the banner, the reminder, the calendar and the auto-log without the
// row (and its notes and interaction log) being destroyed.
enum MeetingStatus {
  SCHEDULED
  CANCELLED
}

// A scheduled meeting, with a video link and an emailed RSVP (responded to via
// a public token link).
//
// A meeting hangs off exactly ONE context (#1051):
//   relationId     — the original mentor ↔ mentee meeting (one row per invitee,
//                    each with its own rsvpToken; the shared room is meetLink)
//   projectId      — an ad-hoc meeting for a whole project team
//   conversationId — an ad-hoc meeting for a group chat
// MySQL can't express "exactly one of three" as a CHECK, so the rule lives in
// src/lib/meetingContext.ts and every write path goes through it.
model Meeting {
  id                  String        @id @default(cuid())
  // Nullable since #1051: project/conversation meetings have no relation.
  relationId          String?
  projectId           String?
  conversationId      String?
  title               String
  // Optional: a meeting with a set time expects an RSVP and gets reminders; a
  // meeting with no time (null) is just a shared link — no RSVP, no reminder.
  scheduledAt         DateTime?
  // How long it runs, in minutes (#1984). Null for rows written before the
  // column existed: every reader goes through meetingDurationMinutes()
  // (src/lib/meetingDuration.ts), which applies the one default — so the banner,
  // the .ics and the Google event can no longer disagree about when it ends.
  durationMinutes     Int?
  // The clock the organizer picked `scheduledAt` on (IANA zone), captured at
  // creation (#1210). `scheduledAt` is an instant and is enough to render the
  // time for anyone, but not to say *which* reading was the one agreed on — and
  // the organizer's profile zone can't stand in for it, since it changes when
  // they travel. Null for meetings created before this and for the odd caller
  // that sends no zone; both fall back to the organizer's profile zone.
  timeZone            String?
  meetLink            String?
  rsvp                RsvpStatus    @default(PENDING)
  rsvpToken           String        @unique
  createdById         String
  reminderSentAt      DateTime?
  createdAt           DateTime      @default(now())
  // The /api/v1 keyset (#1990); @default(now()) so db push can add it to a table with rows.
  updatedAt           DateTime      @default(now()) @updatedAt
  // Null for manually scheduled meetings; set for auto-generated series instances.
  seriesId            String?
  // "This meeting is over" — set when any participant marks it ended, which
  // hides the dashboard banner for everyone instead of letting the assumed
  // 60-minute window run out. Null = never marked; the window still applies.
  endedAt             DateTime?
  endedById           String?
  // When the one "how was it?" e-mail went to this row's mentee (#1896). The
  // sweep claims the row by setting it, so a meeting is asked about once.
  feedbackAskedAt     DateTime?
  // Called off, not held and not deleted (#1980). Every reader that answers
  // "is there a meeting?" — the dashboard banner, the reminder cron, the
  // calendar, the ICS feed, the auto-log sweep — filters CANCELLED out, while
  // the row itself survives so the notes and the interaction log written in it
  // keep their anchor.
  status              MeetingStatus @default(SCHEDULED)
  cancelledAt         DateTime?
  cancelledById       String?
  cancelReason        String?       @db.Text
  // "This meeting moved" — answerable without joining an audit table, which is
  // what the change mail and the .ics SEQUENCE both need.
  rescheduledAt       DateTime?
  previousScheduledAt DateTime?
  // The shared identity of ONE bulk schedule. POST /api/meetings writes one row
  // per invitee sharing a single room link, so "cancel this meeting" is
  // ambiguous without it: with a batch key the caller can say `scope: 'batch'`
  // and mean the whole session. Null on every row written before this and on
  // any single-row path — a null batch means "just this row", never "all the
  // nulls".
  batchKey            String?

  relation         MentorshipRelation?       @relation(fields: [relationId], references: [id], onDelete: Cascade)
  project          Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation     Conversation?             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  series           MeetingSeries?            @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  interaction      InteractionLog?
  notes            PersonalNote[]
  googleEvents     GoogleCalendarEventLink[]
  guests           MeetingGuest[]
  feedback         MeetingFeedback[]
  attendance       MeetingAttendance[]
  agenda           SessionAgenda?
  sessionNotes     SessionNote[]
  interviewRequest InterviewRequest?
  interviewPanel   InterviewPanel?

  @@index([relationId])
  @@index([projectId])
  @@index([conversationId])
  @@index([seriesId])
  @@index([batchKey])
  // The /api/v1 keyset (#1990).
  @@index([updatedAt, id])
}

// An invitee who has no account here — a company contact, a parent, an external
// interviewer (#1446). Everyone else on a meeting is reached through the
// meeting's context (the relation's mentor/mentee, the project's members, the
// conversation's participants); a guest is reached only by the address the
// organizer typed, so the row IS the invitation.
//
// Guests hang off ONE Meeting row, never one per invitee the way the RELATION
// context fans out: a bulk schedule writes N meeting rows sharing a single
// room, and mailing the same outsider N times would be a bug, not thoroughness.
// The write paths attach guests to the first row of the batch (`meetingId`),
// which is also the row a guest's RSVP is counted against.
//
// `rsvpToken` is the guest's whole credential — same shape and entropy as
// Meeting.rsvpToken (24 random bytes, hex) — so /rsvp/<token> and
// /api/calendar/<token> work for them with no account and no login. It is
// deliberately a SEPARATE column from Meeting.rsvpToken rather than a shared
// token table: the two are looked up by different queries and a guest must not
// be able to present a token that resolves to a participant's row.
//
// No `orgId`, deliberately: this is a child of Meeting, and Meeting itself is
// not in TENANT_MODELS (src/lib/orgContext.ts) — both are reached only through a
// scoped parent. Worth stating, because a model that is not anchored gets no
// automatic tenant protection and every reader has to know that on purpose.
model MeetingGuest {
  id          String     @id @default(cuid())
  meetingId   String
  // Stored lowercased+trimmed so @@unique actually prevents a double invite
  // ("Ada@X.com" and "ada@x.com" are one person to every mail server).
  email       String
  // Optional display name, purely so the email can open with "Hi <name>".
  name        String?
  rsvpToken   String     @unique
  rsvp        RsvpStatus @default(PENDING)
  // Who typed the address. Kept for the audit trail and so the RSVP
  // notification can reach the organizer even when they were not the creator
  // of the meeting row the guest hangs off.
  invitedById String
  createdAt   DateTime   @default(now())
  respondedAt DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // No @@index([meetingId]): @@unique([meetingId, email]) already gives MySQL a
  // leftmost-prefix index on meetingId, and a second one is dead weight.
  @@unique([meetingId, email])
}

// A recurring-meeting rule. Auto-generated Meeting rows reference this via seriesId;
// manually scheduled meetings leave seriesId null (backward-compatible).
// Who actually turned up (#2014) — THE attendance vocabulary of the schema.
// Group events (#1856) reuse this enum on their own registration row; never
// declare a second one.
enum AttendanceState {
  ATTENDED
  NO_SHOW
  // Cancelled inside the late-cancel window (setting `lateCancelHours`) —
  // derived when the meeting is cancelled, never typed by anyone.
  LATE_CANCEL
  EXCUSED
}

// One person's attendance at one meeting (#2014). Two shapes, like
// MeetingOccurrenceEnd: a Meeting row (`meetingId`), or a recurring occurrence
// that has no row (`seriesId` + `occurrenceAt`); each has its own unique, so
// nothing is recorded twice. `meetingId` is SetNull — deleting the meeting
// must not delete the record that someone did not show up (the PersonalNote /
// InteractionLog precedent), and `relationId` keeps it attached to the pair.
// Who recorded it is always stored; the mentor's record wins over the
// mentee's (src/lib/meetingAttendance.ts).
model MeetingAttendance {
  id               String              @id @default(cuid())
  orgId            String?
  org              Organization?       @relation(fields: [orgId], references: [id])
  meetingId        String?
  meeting          Meeting?            @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  seriesId         String?
  series           MeetingSeries?      @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  occurrenceAt     DateTime?
  relationId       String?
  relation         MentorshipRelation? @relation(fields: [relationId], references: [id], onDelete: Cascade)
  // When the meeting was due to start — kept here so the cadence figures still
  // count a meeting whose row was deleted.
  meetingAt        DateTime
  userId           String
  user             User                @relation("AttendanceSubject", fields: [userId], references: [id], onDelete: Cascade)
  state            AttendanceState
  recordedById     String
  recordedBy       User                @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Cascade)
  recordedAt       DateTime            @default(now())
  note             String?             @db.VarChar(500)
  // The one neutral "we missed you" note to a no-show (#2014) — stamped so it
  // is sent exactly once, however often the record is edited.
  noShowNotifiedAt DateTime?

  @@unique([meetingId, userId])
  @@unique([seriesId, occurrenceAt, userId])
  @@index([orgId])
  @@index([relationId, meetingAt])
}

model MeetingSeries {
  id              String    @id @default(cuid())
  projectId       String?
  title           String
  // Days of week as a JSON array of integers (0=Sun … 6=Sat), e.g. [1,4] = Mon+Thu.
  daysOfWeek      Json
  // Wall-clock start time in "HH:mm" format (24-hour), e.g. "09:30".
  timeOfDay       String
  // Which clock `timeOfDay` is on (IANA zone, e.g. "Europe/Istanbul"). Null for
  // rules saved before #1110, which are read on the deployment default zone —
  // the clock the UI always showed them on. Without this the wall clock was
  // anchored to UTC, so a 09:00 rule was reminded as "12:00 (GMT+3)".
  timeZone        String?
  // Length of every occurrence, in minutes (#1984). Null reads as the default
  // through meetingDurationMinutes(), exactly like Meeting.durationMinutes.
  durationMinutes Int?
  fixedLink       String?
  active          Boolean   @default(true)
  createdById     String
  createdAt       DateTime  @default(now())
  // A standing 1:1 (#2013): the series hangs off a mentorship relation instead
  // of a project. Exactly one of projectId / relationId is set — MySQL cannot
  // CHECK that, so every write path enforces it (countContexts in
  // src/lib/meetingContext.ts). SetNull like the project side: a series whose
  // relation is gone is an orphan its author (or an admin) can still cancel.
  relationId      String?
  // Cadence (#2013). intervalWeeks counts WHOLE weeks from anchorDate's week, so
  // a biweekly rule cannot drift across a DST change; anchorDate is a calendar
  // date (UTC midnight), null reads as the creation date. untilDate (inclusive,
  // a calendar date) and maxOccurrences are the end condition — both null means
  // "until cancelled", the pre-#2013 behaviour. The rule: src/lib/seriesRule.ts.
  intervalWeeks   Int       @default(1)
  anchorDate      DateTime?
  untilDate       DateTime?
  maxOccurrences  Int?

  project       Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  relation      MentorshipRelation?       @relation(fields: [relationId], references: [id], onDelete: SetNull)
  meetings      Meeting[]
  reminders     MeetingSeriesReminder[]
  ends          MeetingOccurrenceEnd[]
  attendance    MeetingAttendance[]
  // The one recurring Google event per connected member (#2654).
  calendarLinks GoogleCalendarEventLink[]

  @@index([projectId])
  @@index([relationId])
}

// One row per (series, occurrence, lead time) that has been reminded (#51).
// The recurring project meeting is announced to *every* project member, not
// only the mentees who happen to have a MentorshipRelation, so its reminders
// cannot ride on `Meeting.reminderSentAt`. The unique key is the idempotency
// guard: the cron claims the row first and only mails when the insert wins.
enum MeetingReminderLead {
  DAY_BEFORE
  HOUR_BEFORE
}

model MeetingSeriesReminder {
  id           String              @id @default(cuid())
  seriesId     String
  occurrenceAt DateTime
  lead         MeetingReminderLead
  sentAt       DateTime            @default(now())

  series MeetingSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, occurrenceAt, lead])
}

// "This occurrence is over" for a series occurrence that has no Meeting row —
// the dashboard banner synthesizes those on the fly (src/lib/upcomingMeeting.ts),
// so the end mark needs its own home, keyed the same way as the reminders above.
// Occurrences that DO have a generated Meeting row get both marks (the row's
// endedAt and one of these), so every viewer's representation is covered.
model MeetingOccurrenceEnd {
  id           String   @id @default(cuid())
  seriesId     String
  occurrenceAt DateTime
  endedById    String
  endedAt      DateTime @default(now())

  series MeetingSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, occurrenceAt])
}

// Live state of one JaaS video room, fed by the tenant's webhooks
// (/api/webhooks/jaas, enabled by JAAS_WEBHOOK_SECRET). Purely informational:
// the dashboard banner shows "n in the call" while the room is active. Keyed by
// the bare room name (unguessable, unique per meeting; a series' fixedLink
// reuses one room, so readers must also check freshness via updatedAt).
model MeetingRoomState {
  id           String   @id @default(cuid())
  room         String   @unique
  active       Boolean  @default(false)
  // JSON array of { id, name } for everyone currently in the room.
  participants Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Our own count of JaaS monthly active participants (#2011).
//
// JaaS bills — and caps a free tenant — on distinct participants per calendar
// month, and the provider's dashboard is the only place that number used to
// exist. That made "is the 25-participant allowance actually the constraint?"
// unanswerable from anything we own, so the routing was a guess dressed up as a
// rule. One row per (period, participant) written from the JaaS webhook feed
// makes it a number: `COUNT(*) WHERE period = ?` is the MAU.
//
// IDENTITY-MINIMAL BY CONSTRUCTION. The webhook carries `{ id, name }`; only a
// keyed hash of the id is stored here and the name is dropped on the floor. The
// hash is not reversible to a person by anyone reading this table, and it is
// salted per deployment (lib/jaasAllowance.ts), so the same participant in two
// deployments does not correlate. Nothing joins this table to a User.
model JaasMonthlyParticipant {
  id String @id @default(cuid())

  /// The calendar month, UTC, 'YYYY-MM' — the same period vocabulary the
  /// billing meter uses (lib/meteringRules.ts), so the two can be read side by
  /// side without converting anything.
  period String @db.VarChar(7)

  /// HMAC-SHA256 of the JaaS participant id, hex. Never the id, never the name.
  participantHash String @db.VarChar(64)

  /// When this participant was first seen in this month. There is deliberately
  /// no "last seen": the metered unit is "was active at all", and a rolling
  /// timestamp would turn a counter into an attendance log.
  firstSeenAt DateTime @default(now())

  /// The insert is an upsert on this pair, which is what makes the row count a
  /// DISTINCT count without a GROUP BY.
  @@unique([period, participantHash])
  @@index([period])
}

// Audit trail of pipeline stage changes for a mentorship.
model StatusChange {
  id          String   @id @default(cuid())
  relationId  String
  fromStatus  String
  toStatus    String
  // NULL = the system moved it (#2527): an unattended sweep such as
  // expireTrials() has no User to name, and naming a real person (the owner, an
  // org admin) would print a name next to something they did not do. Same
  // precedent as ActivityLog.actorId. Readers render NULL as "System".
  changedById String?
  createdAt   DateTime @default(now())
  // Drop-off reason (#810): required by the API when `toStatus` resolves to a
  // negative/off-path stage in the org's pipeline (PipelineStage.isOffPath —
  // see src/lib/dropoffReasons.ts for the whitelist and src/lib/stageChange.ts
  // for the validation). Null for every pre-existing row and for moves into a
  // non-negative stage — never backfilled.
  reasonCode  String?
  // Free-text elaboration; required only when reasonCode is OTHER.
  reasonNote  String?  @db.Text

  relation  MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  // Restrict, as it was while the column was required: erasure deletes a
  // person's moves explicitly (accountErasure.ts), and an implicit SET NULL
  // would silently relabel them as the system's.
  changedBy User?              @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
}

model InvitationToken {
  id           String    @id @default(cuid())
  token        String    @unique
  // Nullable since #670: an invitation may be a shareable link with no address
  // attached ("invite someone who has no email yet, or whose address you don't
  // know"). When such a link is used, registration writes the address the
  // invitee actually signed up with back here, so the row always ends up naming
  // whoever consumed it.
  email        String?
  // The inviter's own note about a link — "Ayşe from the bootcamp", "career fair
  // handout" (#670). Never shown to the invitee; it is how the sender recognises
  // an email-less link in their own list.
  label        String?
  role         Role
  used         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  // Which language the invitation mail was written in (#1720). An invitee has
  // no account and therefore no `preferredLanguage`, so the choice is the
  // inviter's — made in the invite form, defaulting to the inviter's own UI
  // language. Stored on the row rather than recomputed, because a RESEND (and a
  // bulk resend) happens later, possibly by a different admin: the second mail
  // must arrive in the same language as the first. Null = pre-#1720 rows and
  // seeder/system invites; those fall back to the deployment default locale.
  locale       String?
  // The inviter's tenant, captured at invite time (#1272) so registration can
  // assign the org immediately instead of leaving the account org-less until
  // the next deploy's backfill (fail-closed org scoping 403s COMPANY reads in
  // that window). Nullable: pre-existing rows predate the column.
  orgId        String?
  // Who sent the invitation (#51). Nullable: pre-existing rows have no inviter,
  // and the seeder/system can invite without a user. Drives two things on
  // registration — the new account's `referredById`, and the automatic
  // mentorship link below.
  invitedById  String?
  // When set, registering through this invitation immediately creates the
  // mentorship: `mentorId` mentors the new MENTEE (or, for a MENTOR invite, the
  // invited mentor is paired with `menteeId`). A mentor inviting a mentee sets
  // this to itself; an admin picks the mentor in the invite form.
  mentorId     String?
  menteeId     String?
  // The company an invited COMPANY user belongs to (#1863). A COMPANY account
  // is useless without it — every company-side screen reads `User.companyId` —
  // and registration has no other way to learn it, since the invitee only
  // supplies a name and a password. Carried here for the same reason `orgId` is:
  // the fact is known when the invitation is minted and must survive until it is
  // consumed, possibly days later. Only ever set on a `role = COMPANY` row.
  companyId    String?
  // The project the invitee should join on registration, if any.
  projectId    String?
  // Lifecycle timestamps (nullable — each set once, the first time it happens):
  // openedAt  → the register link was clicked/opened
  // registeredAt → the account was created from this invitation
  // verifiedAt → the invitee's email was verified (immediate for invited users)
  openedAt     DateTime?
  registeredAt DateTime?
  verifiedAt   DateTime?
  // Revoked (#2071): an invitation the admin has withdrawn. A real state rather
  // than a delete, so the board can still answer "what happened to that person"
  // — and so the consumption paths (register, /api/invite/opened, resend) can
  // refuse it. Registration checks this alongside `used`/`expiresAt`: hiding a
  // revoked row from the list without refusing the token would leave the link
  // live for whoever already has it.
  revokedAt    DateTime?

  // Only the inviter gets a relation; mentorId/menteeId/projectId stay plain
  // columns (validated when the invitation is created) so the User model does
  // not grow three more back-relations for a write-once pointer.
  invitedBy User? @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([invitedById])
}

// Single-use, time-limited token for self-service password reset and for the
// "set your password" link sent to freshly-created mentees.
enum PasswordResetPurpose {
  RESET
  SET_INITIAL
}

model PasswordResetToken {
  id        String               @id @default(cuid())
  token     String               @unique
  userId    String
  purpose   PasswordResetPurpose @default(RESET)
  used      Boolean              @default(false)
  createdAt DateTime             @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, very short-lived grant that authorizes an impersonation sign-in.
// Created by an admin-guarded API route, then consumed by the auth provider —
// so the provider never has to re-check the caller's session itself.
model ImpersonationGrant {
  id        String   @id @default(cuid())
  token     String   @unique
  adminId   String // the real admin
  targetId  String // who to become (the target on START, the admin on STOP)
  kind      String // START | STOP
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// One rule of a tenant's IdP role mapping (#1940): "a user whose `claim`
// contains `matchValue` gets `role`". Resolved by src/lib/ssoRoleMapping.ts —
// highest priority wins, a tie goes to the LESS privileged role, and no match
// is MENTEE. `ADMIN` is refused at the write boundary until the platform gate
// (#1575) lands. `matchValue` is compared case-insensitively.
model SsoClaimMapping {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  claim      String       @db.VarChar(191)
  matchValue String       @db.VarChar(191)
  role       String       @db.VarChar(20)
  priority   Int          @default(0)
  createdAt  DateTime     @default(now())

  @@unique([orgId, claim, matchValue])
  @@index([orgId])
}

// Single-use bridge token minted by the SSO ACS route AFTER a signed SAML
// assertion is verified, then consumed by the `sso` NextAuth provider to issue a
// session (#545). Mirrors ImpersonationGrant: short-lived + single-use, so a
// verified IdP login can't be replayed.
model SsoLoginGrant {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Magic-link sign-in (#1959): "e-mail me a sign-in link". One row per link
// requested, holding ONLY the SHA-256 of the token the mail carries — the raw
// value exists in that one e-mail and nowhere else, so a read of this table
// (a backup, a log, a support session) hands nobody a sign-in. Single use:
// `usedAt` is stamped by the same conditional UPDATE that admits the sign-in
// (src/lib/magicLink.ts), so two clicks on one link cannot both win. Expired
// and spent rows are dropped by the nightly trusted-device purge.
//
// User-keyed, not tenant-keyed, like SsoLoginGrant and PasswordResetToken: the
// row is a credential for ONE account, and that account's row already carries
// the tenant. An orgId here would be a second copy of the same fact.
model LoginLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use bridge token minted by /api/auth/remember/refresh once a trusted
// device's remember-me cookie has been verified AND rotated, then consumed by
// the `remember` NextAuth provider to mint a fresh session. Same shape as
// SsoLoginGrant on purpose: the session is always minted by a NextAuth
// provider, never hand-encoded, so every token carries the same claims.
model SessionRefreshGrant {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  deviceId  String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// "Remember me" — one row per device the user chose to trust (#1495).
//
// The session JWT stays short-lived (12h); this is the long-lived credential
// that silently mints a new one, so an idle laptop does not have to be logged
// into every morning. Shaped along the usual persistent-login rules:
//
//   * only the SHA-256 of the secret is stored, so a database dump is not a
//     pile of usable login cookies;
//   * the secret ROTATES on every use — `tokenHash` becomes the new one and the
//     old hash moves to `prevTokenHash`, valid for a few seconds only so two
//     parallel tabs racing the same refresh do not knock each other out;
//   * presenting a hash older than that grace window means the cookie was
//     copied off the machine (the legitimate device would have rotated it), so
//     the device is revoked on the spot rather than trusted;
//   * `expiresAt` slides forward on use but `absoluteExpiresAt` never does — a
//     remembered device eventually has to type its password again.
model TrustedDevice {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the current secret. Never the secret itself.
  tokenHash         String    @unique
  // The previous secret's hash, accepted until prevValidUntil (see above).
  prevTokenHash     String?   @unique
  prevValidUntil    DateTime?
  // Human-readable "Chrome on macOS", derived from the user-agent at enrolment
  // so the account page can list devices someone actually recognises.
  label             String?
  userAgent         String?   @db.Text
  lastIp            String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  // Idle expiry — slides forward on every refresh.
  expiresAt         DateTime
  // Hard cap — never extended.
  absoluteExpiresAt DateTime
  // Set when the user signs out, revokes the device, changes their password or
  // signs out of all devices. Kept (rather than deleted) so a later attempt
  // with the stolen cookie can be recognised and logged instead of looking like
  // an unknown token.
  revokedAt         DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// A browser a person has signed in from (#1717).
//
// The memory behind the "new sign-in from a device we haven't seen" security
// notice. One row per (user, browser fingerprint); the fingerprint is the
// SHA-256 of the user-agent string, so two tabs of the same browser are one
// device and an upgraded browser is a new one — a deliberately coarse notion
// that errs towards the occasional extra notice rather than silence. No
// geolocation, no cookie: the row says "this browser has signed in here before"
// and nothing else, which is why the first sign-in of an account is the
// baseline (nothing to compare against) and sends no mail. The address is the
// one the sign-in came from; the mail quotes it so the reader can recognise
// their own network. User-keyed and without `orgId`, exactly like TrustedDevice:
// the row is read only through the user it belongs to.
model SignInDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha256(userAgent), hex. Never the raw agent as the key: it is 512 bytes wide.
  fingerprint String
  // "Chrome on macOS" — the label the notice quotes.
  label       String?
  userAgent   String?  @db.Text
  lastIp      String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([lastSeenAt])
}

// Single-use 2FA recovery codes (#1542).
//
// The way back in when the authenticator is gone. Without this, an organisation
// that turns `require2fa` on has no answer for a lost phone except an admin
// editing MySQL by hand — which is why the setting was frightening to switch on.
//
// Only the HASH is stored, exactly like a password or an API key: the plaintext
// set is shown once at enrolment and is not recoverable from here afterwards.
// `usedAt` is what makes a code single-use, and it is stamped by a CONDITIONAL
// update (`where: { id, usedAt: null }`) so two tabs racing on the same code
// cannot both spend it — one of them writes 0 rows and is refused.
//
// Tenant data (it is a credential for one tenant's user), so it carries `orgId`
// and is registered in TENANT_MODELS. Like AccountLockout, rows are written from
// paths that run outside any tenant scope — the sign-in consume has no session
// yet — so the writers stamp `orgId` from the owning User row themselves rather
// than relying on the middleware.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String?
  // HMAC-SHA-256 of the normalised code, keyed by the server secret — never the
  // code. See src/lib/recoveryCodes.ts for why an HMAC and not a bare digest.
  codeHash  String
  // Null while the code is still spendable; the instant it was consumed after.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Durable brute-force lockout (#1541).
//
// The sign-in failure counter used to live only in the in-process Map behind
// `rateLimit()`: it evaporated on every redeploy, no admin could see that an
// account was locked, and nobody could clear a lockout for a user who had
// locked themselves out. This row is the durable, visible, clearable copy of
// that state — and `authorize()` consults it BEFORE the bcrypt compare, so a
// locked-out attempt costs one indexed point lookup instead of a cost-12 hash.
//
// Deliberately NOT a relation to User: the row is keyed by the email that was
// *typed*, which under an attack usually belongs to no account at all.
model AccountLockout {
  id          String    @id @default(cuid())
  // Normalized (trimmed + lowercased) email the attempts were made against.
  email       String
  // The account, when the typed email matches one. Null otherwise.
  userId      String?
  // Which stage this counter belongs to: "password" or "totp". One row PER
  // STAGE per address, mirroring the two separate in-memory buckets in
  // auth.ts. A single shared row would let five fumbled authenticator codes
  // lock the password stage, and the sign-in form could then no longer even
  // reveal the code field (it needs a 2FA_REQUIRED, which only comes from a
  // password check that was allowed to run).
  reason      String    @default("password")
  failedCount Int       @default(0)
  // Start of the current counting window. Failures older than the window open
  // a fresh count instead of accumulating forever.
  windowStart DateTime  @default(now())
  // Locked until this moment. Null or in the past means "counting, not locked".
  lockedUntil DateTime?
  lastIp      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Tenant anchor (#543). This is tenant data — it is listed in TENANT_MODELS.
  orgId       String?

  @@unique([email, reason])
  @@index([userId])
  @@index([lockedUntil])
  @@index([orgId])
}

enum LogLevel {
  DEBUG
  INFO
  WARNING
  ERROR
}

// Application activity log: auth events and key user actions, at several
// levels. Powers the admin activity viewer.
model ActivityLog {
  id         String   @id @default(cuid())
  level      LogLevel @default(INFO)
  action     String
  actorId    String?
  actorEmail String?
  targetType String?
  targetId   String?
  detail     String?
  // Where the action came from (#881). Both optional: existing rows predate the
  // columns, and plenty of call sites (cron jobs, NextAuth event callbacks) have
  // no Request to read them from. An incident review can't answer "was this
  // really the user?" from actor + action alone.
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  // The tenant the entry belongs to (cross-world isolation). Nullable on
  // purpose — the table is full of rows that predate it (#2298: a required
  // column cannot be added to a populated table). Stamped by logActivity() from
  // the explicit org, else the actor's, else the target user's org;
  // prisma/backfill-activity-log-org.mjs fills the legacy rows the same way
  // BEFORE backfill-organization.mjs assigns whatever is left (system rows with
  // no actor) to the default org. NULL reads as the default org (tenantFilter).
  orgId      String?

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([orgId])
  // /admin/activity (#1608): one tenant's rows, newest first, a page at a time
  // — `where: { orgId }` + `orderBy: { createdAt: 'desc' }` + skip/take.
  @@index([orgId, createdAt])
}

enum EmailStatus {
  // Handed to the SMTP server without error. NOT proof of inbox placement —
  // the message can still bounce or be filed as spam downstream.
  SENT
  // The SMTP server rejected it, or the connection failed.
  FAILED
  // Never attempted: SMTP is not configured on this environment.
  SKIPPED
  // A temporary refusal (a relay throttle, a timeout, a 4xx about the message):
  // the mail was put back to be retried, not lost. Not a failure — the health
  // view's failuresSinceOk counts FAILED only. Additive (#2941); nothing
  // writes it until the outbox lands.
  DEFERRED
  // NewsletterSend only (#2951): the issue is on the mail queue and the drain
  // has not settled it yet. The queued mail's settle hook moves it to SENT,
  // FAILED or SKIPPED (src/lib/mailRefHooks.ts). EmailLog never carries it — a
  // queued mail's ledger row is written when the drain sends it. Additive.
  QUEUED
  // EmailLog only (#2960): the organization holds automated mail to its leads
  // and customers for approval (`outboundApproval`), so this mail became an
  // OutboundDraft instead of leaving. Not a failure and not a delivery: the
  // draft's own status says what happened next. Additive.
  HELD
}

// ── Bounce / complaint suppression (#1692) ──────────────────────────────────
// What a mailbox told us through the provider's webhook. SENT above is "the
// relay took it", never "it arrived"; these two tables are the loop that closes
// that gap: an address that hard-bounced or complained is SUPPRESSED, and
// sendEmail() (and the queue's drain) refuses it until a human delists it.
//
// DELIBERATELY NOT TENANT-SCOPED — the one place the multi-tenancy rule
// (docs/tenant-isolation.md) is knowingly not applied. Sender reputation is a
// property of the sending domain, and every tenant shares it: a complaint rate
// built up by one tenant's mail is charged to all of them. So there is no
// orgId here and no TENANT_MODELS entry; the admin screen applies its own
// scope (src/lib/emailSuppression.ts § suppressionScopeWhere).
// Rules: src/lib/emailSuppressionRule.ts. Doc: docs/EMAIL_DELIVERABILITY.md.
enum SuppressionReason {
  HARD_BOUNCE
  SOFT_BOUNCE_REPEATED
  COMPLAINT
  MANUAL
  UNSUBSCRIBE_ALL
}

model EmailSuppression {
  id            String            @id @default(cuid())
  // Trimmed and lower-cased on write AND on match (normalizeSuppressedAddress):
  // a suppression that misses on case is not a suppression.
  email         String            @unique @db.VarChar(320)
  reason        SuppressionReason
  // The provider's own words (an SMTP diagnostic, a feedback-loop type) —
  // shown to the admin, never to the recipient.
  detail        String?           @db.Text
  // The provider key the event came in through ('brevo', 'generic'), or
  // 'admin' for a manual entry.
  source        String?           @db.VarChar(32)
  suppressedAt  DateTime          @default(now())
  // A delist keeps the row (and its history) and stamps these; a new bounce
  // after a delist re-suppresses the same row.
  releasedAt    DateTime?
  releasedById  String?
  releaseReason String?           @db.Text

  @@index([reason])
  @@index([releasedAt, suppressedAt])
}

// One provider event, as received. Exists for two reasons only: idempotency
// (providers retry; the unique key makes a replay a no-op) and the soft-bounce
// window (N soft bounces inside it suppress). Pruned by the retention registry
// (key 'emailDeliveryEvent').
model EmailDeliveryEvent {
  id         String   @id @default(cuid())
  provider   String   @db.VarChar(32)
  // The provider's event id, or a sha256 of the fields that identify the
  // event when the provider sends none (emailBounce.ts § normaliser).
  eventId    String   @db.VarChar(191)
  email      String   @db.VarChar(320)
  // 'bounce' | 'complaint'
  type       String   @db.VarChar(16)
  hard       Boolean  @default(false)
  detail     String?  @db.Text
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([email, type, receivedAt])
  @@index([receivedAt])
}

// Delivery log for outgoing mail (#1194).
//
// Without this there is no record anywhere that a mail was (or wasn't) sent:
// `sendEmail` used to return silently when SMTP was unconfigured and most
// callers swallow send failures, so an outage looked exactly like "the user
// ignored us". Deliberately metadata only — recipient, subject, category and
// outcome. The body is never stored: it is the most sensitive part of the
// payload and duplicating it here would put message content in a second place
// that account erasure would have to chase.
model EmailLog {
  id        String      @id @default(cuid())
  to        String      @db.VarChar(320)
  subject   String      @db.VarChar(512)
  // Coarse bucket ("verification", "message", "invitation", …) so the admin
  // view can answer "are verification mails going out at all?".
  category  String?     @db.VarChar(64)
  // Which of the two outbound channels carried it: "primary" (the reputable
  // relay, for mail that must reach a human) or "bulk" (our own server, for
  // digests and reminders). Lets the admin see how much of the relay's daily
  // quota each category is actually consuming (#1203).
  transport String?     @db.VarChar(16)
  status    EmailStatus @default(SENT)
  // Rejection reason / exception message when status is FAILED or SKIPPED.
  error     String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([to])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  // The FAILED/SENT-by-recency shape (#1608): /api/health's
  // `findFirst({ where: { status: 'FAILED' }, orderBy: { createdAt: 'desc' } })`
  // and the email-log screen's `groupBy` over `{ status, createdAt: { gte } }`.
  // Without it MySQL filesorts the status set or walks createdAt past every
  // row of the other statuses — the documented ep:health landmine.
  @@index([status, createdAt])
}

// Lightweight audit trail for sensitive admin actions (e.g. impersonation).
// "This admin's authority extends to this programme / company" (#1567). One
// row per delegated scope of a PROGRAM_ADMIN; the authorization
// layer (src/lib/authz.ts) reads them per request. FAIL CLOSED: a
// PROGRAM_ADMIN with no rows has no scope at all — never "everything" — the
// same rule as NO_MATCH in src/lib/authzScope.ts. A row names a cohort, a
// company, or both (narrowing to that company's mentees in that cohort).
//
// Tenant data: `orgId` + an entry in TENANT_MODELS (src/lib/orgContext.ts).
// The unique key cannot stop two all-NULL-scope rows (MySQL treats NULLs as
// distinct), which is harmless: such a row grants nothing, and the writer
// refuses it.
model AdminScopeGrant {
  id          String   @id @default(cuid())
  userId      String
  orgId       String
  cohortId    String?
  companyId   String?
  // The admin who granted it. A plain id, no relation, like AuditLog.actorId:
  // erasing the granter must not erase the grant's history.
  createdById String?
  createdAt   DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cohort  Cohort?      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  company Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId, cohortId, companyId])
  @@index([userId])
  @@index([orgId])
  @@index([cohortId])
  @@index([companyId])
}

model AuditLog {
  id        String   @id @default(cuid())
  // The tenant the audited action happened in (#2012). Nullable + backfilled:
  // prisma/backfill-audit-log-org.mjs attributes legacy rows by the actor's
  // org, then the target user's; what is left (system rows) falls to the
  // default org in backfill-organization.mjs. NULL reads as the default org
  // (tenantFilter). Registered in TENANT_MODELS, so a request-scoped writer
  // has it stamped by the middleware; the sessionless writers (the offer
  // expiry sweep, the impersonation STOP) pass it themselves.
  orgId     String?
  actorId   String // who performed the action (e.g. the admin)
  action    String // e.g. IMPERSONATE_START / IMPERSONATE_STOP
  targetId  String? // affected user, when applicable
  // @db.Text: a USER_MERGE detail carries per-relation move counts as JSON,
  // which overflows the default VARCHAR(191) and turned a committed merge
  // into a 500 with no audit row (P2000).
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([actorId])
  // "Who accessed my account" (#1587) reads this table by the *affected* user,
  // not the actor — without this index that self-service list is a full scan.
  @@index([targetId])
  // A time-ordered drain (#2012) and the age-based sweep (#1585) both walk
  // this table by time; the per-tenant drain walks it by (org, time).
  @@index([createdAt])
  @@index([orgId, createdAt])
}

// Where a tenant's audit trail is streamed to (#2012): one row per receiver
// (a Splunk HEC, a Sentinel data collector, an Elastic ingest endpoint). The
// drain job (src/lib/auditDrain.ts) reads AuditLog forward from the cursor,
// POSTs signed newline-delimited batches and moves the cursor only on a 2xx —
// at-least-once, receivers dedupe on the audit row id (docs/audit-stream.md).
//
// Strictly tenant property: a drain receives its own org's rows and nothing
// else, which is why it carries a REQUIRED orgId and is in TENANT_MODELS.
// Nothing here can edit or delete an audit row; the only thing a drain writes
// is its own bookkeeping.
model AuditDrain {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // @db.Text: a SIEM collector URL carries a token in its path or query and
  // runs past 191 characters. The route caps it (AUDIT_DRAIN_URL_MAX).
  url           String       @db.Text
  // The HMAC-SHA256 key the receiver verifies each batch with. Shown once at
  // creation and on rotation, like Webhook.secret.
  secret        String
  // 'json_lines' (our record, one per line) or 'ecs' (Elastic Common Schema).
  format        String       @default("json_lines")
  active        Boolean      @default(true)
  // Where the next batch starts: the (createdAt, id) of the last row shipped.
  // Null = nothing shipped yet, start at the beginning of the trail.
  cursorAt      DateTime?
  cursorId      String?
  lastOkAt      DateTime?
  // Through sanitizeError, never a raw response body.
  lastError     String?      @db.Text
  // Consecutive failed deliveries; cleared by a success. Drives the backoff
  // (nextAttemptAt) and, past AUDIT_DRAIN_PAUSE_AFTER_FAILURES, the pause.
  failures      Int          @default(0)
  nextAttemptAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orgId])
  @@index([active, nextAttemptAt])
}

// Single-use, time-limited token to confirm a user's email address.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum WeeklyReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

// One mentee-owned internship report per relation and canonical UTC week.
model WeeklyReport {
  id            String             @id @default(cuid())
  orgId         String
  relationId    String
  weekStart     DateTime           @db.Date
  summary       String             @db.Text
  hoursSpent    Int?
  blockers      String?            @db.Text
  status        WeeklyReportStatus @default(DRAFT)
  // FIRST time the report left DRAFT (#1917). "Late" is measured against the
  // week the report covers, so it needs the moment of submission — updatedAt
  // moves on every edit and review. Kept on a resubmission after
  // CHANGES_REQUESTED: the deadline was about the first hand-in. NULL on rows
  // from before the column existed; src/lib/weeklyReportCompliance.ts reads
  // that as "unknown", never as late.
  submittedAt   DateTime?
  mentorComment String?            @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  relation   MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  reviewedBy User?              @relation("WeeklyReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([relationId, weekStart])
  @@index([orgId, weekStart])
  @@index([relationId, status, weekStart])
  @@index([reviewedById])
}

// Delivery-only weekly idempotency marker; contains no report/message content.
model WeeklyReportReminder {
  id          String   @id @default(cuid())
  relationId  String
  // The PERSON the reminder was sent to (#2287). The claim is still keyed by
  // the relation — that unique is what makes the claim atomic — but the cap
  // the product owes a human is "one reminder per person per week", and that
  // question cannot be asked of a relation-keyed row at all.
  //
  // Nullable on purpose, and it stays nullable in this change: the table has
  // rows, and `db push` REFUSES a new required column with no database-side
  // default on a populated table (#2298) — additive is not the same as
  // appliable. `prisma/backfill-weekly-report-reminder-recipient.mjs` fills the
  // existing rows. The `@@unique([recipientId, weekStart])` that would make
  // the cap structural is the deliberate CONTRACT step and is NOT here: deploys
  // run `db push` BEFORE the backfills, so the index would be created against
  // rows that are still NULL — and, worse, against exactly the duplicate rows
  // this issue is about. Same sequencing as the one-active-mentor backstop
  // (#2286): expand, backfill, verify clean on prod and shared preview, then
  // contract.
  recipientId String?
  weekStart   DateTime @db.Date
  createdAt   DateTime @default(now())

  relation  MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  recipient User?              @relation("WeeklyReportReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([relationId, weekStart])
  @@index([weekStart])
  @@index([recipientId, weekStart])
}

// One row per reminder already claimed for a trial (#2414, story #2392).
//
// WHAT IT IS FOR
//   The trial sweep runs daily and must not write to the same account twice for
//   the same threshold. `@@unique([relationId, threshold])` is what makes that
//   structural rather than a matter of getting a query right: the claim is a
//   `createMany({ skipDuplicates: true })`, so two overlapping ticks — or two
//   replicas — cannot both win the same (relation, threshold) pair.
//
// CLAIM FIRST, THEN SEND — the house convention, kept deliberately.
//   The source backlog for this epic asked for the row to be written AFTER a
//   successful send. This repo does the opposite and says why:
//   `sendMeetingReminders` (src/services/emailService.ts) — "Marking first
//   means a mid-send failure loses a reminder rather than duplicating one — the
//   far less annoying failure mode" — and `sendWeeklyReportReminders` claims
//   the same way. This table follows the house convention, for a reason that is
//   specific to trials rather than merely conventional: the thresholds are a
//   LADDER. A 7-day reminder lost to an SMTP hiccup is still followed by the
//   3-day and the 0-day one, so the account is not lost in silence — which is
//   the whole point of story #2392 — whereas send-then-claim risks mailing the
//   same owner about the same account twice on a retry, and the owner who is
//   mailed twice is the owner who filters the sender out. Trust the ladder,
//   not the retry.
//
// NOT PART OF THE CLAIM KEY: the recipient. The question this table answers is
// "has this threshold been handled for this account?", and that must stay true
// however the record is reassigned mid-trial — a re-assignment is not a reason
// to mail the new owner about the same day again.
model TrialReminder {
  // Nullable orgId, like every phase-1 tenant model: the row is written by a
  // sessionless cron, which stamps the relation's own orgId explicitly.
  orgId      String?
  org        Organization? @relation(fields: [orgId], references: [id])
  id         String        @id @default(cuid())
  relationId String
  // Days remaining when the reminder was claimed: 7, 3 or 0
  // (TRIAL_REMINDER_THRESHOLDS in src/lib/trialReminderRule.ts). An Int rather
  // than an enum so the ladder can be re-tuned without a schema change.
  threshold  Int
  sentAt     DateTime      @default(now())

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@unique([relationId, threshold])
  @@index([sentAt])
}

// An automated mail an organization holds for approval (#2960,
// docs/outbound-approval.md). With the per-org setting `outboundApproval` on,
// `sendEmail()` asks the one rule (src/lib/outboundApprovalRule.ts) whether a
// prepared mail may leave; a held one is stored here instead, and an operator
// previews it and sends it now, schedules it or discards it from the outbox.
//
// THE MAIL IS SEALED. `box` is the whole prepared mail (recipient, subject,
// body, headers) sealed with `secretBox` ('outbound-draft') — it can carry links
// and the lead's own words, so a database dump must not read it; `summary` is a
// small sealed copy of what the list shows (subject, display name, masked
// address). The address itself is never in the clear: `rcpt` is its sha256, the
// same hash the mail queue and account erasure use. `box` and `summary` are set
// to null in the statement that writes any terminal state.
//
// ONE WRITER: src/lib/outboundDrafts.ts (the hold, the three actions, the
// expiry sweep, the prune, erasure). Every status move is one guarded
// `updateMany` whose WHERE carries the expected status.
model OutboundDraft {
  // Registered in TENANT_MODELS; the writer always passes it (the hold runs
  // inside crons and sessionless routes too).
  orgId              String
  org                Organization        @relation(fields: [orgId], references: [id])
  id                 String              @id @default(cuid())
  status             OutboundDraftStatus @default(DRAFT)
  category           String?             @db.VarChar(64)
  // CRITICAL | TRANSACTIONAL | BULK — the lane the mail would have taken.
  lane               String              @db.VarChar(16)
  // The e-mail group (src/lib/emailGroups.ts) of `category`, when it has one.
  mailGroup          String?             @db.VarChar(32)
  // Why it was held: a code of the rule (`held_lead`, `held_customer`, …).
  reason             String              @db.VarChar(32)
  // What produced it, as a code the outbox renders ("trial ends soon",
  // "win-back", …): `triggerFor(category)` in the rule.
  trigger            String              @db.VarChar(32)
  // sha256 of the lower-cased recipient address (recipientHash()).
  rcpt               String              @db.VarChar(64)
  // The recipient's account / company, when known. No FK on purpose: a draft
  // must not block deleting either, and erasure removes the draft itself.
  recipientUserId    String?
  recipientCompanyId String?
  // The sealed mail. LongText: a message copy may carry up to 10 MB of
  // attachments, which base64 + sealing grows past MediumText's 16 MB.
  box                String?             @db.LongText
  summary            String?             @db.Text
  // The draft's identity per org: the sender's own dedupe key when it named
  // one, else a hash of category + recipient + subject + day — so a cron that
  // runs again tomorrow does not stack a second copy of the same mail.
  dedupeKey          String              @db.VarChar(191)
  // The sender's own reference (a NewsletterSend id, …), handed to the queue
  // on approval so its settle hook still names the right record.
  ref                String?             @db.VarChar(191)
  // After this the draft is EXPIRED by the hourly sweep: the sender's own
  // deadline when it gave one, else 14 days after it was held.
  notAfter           DateTime
  scheduledFor       DateTime?
  // The email.send job approval created (its idempotency key is `draft:<id>`).
  jobId              String?
  decidedById        String?
  decidedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([orgId, dedupeKey])
  @@index([orgId, status, createdAt])
  @@index([status, notAfter])
  @@index([rcpt])
  @@index([recipientUserId])
}

enum OutboundDraftStatus {
  DRAFT
  SCHEDULED
  SENT
  DISCARDED
  EXPIRED
}

// The ESTIMATED monthly value of a funnel record (#2422, story #2393): what the
// account is thought to be worth per month once won. An ESTIMATE, and every
// label that shows it says so — the MARKETING vertical sells usage-based
// pricing (a base fee plus transaction tiers), so an account's real monthly
// revenue moves every month and lives in the billing system, not here. This
// table only stores the figure somebody typed or imported, and
// src/lib/dealValue.ts adds those figures up month by month.
//
// ITS OWN TABLE, NOT TWO COLUMNS ON MentorshipRelation — the one deliberate
// deviation from the issue text. Dozens of read paths return every scalar of a
// relation (`include:` without a top-level `select`) to its mentee, its
// company user and its source, and #1801 makes "the person a record is about
// does not read the operator's view of them back" a rule. A column would leak
// on every one of those paths until each was found and stripped; a row nobody
// `include`s leaks on none. Same shape as Placement.valueMinor next door.
//
// MONEY, the src/lib/roi.ts rules: an integer in MINOR units (cents) plus an
// ISO 4217 code, never a float. No row means "no estimate", which is not 0.
model RelationValue {
  // Nullable orgId, like the relation it hangs off; every writer stamps the
  // relation's own orgId explicitly (the importer and the transfer run where
  // the middleware may bind none).
  orgId       String?
  org         Organization?      @relation(fields: [orgId], references: [id])
  relationId  String             @id
  relation    MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  valueMinor  Int
  currency    String             @default("EUR") @db.VarChar(3)
  // MANUAL (the record's owner or an ADMIN typed it) | IMPORT (the marketing
  // account import's `mrr` column). A transfer copies the predecessor's.
  source      String             @default("MANUAL") @db.VarChar(20)
  // Plain id, no FK: erasing a person must not be blocked by, or cascade into,
  // a commercial figure they once typed (same reasoning as Placement.offerId).
  updatedById String?
  updatedAt   DateTime           @updatedAt

  @@index([orgId])
}

// Structured hiring demand (#806). CompanyNeed remains in place during the
// compatibility window; legacyCompanyNeedId makes the manual backfill safe to
// rerun without coupling the two live write paths.
model Requisition {
  id                  String    @id @default(cuid())
  // A row of the starter pack's sample programme (#2066): synthetic, labelled,
  // removed as a set by DELETE /api/admin/organizations/[id]/sample-data.
  sampleData          Boolean   @default(false)
  orgId               String
  companyId           String
  title               String
  description         String?   @db.Text
  status              String    @default("DRAFT")
  openings            Int
  filled              Int       @default(0)
  requiredSkills      Json      @default("[]")
  city                String?
  workMode            String?
  startDate           DateTime?
  ownerId             String?
  legacyCompanyNeedId String?   @unique
  createdAt           DateTime  @default(now())
  // The /api/v1 keyset (#1990); @default(now()) so db push can add it to a table with rows.
  updatedAt           DateTime  @default(now()) @updatedAt
  closedAt            DateTime?

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User?        @relation("RequisitionOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  interests         CompanyInterest[]
  interviewRequests InterviewRequest[]
  applications      Application[]
  // Canonical twin of `requiredSkills` (#1815), written alongside it.
  skills            RequisitionSkill[]

  @@index([orgId, companyId])
  @@index([orgId, status])
  @@index([ownerId])
  // The /api/v1 keyset (#1990).
  @@index([orgId, updatedAt, id])
}

// A company asks the program/authorized mentor to interview one shortlisted
// mentee for one requisition (#807). Status stays String so the workflow can
// grow without a schema enum migration.
model InterviewRequest {
  id                String    @id @default(cuid())
  requisitionId     String
  menteeId          String
  companyId         String
  orgId             String
  status            String    @default("PENDING")
  note              String?   @db.Text
  declineReasonCode String?
  // Optional free-text elaboration on the decline reason (never required).
  declineNote       String?   @db.Text
  decidedById       String?
  decidedAt         DateTime?
  proposedSlots     Json?
  activeKey         String?   @unique
  // The interview as a real Meeting (#1844): set when an approver schedules
  // it, so the request and the calendar entry point at each other. SCHEDULED
  // and CANCELLED are written only by /schedule and /cancel; the meeting is
  // taken off the calendars through the shared cancel path, never deleted.
  meetingId         String?   @unique
  scheduledAt       DateTime?
  cancelledAt       DateTime?
  cancelledById     String?
  cancelReason      String?   @db.Text
  // The scorecard panel convened for this interview (#1846), created in the
  // same transaction as the meeting when the approver asks for one.
  panelId           String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  requisition Requisition     @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  mentee      User            @relation("InterviewRequestMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  decidedBy   User?           @relation("InterviewRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  meeting     Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  cancelledBy User?           @relation("InterviewRequestCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  panel       InterviewPanel? @relation(fields: [panelId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([companyId, requisitionId])
  @@index([menteeId, status])
  @@index([requisitionId, menteeId])
  // The /api/v1 keyset (#1990).
  @@index([orgId, updatedAt, id])
}

/// One person being considered for one role, and where they are in it (#1828).
/// The row every hiring screen reads: the per-role funnel, the interview
/// outcome, the offer that fills the requisition. `stage`, `status` and
/// `source` are plain Strings validated against the whitelists in
/// src/lib/applications.ts (the repo's convention for status-like values, see
/// Offer.status) — `stage` is the fine-grained funnel step, `status` the coarse
/// outcome derived from it (ACTIVE | HIRED | REJECTED | WITHDRAWN) so a report
/// can count open applications without knowing the stage vocabulary.
/// CompanyInterest stays in place as the company's flat flag; the only bridge
/// between the two is applicationFromInterest(). One application per person
/// per role is enforced by the database, not by a handler.
model Application {
  id               String    @id @default(cuid())
  orgId            String
  requisitionId    String
  menteeId         String
  companyId        String
  status           String    @default("ACTIVE")
  stage            String    @default("APPLIED")
  source           String    @default("SELF")
  screeningAnswers Json?
  coverNote        String?   @db.Text
  dispositionCode  String?
  dispositionNote  String?   @db.Text
  withdrawnAt      DateTime?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requisition Requisition        @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  mentee      User               @relation("ApplicationMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events      ApplicationEvent[]

  @@unique([requisitionId, menteeId])
  @@index([orgId, status])
  @@index([companyId, stage])
  @@index([menteeId])
}

/// The audit trail of an application: one row per stage change, the funnel
/// report's source (#1828). Reached only through its application, so it
/// carries no orgId and is deliberately not in TENANT_MODELS. `fromStage` is
/// null on the row that created the application.
model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String
  fromStage     String?
  toStage       String
  actorId       String?
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?       @relation("ApplicationEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([actorId])
}

/// A user's own Google Calendar, connected by them and revocable by them (#709).
/// One row per user: the app never creates a Google account and never writes to
/// anyone's calendar without this row existing.
model GoogleCalendarConnection {
  id     String @id @default(cuid())
  userId String @unique

  /// The Google account that granted consent — shown back to the person so they
  /// can tell WHICH calendar this is before they trust it or disconnect it.
  googleEmail String
  /// 'primary' unless the operator points it elsewhere.
  calendarId  String @default("primary")
  /// What Google actually granted. Stored so a scope that was reduced on
  /// re-consent is visible rather than discovered by a failing write.
  scope       String @db.Text

  /// Both sealed with lib/secretBox (AES-256-GCM), never written in the clear.
  /// The access token is short-lived; the refresh token is the one that matters.
  accessTokenEnc  String   @db.Text
  refreshTokenEnc String?  @db.Text
  expiresAt       DateTime

  /// Operational state, so a broken connection is visible in the UI instead of
  /// failing silently on every meeting.
  lastSyncAt DateTime?
  lastError  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  events GoogleCalendarEventLink[]
}

/// Which Google event a meeting became, on whose calendar (#709).
/// Per (meeting, user) rather than per meeting: the same meeting is pushed to
/// every connected participant's own calendar, and each gets a different event
/// id — one column on Meeting could only ever remember one of them.
/// One mirrored Google event per (meeting OR series) × connection. Exactly one of
/// `meetingId` / `seriesId` is set (#2654): a recurring series is mirrored as ONE
/// recurring event with an RRULE, never as one event per occurrence, because its
/// occurrences have no `Meeting` row (#1110). `meetingId` became nullable for
/// that — a relaxation, so existing rows are untouched.
model GoogleCalendarEventLink {
  id            String   @id @default(cuid())
  meetingId     String?
  seriesId      String?
  connectionId  String
  googleEventId String
  pushedAt      DateTime @default(now())

  meeting    Meeting?                 @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  series     MeetingSeries?           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([meetingId, connectionId])
  @@unique([seriesId, connectionId])
  @@index([connectionId])
}

/// What happened to one mentor suggestion (#2040).
/// SHOWN is written the moment the suggestion is returned; ACCEPTED/DISMISSED
/// overwrite it when the admin acts. There is deliberately no "IGNORED": a row
/// that stays SHOWN *is* the ignored case, and a fourth state would need a
/// sweeper to decide when hesitation became a decision.
enum MatchFeedbackAction {
  SHOWN
  ACCEPTED
  DISMISSED
}

/// The mentor-matching feedback loop (#2040): every suggestion we put in front
/// of an admin, and what they did with it. Without this the ranking can never
/// improve and the simplest question about it — "how often is our suggestion
/// taken?" — has no answer.
///
/// Complementary to the pairing record (#1789, MatchDecision): that one stores
/// the match that HAPPENED, this one stores the ones that did not. They share
/// `batchId` so the two can be joined once both exist.
///
/// Writing here is always best-effort: a failed insert must never break a
/// suggestion response or an assignment (same discipline as the AI metering in
/// src/lib/aiGate.ts).
model MatchFeedback {
  id       String  @id @default(cuid())
  /// Tenant anchor. Nullable like the other phase-1 tenant models; the model is
  /// listed in TENANT_MODELS (src/lib/orgContext.ts) so Prisma queries
  /// auto-scope once MT_ENFORCE_ISOLATION is on. The report aggregates with raw
  /// SQL, which the middleware never sees, so it filters on orgId explicitly.
  orgId    String?
  menteeId String
  mentorId String

  /// One id per POST /api/admin/mentor-suggest call, returned to the client so
  /// it can echo it back with the outcome. Every suggestion of one call — and
  /// the eventual accept/dismiss — carries the same batchId.
  batchId String

  /// 1-based position in the list as it was shown.
  ///
  /// NULL means "this mentor was never in that batch's suggestion list" — i.e.
  /// the admin assigned somebody we did not suggest. That is how an off-list
  /// assignment stays distinguishable from accepting a suggestion, and why the
  /// per-rank report only counts rows that have a rank.
  ///
  /// NOTE for raw SQL: `rank` is a reserved word in MySQL 8 — always backtick it.
  rank           Int?
  /// The rule-based score the row was ranked by (today: number of shared
  /// skills). Kept so a later ranking change can be compared against this one.
  score          Float?
  /// Which ranking rule set produced the row (src/lib/matchFeedback.ts).
  ruleSetVersion String?
  /// Whether the AI re-ranking actually ran for this batch.
  aiUsed         Boolean @default(false)

  action     MatchFeedbackAction @default(SHOWN)
  /// Short dismissal reason code — one of MATCH_DISMISS_REASONS
  /// (src/lib/matchFeedback.ts), validated at the route. Free text goes to
  /// reasonNote so the codes stay aggregatable.
  reason     String?
  reasonNote String?             @db.Text
  /// Who accepted/dismissed. Null on SHOWN rows — nobody has acted yet.
  actorId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization? @relation(fields: [orgId], references: [id])
  mentee User          @relation("MatchFeedbackMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor User          @relation("MatchFeedbackMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  actor  User?         @relation("MatchFeedbackActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// One row per (batch, mentor) — the key the feedback upsert writes through.
  @@unique([batchId, mentorId])
  @@index([orgId, createdAt])
  @@index([orgId, action, createdAt])
  @@index([menteeId])
  @@index([mentorId])
  @@index([actorId])
}

/// How a matching rule takes part in a score (#1781). WEIGHTED adds
/// weight × ratio; HARD_REQUIRE blocks the pair when the dimension does not
/// match; HARD_EXCLUDE blocks it when it does. A block is score 0 with the
/// rule named — never a silent drop.
enum MatchRuleKind {
  WEIGHTED
  HARD_REQUIRE
  HARD_EXCLUDE
}

/// An organisation's mentor-matching rule set (#1781). The pure scorer lives
/// in src/lib/matching/score.ts; an org with no set here scores with the
/// built-in DEFAULT_RULE_SET, which reproduces the pre-#1781 ranking exactly.
model MatchRuleSet {
  id          String    @id @default(cuid())
  orgId       String?
  name        String
  description String?   @db.Text
  /// The set resolveRuleSet() picks for the org. At most one per org is
  /// intended; the resolver takes the newest default if two ever exist.
  isDefault   Boolean   @default(false)
  version     Int       @default(1)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org   Organization? @relation(fields: [orgId], references: [id])
  rules MatchRule[]

  @@index([orgId, isDefault, archivedAt])
}

/// One rule of a MatchRuleSet (#1781). `dimension` is a key from the client-
/// safe registry in src/lib/matching/dimensions.ts; an unknown key is scored
/// as a non-match rather than ignored. Carries its own orgId (same as its set)
/// so it is tenant-scoped on its own and listed in TENANT_MODELS.
model MatchRule {
  id        String        @id @default(cuid())
  orgId     String?
  ruleSetId String
  dimension String
  kind      MatchRuleKind @default(WEIGHTED)
  /// 0-100. Only WEIGHTED rules use it.
  weight    Int           @default(0)
  /// Per-dimension settings, e.g. `{ "maxHours": 3 }` for timezone.
  config    Json          @default("{}")
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id])
  ruleSet MatchRuleSet  @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@index([ruleSetId, sortOrder])
  @@index([orgId])
}

// ── Background job queue ─────────────────────────────────────────────────────
//
// The durable substrate for the queue engine (#1669). Only the `Job` half is
// here: this PR (#1674) is the *observability* task and needs somewhere to
// count from — queue depth and dead-letter size on /api/health, plus the daily
// dead-letter alert. `JobRun`, `enqueue()`, the SKIP LOCKED `claim()` and the
// worker loop are #1671/#1673 and are deliberately NOT in this file yet.
//
// Field names are copied verbatim from #1671's specification so the two land as
// the same table rather than as two competing ones — whichever PR merges second
// deletes its copy of this block instead of resolving a conflict by hand. The
// one deliberate addition is the `orgId`-leading index below, which #1671's
// draft does not have and which every other TENANT_MODELS entry does.
enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  // Retries exhausted: nothing will pick this row up again. This is the state
  // the daily alert (src/lib/jobs/dlqAlert.ts) exists to make visible.
  DEAD_LETTER
  CANCELLED
}

model Job {
  id       String    @id @default(cuid())
  name     String    @db.VarChar(64)
  payload  Json
  status   JobStatus @default(PENDING)
  /// Higher runs first; the claim query orders by priority DESC, runAt ASC.
  priority Int       @default(0)
  /// Earliest moment the job may run — "due" means runAt <= now.
  runAt    DateTime  @default(now())

  attempts    Int     @default(0)
  maxAttempts Int     @default(5)
  /// Message of the most recent failure. May echo whatever the handler threw,
  /// so every surface that renders it runs it through sanitizeError() first.
  lastError   String? @db.Text

  /// Lease held by a worker while status is RUNNING.
  lockedAt DateTime?
  lockedBy String?   @db.VarChar(64)

  /// Enqueue-side de-duplication key: the same key never produces a second row.
  /// Global rather than `@@unique([orgId, idempotencyKey])` on purpose: `orgId`
  /// is nullable and MySQL treats NULLs in a unique index as distinct, so a
  /// composite key would silently stop de-duplicating anything at all while
  /// every row still has a null org (i.e. today). Revisit it together with the
  /// backfill that makes `orgId` non-null.
  idempotencyKey String? @unique

  /// Tenant anchor. Nullable like the other phase-1 tenant models; the model is
  /// listed in TENANT_MODELS (src/lib/orgContext.ts) so Prisma queries
  /// auto-scope once MT_ENFORCE_ISOLATION is on. Operational readers (health,
  /// the dead-letter alert) run outside any request scope and therefore see the
  /// whole queue, which is what an operator alert has to do.
  orgId String?

  /// Provenance of the ENQUEUE (#1673), one of 'schedule' | 'manual' | 'boot'
  /// (JobTrigger in src/lib/jobs/types.ts). The worker copies it onto every
  /// `JobRun` it writes for this job, so an admin's re-run of a scheduled job
  /// reads as 'manual' on the ledger. A database-side default, so existing rows
  /// (the mail queue's) read 'schedule' and `db push` can add it to a full table.
  trigger String @default("schedule") @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Attempt ledger (#1671). Cascade: a deleted job takes its runs with it —
  /// a run row that outlived its job describes nothing and would only make
  /// `pruneJobRuns()` the sole thing standing between the table and orphans.
  runs JobRun[]

  @@index([status, runAt, priority])
  @@index([name, status])
  /// Tenant-leading, like every other model in TENANT_MODELS (MatchFeedback's
  /// `[orgId, createdAt]`, Requisition's `[orgId, status]`, AccountLockout's
  /// `[orgId]`). Without it, an auto-scoped query under MT_ENFORCE_ISOLATION
  /// would filter orgId row-by-row on top of the status index — including the
  /// claim query `status=PENDING AND runAt<=now`, which is the hottest one this
  /// table will ever serve.
  @@index([orgId, status, runAt])
}

/// One row per ATTEMPT at a job (#1671, absorbing #1606). `Job` says what must
/// happen and what state it is in now; `JobRun` is the only place that records
/// what actually happened each time somebody tried — which is what makes the
/// twelve cron callbacks this queue replaces visible for the first time.
///
/// Deliberately NOT in TENANT_MODELS (src/lib/orgContext.ts): it carries no
/// `orgId` and is system-level operational data, reached only through the `Job`
/// it belongs to. Registering a model with no tenant column would make the
/// isolation middleware filter on a field that does not exist.
model JobRun {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Which attempt this was — `Job.attempts` at the moment the handler ran.
  /// Not derived from the row count: a pruned ledger must not renumber history.
  attempt Int

  /// Provenance, one of 'schedule' | 'manual' | 'boot' (see JobTrigger in
  /// src/lib/jobs/types.ts). Without it the operations console (#1607) cannot
  /// tell "the 09:00 slot fired" from "an admin pushed re-run".
  trigger String @db.VarChar(16)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// Defaults to false because the row is written BEFORE the handler runs: a
  /// run that never got a finishing stamp (the container died mid-handler) is
  /// not a success, and reading `ok` needs no join with `finishedAt` to say so.
  ok Boolean @default(false)

  durationMs Int?

  /// Message of the throw that ended this attempt. Free text from the handler,
  /// so every surface that renders it runs it through sanitizeError() first.
  error String? @db.Text

  /// COUNTERS ONLY — `Record<string, number>` in TypeScript, enforced again at
  /// runtime by sanitizeSummary() in src/lib/jobs/queue.ts. Never an e-mail
  /// address, a name or message content: the admin surfaces render it more or
  /// less verbatim.
  summary Json?

  @@index([jobId])
  @@index([startedAt])
}

// ── Programme economics ──────────────────────────────────────────────────────
//
// "What did this programme return?" was unanswerable at the data layer: 88
// models and not one cost, fee or value column (#1892). These two models are
// the smallest honest economics record that can produce an ROI number — costs
// on one side, placement value on the other. The arithmetic itself lives in
// src/lib/roi.ts, which never imports Prisma.
//
// MONEY IS ALWAYS AN INTEGER IN MINOR UNITS plus an ISO 4217 code. No Float,
// no Decimal-as-string. A `Float` column would make every sum in the ROI report
// depend on binary rounding, and a report whose total changes with the order of
// its rows is worse than no report. The `Minor` suffix on every money column is
// deliberate and load-bearing: it says "4500 is €45.00, not €4500". Minor units
// rather than "cents" because zero-decimal currencies (JPY, KRW) have no cents
// — how many minor units make a major one follows from the currency code, and
// only the presentation layer needs to know.

// One line of programme spend, in one currency, over one period.
//
// ADDITIVE BY CONSTRUCTION: an ROI window's cost side is the SUM of the rows
// whose period overlaps it. There is no "total" column to keep in step, no
// recomputation on write, and correcting a figure is editing or deleting one
// row. That is also why the period is two dates rather than a month key — a
// platform subscription billed annually and a mentor's time logged for one week
// are the same shape here.
model ProgramCost {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The programme this spend belongs to. `Cohort` IS the programme today;
  // #1622 promotes it to `Program` and this column moves with it under the new
  // name. NULL means an org-wide cost that no single cohort owns (the platform
  // subscription, the coordinator's salary) — those still count against every
  // programme's ROI, which is why the column is nullable rather than required.
  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  // PLATFORM | STAFF | MENTOR_TIME | EVENT | OTHER. Free String, not an enum:
  // the same reasoning as PipelineStage (#747) — a tenant's chart of accounts
  // is theirs, and an enum makes adding a category a schema change. The known
  // keys and their labels live in src/lib/roi.ts + the `roi` i18n block.
  category String @db.VarChar(40)
  label    String @db.VarChar(200)

  // Minor units. A refund or a correction is a NEGATIVE amount rather than a
  // deleted row, so the ledger keeps its history; the ROI sum is additive
  // either way.
  amountMinor Int
  currency    String @db.VarChar(3)

  // Inclusive period the spend covers. `@db.Date` (not DateTime) on purpose: a
  // cost belongs to a day, not to an instant, so it must not shift by a
  // timezone offset when it is read back on another continent.
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  note String? @db.Text

  createdById String?
  createdBy   User?   @relation("ProgramCostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant-leading, like every other TENANT_MODELS entry. The report's only
  // query is "this org's costs overlapping this window", in that order.
  @@index([orgId, periodStart])
  @@index([orgId, category])
  @@index([cohortId])
}

// The value side: one placement, and what it was worth.
//
// SCOPE NOTE (#1892 / #1765). #1765 owns this record — the stamping from
// src/lib/stageChange.ts, the reversal rule, the invoice states and the
// /admin/placements ledger are all its work and are deliberately NOT here.
// This PR creates the table early because the ROI model has nowhere to attach
// value otherwise, and #1892 says so explicitly: add the value fields in the PR
// that creates `Placement`, do not stand up a parallel model. #1765 extends
// these columns (attribution, feeModel, invoiceState, invoiceRef, reversedAt,
// creditedMentorId, sourceId) — all additive, none of them a rename.
//
// The fee columns are named `feeMinor` / `feeCurrency` rather than #1765's
// sketched `feeAmountCents`, so every money column in the tree reads the same
// way and none of them claims that every currency has cents.
model Placement {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // One placement per relation. A re-hire after a re-match is a new relation,
  // so it is a new placement — which is also what keeps `placementCount` from
  // counting the same hire twice.
  relationId String             @unique
  relation   MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  menteeId String
  mentee   User   @relation("PlacementMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Plain id, not a FK — the same reasoning as Offer.requisitionId: the
  // accounting record must stay readable even if the offer it came from is
  // edited away.
  offerId String?

  placedAt DateTime

  // What the placement was worth, to whoever the report is for. NULL means
  // "not recorded" and is NOT the same as zero: the ROI model falls back to the
  // documented assumption set for a null and reports how many placements it had
  // to assume for, so an estimate can never be mistaken for a measurement.
  valueMinor    Int?
  valueCurrency String? @db.VarChar(3)

  // OFFER_COMP | MANUAL | ORG_DEFAULT — where the number above came from, so
  // the screen can say. OFFER_COMP defaulting waits on #1851 (structured
  // compensation on Offer); the only source Offer carries today is a free-text
  // note, and parsing money out of prose is exactly the guess this model
  // refuses to make.
  valueSource String? @db.VarChar(20)

  // The success fee the programme charges for this placement, when it bills
  // that way. Kept separate from `valueMinor` and never folded into it: the two
  // accrue to different parties, and adding them double-counts one hire.
  feeMinor    Int?
  feeCurrency String? @db.VarChar(3)

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, placedAt])
  @@index([companyId])
  @@index([menteeId])
}

// ── Commercial spine (#1731, epic #1727) ─────────────────────────────────────
//
// What a tenant is paying for. Until now the whole commercial state of an
// Organization was one enum column (`plan OrgPlan`), which cannot express a
// customer id, a billing period, a trial, an interval or a single feature
// granted outside the plan — so every non-standard deal had to be modelled as
// "put them on ENTERPRISE and hope".
//
// `Organization.plan` and `src/lib/orgPlans.ts` are deliberately LEFT IN PLACE
// and still authoritative for the four planGate call sites. This slice lands
// the storage and the plan→feature matrix (`src/lib/plans.ts`) without changing
// any behaviour; migrating the gates onto it is a later task in the epic.
//
// `planKey`, `status` and `interval` are Strings, not enums, for the same
// reason `MentorshipRelation.pipelineStatus` is (#747): this repo deploys with
// `prisma db push --accept-data-loss`, which resolves a MySQL ENUM change as
// DROP + CREATE. Packaging changes more often than the schema should, and a
// per-PR topic environment pushes against its own fresh database — so the
// destructive diff would look perfectly healthy on the PR and only bite
// production. The legal values live in src/lib/plans.ts.
model Subscription {
  id String @id @default(cuid())

  // One live subscription per tenant, hence @unique. A superseded subscription
  // is not kept here as a second row: history belongs in the billing provider
  // (and later in an event log), not in the row the app reads on every request.
  orgId String @unique

  // A key from PLANS in src/lib/plans.ts ('community' | 'program' | …), stored
  // as text so repackaging needs no migration. An unknown value resolves to the
  // free tier rather than to unlimited access (see resolveEntitlements()).
  planKey String @default("community")

  // TRIALING | ACTIVE | PAST_DUE | CANCELED | INCOMPLETE — see
  // SUBSCRIPTION_STATUSES in src/lib/plans.ts, which also decides which of them
  // still carry the plan's features.
  status String @default("ACTIVE")

  // MONTHLY | YEARLY. Decides which published price applies; it is not a
  // discount of its own (the annual saving is baked into the yearly price).
  interval String @default("MONTHLY")

  // The period the tenant has paid for. Nullable because a free/community
  // subscription has no period at all, and because the authority for these
  // dates is the billing provider, which is not wired up yet.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?

  // Set when the customer has cancelled but keeps access to the end of the
  // period. Access is decided by `status`, never by this flag alone.
  cancelAtPeriodEnd Boolean @default(false)

  // The published 50% education/non-profit discount. It lives on the
  // subscription because it is a property of the DEAL: re-deriving it per
  // screen from a domain, a country or an org name would make two screens
  // disagree about what the customer pays.
  educationDiscount Boolean @default(false)

  // Filled by the later Stripe task; unique so one provider subscription can
  // never be linked to two tenants.
  stripeSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status])
}

// A feature granted to a tenant OUTSIDE its plan: a pilot, a goodwill unlock,
// a paid add-on (the AI pack), a contractual exception. Row presence = feature
// on, mirroring the CompanyEntitlement convention (#517) so nothing new has to
// be learned — but keyed on the ORG, because white-label, SSO and the AI pack
// belong to the customer running the programme, not to a company in its talent
// pool.
//
// A grant only ever ADDS to what the plan already includes; there is no
// negative grant. Revoking is deleting the row, and taking away something the
// plan sells is a plan change.
model OrgEntitlement {
  id    String @id @default(cuid())
  orgId String

  // A key from PREMIUM_FEATURES (src/lib/entitlementsCatalog.ts), stored as
  // text so adding a feature needs no migration.
  feature String

  // Who granted it. Deliberately NOT a foreign key (same as Tag.createdById):
  // the audit trail of a commercial exception must outlive the admin account
  // that created it.
  grantedById String?

  // Why it was granted — the sentence a future admin needs in order to decide
  // whether the exception is still justified.
  note String? @db.Text

  // Optional end date for a time-boxed grant. Enforced by the resolver in
  // src/lib/subscription.ts, which drops expired rows before handing the set
  // to the pure matrix; nothing deletes them, so the history stays readable.
  expiresAt DateTime?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, feature])
  @@index([orgId])
}

// ── Single-owner leases for background work (#1701) ─────────────────────────
//
// Two app replicas behind one reverse proxy is the point of #1694: the process
// stops being a single point of failure and a release stops being a moment of
// downtime. Almost everything the app does is safe to run twice — requests are
// stateless (the session is a JWT), the job worker claims rows with SKIP LOCKED
// so *more* workers are better, and since #1696 the rate-limit counters live
// outside the process. Two pieces of background work are not:
//
//   'scheduler'   — the in-process cron. Two of them send every reminder twice.
//   'imap-bridge' — the inbound-mail poller. Two of them race over the `\Seen`
//                   flag on one mailbox, so a reply is imported twice or not at
//                   all (src/instrumentation.ts).
//
// A lease is how those keep exactly one owner without anyone electing anything:
// one row per lease NAME (the primary key, so "two rows for one lease" is a
// database error rather than a race), the current `holder`, and an `expiresAt`
// in the near future. Acquiring or stealing is ONE conditional UPDATE whose
// WHERE clause carries the precondition ("still mine", or "expired"), the same
// shape as the trusted-device token rotation: MySQL locks the row for the
// update and re-evaluates the clause against the committed value, so of two
// contenders exactly one can match.
//
// TTL, never a manual release: a replica that is SIGKILLed, OOM-killed or
// simply hangs releases nothing. The lease therefore has to expire on its own,
// and the holder keeps it by renewing well inside the TTL. The cost of that
// choice is bounded and deliberate — after the holder dies the work pauses for
// up to one TTL before the other replica picks it up. For the mail bridge that
// is a few minutes of delayed inbound mail, never a duplicate, which is the
// failure that cannot be undone.
//
// Rules in src/lib/jobs/lease.ts; unit-tested in scripts/test/job-lease.test.mjs.
// No `orgId`: this is operational state about processes, not tenant data.
model JobLease {
  /// The lease name — 'scheduler', 'imap-bridge'. Primary key on purpose: the
  /// uniqueness of a lease is the invariant this table exists to enforce.
  name String @id @db.VarChar(64)

  /// Who holds it right now: the replica id (container name + pid), as reported
  /// by /api/health. Never a person.
  holder String @db.VarChar(190)

  /// When the current holder first took it (a renewal does not move this), so
  /// "how long has this replica been the owner?" is answerable.
  acquiredAt DateTime @default(now())

  /// Last successful renewal. A holder whose renewedAt is old is a holder that
  /// stopped renewing — the lease is about to change hands.
  renewedAt DateTime @default(now())

  /// The moment the lease becomes stealable. The only thing that frees a lease
  /// held by a replica that died.
  expiresAt DateTime

  /// Incremented on every change of ownership. Nothing depends on it for
  /// correctness — the conditional UPDATE already provides that — but it makes
  /// a flapping lease visible instead of guessable.
  generation Int @default(1)

  /// Cheap sweep of leases nobody renewed (an environment that shrank back to
  /// one replica, a renamed container).
  @@index([expiresAt])
}

// ── Mail send budget ─────────────────────────────────────────────────────────
// The shared send budget of ONE environment (every replica and every lane of
// it): a GCRA meter in one row per SMTP channel. Rules — lanes, tolerance, the
// critical reserve, the throttle ladder — in src/lib/mailDeliveryRule.ts (pure,
// unit-tested in scripts/test/mail-delivery-rule.test.mjs); the row operations
// in src/lib/mailBudgetStore.ts, each ONE conditional UPDATE on UTC_TIMESTAMP(3).
// No `orgId`: like JobLease, this is operational state about the relay, not
// tenant data, and it is shared by every tenant and both worlds on purpose.
// This is a meter, not a lease: nothing holds it and nobody is elected.
model MailBudget {
  /// The budget's name — 'smtp' (primary channel) or 'smtp:bulk' (the
  /// optional bulk server, budgetNameFor()). Primary key: one meter per name.
  name String @id @db.VarChar(64)

  /// Theoretical arrival time: a send is allowed while `tat - now` is within
  /// the lane's tolerance, and moves it one emission interval forward. A
  /// throttle pushes it out by the current pause rung.
  tat DateTime @default(now()) @db.DateTime(3)

  /// Rung of the throttle pause ladder (MAIL_THROTTLE_LADDER_SEC). Climbs on a
  /// relay throttle, decays by one on every delivered mail.
  pauseLevel Int @default(0)

  /// When the current relay pause ends (#2944). Written only by a throttle or
  /// a relay-wide failure, never by a send: the breaker that holds critical
  /// mail and the queue drain decides on THIS, not on `tat`, which in observe
  /// mode also carries every metered send and can run hours ahead of any real
  /// pause. Null = never paused. Nullable, so adding it is an expand-only push.
  pausedUntil DateTime? @db.DateTime(3)

  /// When the relay outage the current pause belongs to began (#2953): set by
  /// the first throttle or relay-wide failure after a quiet spell, kept while
  /// the pauses follow each other, cleared by a delivered mail. What the
  /// "breaker open for more than 15 minutes" operator alert reads — the rung
  /// alone cannot say how long the relay has been refusing. Nullable, so adding
  /// it is an expand-only push.
  pausedSince DateTime? @db.DateTime(3)

  /// UTC day (YYYY-MM-DD) `dayCount` belongs to — the optional bulk daily cap.
  dayKey   String? @db.VarChar(10)
  dayCount Int     @default(0)

  updatedAt DateTime @updatedAt @db.DateTime(3)
}

// A tenant admin's request to move to another plan (#1743): the recorded,
// audited step between "I want to upgrade" and a checkout, which a self-serve
// checkout never removes. An operator (a super admin of the org's world,
// src/lib/superAdmin.ts) applies or rejects it from /admin/plan-requests.
//
// Strings, not enums, for the same reason as Subscription: `db push
// --accept-data-loss` resolves a MySQL ENUM change as DROP + CREATE. The
// vocabularies and every rule over them live in src/lib/planChangeRule.ts.
model PlanChangeRequest {
  id    String @id @default(cuid())
  orgId String

  // Who asked. Deliberately NOT a foreign key (same as OrgEntitlement's
  // grantedById): the record of a commercial request outlives the account.
  requestedById String

  // A PROGRAM-audience key from src/lib/plans.ts, and MONTHLY | YEARLY.
  requestedPlan String @db.VarChar(32)
  billingCycle  String @db.VarChar(16)

  // Snapshots at request time, so the operator decides on what the tenant saw:
  // the plan it was on, and this month's active pairs as the nightly rollup
  // last counted them (null = not counted yet; never a live scan).
  currentPlan String @db.VarChar(32)
  activePairs Int?

  // Free text — also where "we are over the band" goes.
  reason         String? @db.Text
  // The tenant claims the education/non-profit discount; the operator decides.
  educationClaim Boolean @default(false)

  // NEW | APPLIED | REJECTED (PLAN_CHANGE_STATUSES).
  status String  @default("NEW") @db.VarChar(16)
  // The requester's UI language, so a reply can be written in it.
  locale String? @db.VarChar(8)

  // ONE open request per org: equal to orgId while NEW, NULL once handled. A
  // second submit therefore updates the open row instead of piling up — the
  // unique index, not a read-then-write, is what holds that under a race (the
  // same shape as MentorshipRelation.activeMenteeKey).
  openKey String? @unique

  handledById String?
  handledAt   DateTime?
  // The operator's note, shown to the requester on a rejection.
  note        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([status, createdAt])
}

// ── Usage ledger ─────────────────────────────────────────────────────────────
// One row per (org, metric, period): what a tenant used in a calendar month
// (#1750). The billing history, and the only table an invoice or a usage screen
// reads — a request path must never scan seven domain tables to answer "how
// many active pairs?".
//
// TWO SHAPES OF NUMBER live in the same table, and the difference is what keeps
// a re-run honest (src/lib/meteringRules.ts owns the catalogue):
//   · COMPUTED (ACTIVE_MATCHED_PAIRS, ADMIN_SEATS) — recomputed from the domain
//     tables by the nightly rollup and written ABSOLUTELY. Re-running a closed
//     period writes the same value again, so the job is idempotent, and the
//     unique triple below guarantees exactly one row per (org, metric, period).
//   · COUNTER (VIDEO_ROOM, VIDEO_PARTICIPANT, ACTIVE_PAIR_ACTIVITY) —
//     incremented at the moment the thing happens, because a room created last
//     Tuesday cannot be recounted afterwards. The rollup never touches these.
//
// `metric` is a String and not an enum on purpose: metrics are added far more
// often than a column type change is welcome on a `db push` project, and the
// authoritative list is a TypeScript union that both the writer and the reader
// import. An unknown string here is inert — a row nothing reads.
model UsageRollup {
  id     String @id @default(cuid())
  orgId  String
  metric String @db.VarChar(64)
  // 'YYYY-MM', a UTC calendar month (src/lib/meteringRules.ts periodRange()).
  period String @db.VarChar(7)
  value  Int    @default(0)

  // When the number was last written. For a COMPUTED metric that is when the
  // rollup last recomputed it — an invoice dispute starts with "as of when?".
  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The idempotency key, and why the nightly job can be re-run for a closed
  // period without producing a second row.
  @@unique([orgId, metric, period])
  @@index([orgId, period])
  @@index([metric, period])
}

// ── Notification delivery ledger (#1710) ─────────────────────────────────────
//
// "Was the mentor actually told, on which channel, and did it land?" had no
// answer. `Notification` records that an in-app row exists; `EmailLog` records
// that an SMTP handoff happened, keyed by e-mail address and subject. Neither
// says "this person, this event, this channel, this outcome" — so a mentee who
// never heard about a stage change was indistinguishable from one told twice,
// and an opt-out that silently swallowed a notification looked exactly like a
// send that never happened.
//
// One row per (recipient, event, channel, attempt identity). Written by
// src/lib/notifications/router.ts and by nothing else.
//
// NO RELATION TO User, ON PURPOSE. This follows EmailLog and AuditLog, the two
// other ledgers here: a delivery record is evidence about a moment in the past,
// and a cascade would erase exactly the rows an audit needs. `userId` is a
// plain column.
//
// It therefore has NO retention entry yet, and that is a known follow-up rather
// than an oversight: src/lib/retentionEntries.ts is the one registry that bounds
// tables like this, and AuditLog (#1585), DomainEvent (#1691) and Message
// (#2056) are already queued behind it. Nothing writes here until a send site
// moves onto the router, so the table is empty on the day this ships; the entry
// (a window setting plus one `registerRetention` block, the shape Notification
// used in #1646) is owed before the migration task lands.
enum NotificationDeliveryStatus {
  // Accepted and handed to a channel that completes later (the e-mail job).
  QUEUED
  // The channel reported success. For e-mail that is an SMTP handoff, not inbox
  // placement — the same caveat EmailStatus.SENT carries.
  SENT
  // Deliberately not sent: an opt-out, a missing address, no adapter. The cause
  // is in `skipReason`, and a SKIPPED row is the whole point of the ledger —
  // silence with a recorded reason instead of silence.
  SKIPPED
  // The channel was tried and failed. `error` carries the message.
  FAILED
}

model NotificationDelivery {
  id String @id @default(cuid())

  /// Tenant anchor. Nullable like the other phase-1 tenant models, stamped from
  /// the recipient's own `User.orgId` by the router (so it is right even when
  /// the write happens in a cron with no request scope). Listed in
  /// TENANT_MODELS (src/lib/orgContext.ts).
  orgId String?

  userId   String
  /// A key of the event catalogue (src/lib/notifications/catalog.ts).
  /// VarChar(96): the longest key today is 34 characters.
  eventKey String @db.VarChar(96)
  /// 'inApp' | 'email' — the NotificationChannel literal, stored as text like
  /// EmailLog.transport rather than as an enum, so adding a channel adapter is
  /// a code change and not a schema change on a live table.
  channel  String @db.VarChar(16)

  status     NotificationDeliveryStatus @default(QUEUED)
  /// Why a SKIPPED row was skipped: 'category_off', 'group_off', 'email_off',
  /// 'no_address', 'no_adapter', 'unknown_event', 'invalid_payload'.
  skipReason String?                    @db.VarChar(64)
  /// What rendered it — the dictionary key for in-app, the mail template id for
  /// e-mail. Nullable: a SKIPPED row never reached a template.
  templateId String?                    @db.VarChar(128)
  /// Failure message when status is FAILED.
  error      String?                    @db.Text

  /// Idempotency. Globally `@unique` rather than `@@unique([orgId, …])` for the
  /// same reason Job.idempotencyKey is: `orgId` is nullable, MySQL treats NULLs
  /// in a unique index as distinct, and a composite key would therefore
  /// de-duplicate nothing at all while every row still has a null org. The
  /// router derives it from (eventKey, userId, channel, caller dedupe key) and
  /// reads the unique violation as "already claimed" — which is what stops a
  /// retried send from both duplicating this row and sending the mail twice.
  dedupeKey String @unique @db.VarChar(191)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// "What was this person told, most recent first" — where an admin support
  /// question actually starts.
  @@index([userId, createdAt])
  /// "Did event X reach anybody, and how often was it skipped?"
  @@index([eventKey, status])
  /// Tenant-leading, like every other model in TENANT_MODELS: without it an
  /// auto-scoped query under MT_ENFORCE_ISOLATION filters orgId row by row on
  /// top of one of the indexes above.
  @@index([orgId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Scheduled roster feed (#1963 / #1964 / #1965)
//
// A tenant's HR export, fetched on a schedule and turned into an accurate
// roster. The engine is src/lib/rosterIngest.ts on top of the shared import
// engine (src/lib/importPreview.ts); these three tables are the part of it that
// has to survive a crash.
//
// NOTE ON OWNERSHIP: #1964 owns these models. They are created here because the
// ingestion engine (#1965) has nowhere to keep its checkpoint otherwise, and
// #1964 had not landed when this shipped — the same arrangement the issue
// prescribes for src/lib/importPreview.ts. #1964 extends them (schedule
// expression, last-error surfacing, the admin UI's counters); nothing here is a
// rename.
// ─────────────────────────────────────────────────────────────────────────────

enum RosterTransport {
  HTTPS
  SFTP
}

enum RosterKeyField {
  EMAIL
  EXTERNAL_ID
}

enum RosterRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  NOOP
  /// A safety valve stopped the run before anything was written (#1966).
  ABORTED_SAFETY
}

/// Mirrors `RowStatus` in src/lib/importPreview.ts, token for token. One
/// vocabulary for every importer in the tree — a second one would let the same
/// outcome be called two things on two screens.
enum RosterRowStatus {
  CREATE
  UPDATE
  UNCHANGED
  SKIP
  ERROR
  /// The deprovisioning phase (#1966), which runs after the import and outside
  /// `runImport` — so these two have no counterpart in importPreview.ts.
  /// Their rows carry a negative `rowNumber`: they describe a person the file
  /// did NOT contain, so there is no file row to point at.
  DEACTIVATE
  REACTIVATE
}

/// One configured feed for one tenant.
model RosterFeed {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String          @db.VarChar(120)
  transport RosterTransport @default(HTTPS)
  enabled   Boolean         @default(false)

  /// HTTPS transport. Checked by assertPublicHttpsUrl() before every fetch: the
  /// URL is tenant-supplied and fetched from the server's network position.
  url String? @db.Text

  /// SFTP transport.
  sftpHost               String? @db.VarChar(255)
  sftpPort               Int?
  sftpUsername           String? @db.VarChar(191)
  sftpPath               String? @db.Text
  /// The pinned host key fingerprint (#1964). No fingerprint, no connection.
  sftpHostKeyFingerprint String? @db.VarChar(191)
  /// The NAME of the environment variable holding the SFTP secret — never the
  /// secret. A credential in a database row is a credential in every backup.
  credentialEnvVar       String? @db.VarChar(120)
  /// The feed's secret (SFTP password / private key, or the HTTPS bearer
  /// token), sealed with `seal(…, 'roster-feed-secret')` (#1964). Written only
  /// by /api/admin/roster-feeds, which answers `secretSet: boolean` and never
  /// the value. Takes precedence over `credentialEnvVar`, which stays for an
  /// operator who would rather keep the secret out of the database altogether.
  secretEnc              String? @db.Text

  /// Force a delimiter instead of sniffing it (';' for a German Excel export).
  delimiter String? @db.VarChar(4)

  /// Which column identifies a person. EMAIL is the default and cannot tell an
  /// address change from a leaver plus a joiner; EXTERNAL_ID can.
  keyField RosterKeyField @default(EMAIL)

  /// Our field name → the header this tenant's export happens to use.
  columnMap Json

  /// The tenant declaring the feed is the record of truth for these people.
  /// False (the default) means the feed fills gaps but never overwrites a value
  /// a human typed — the same policy SSO sync follows.
  authoritative Boolean @default(false)

  chunkSize Int?

  /// Deprovisioning (#1966, docs/roster-feeds.md). Off by default: a feed
  /// deactivates nobody until a tenant asks it to. The three valves below are
  /// read only when it is on; every one has a DB-side default (#2298).
  deprovision          Boolean @default(false)
  /// Abort, write nothing and alert when the people the feed would offboard
  /// exceed this share of the org's active people the feed covers.
  maxDeactivatePercent Int     @default(10)
  /// Abort, write nothing and alert when the file has fewer data rows.
  minRowCount          Int     @default(1)
  /// A person is deactivated only on a successful run at least this many UTC
  /// days after the run that first found them absent.
  deprovisionGraceDays Int     @default(1)

  /// When the feed runs: a five-field cron expression evaluated in UTC
  /// (`src/lib/rosterFeed.ts`). Null = run by hand only.
  cronExpression String?   @db.VarChar(120)
  lastRunAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs RosterRun[]

  @@index([orgId, enabled])
}

/// One attempt at one file. Identified by (feedId, fileHash, dryRun): that is
/// what makes apply idempotent and a retry resumable rather than a re-apply.
model RosterRun {
  id     String     @id @default(cuid())
  feedId String
  feed   RosterFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  /// Tenant anchor. A plain column rather than a second FK to Organization: the
  /// row is reached through `feed`, which cascades, and the column is what
  /// registers the model with the tenant middleware (TENANT_MODELS).
  orgId String

  /// SHA-256 of the fetched bytes. Equal to the last successful run's hash means
  /// the file has not changed and the run is a no-op.
  fileHash String  @db.VarChar(64)
  dryRun   Boolean @default(false)

  status RosterRunStatus @default(RUNNING)

  /// The resume checkpoint: the index of the first chunk NOT yet committed.
  /// Written in the same transaction as the chunk it describes, and contiguous
  /// — it never advances past a chunk that failed, so a failed chunk is
  /// re-attempted next run instead of being skipped for ever.
  nextChunkIndex Int @default(0)

  rowCount         Int     @default(0)
  createdCount     Int     @default(0)
  updatedCount     Int     @default(0)
  unchangedCount   Int     @default(0)
  skippedCount     Int     @default(0)
  errorCount       Int     @default(0)
  /// Deprovisioning outcome (#1966).
  deactivatedCount Int     @default(0)
  reactivatedCount Int     @default(0)
  /// Why a safety valve stopped the run (`row_floor` / `deactivation_ceiling`),
  /// with the numbers, for the alert and the console.
  safetyReason     String? @db.Text
  /// Keys the roster holds that the feed did not mention. Reported only —
  /// acting on them is #1966.
  absentKeys       Json?
  /// Host and path of the file, for the run log. Never a query string: it can
  /// carry a token.
  source           String? @db.Text
  error            String? @db.Text

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  rows RosterRowResult[]

  /// The idempotency key. A second run of the same file for the same feed finds
  /// this row instead of starting over.
  @@unique([feedId, fileHash, dryRun])
  @@index([feedId, startedAt])
  @@index([orgId, startedAt])
}

/// One row's outcome, written as it is applied — inside the same transaction as
/// the write it describes, which is what makes a crashed run readable.
model RosterRowResult {
  id    String    @id @default(cuid())
  runId String
  run   RosterRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Tenant anchor; same reasoning as RosterRun.orgId.
  orgId String

  /// 1-based position among the data rows (the header is not row 1).
  rowNumber  Int
  chunkIndex Int             @default(0)
  key        String          @db.VarChar(255)
  status     RosterRowStatus
  /// Field names an UPDATE wrote.
  changed    Json?
  /// Why it was skipped, what errored, or which fields were left alone.
  message    String?         @db.Text
  userId     String?

  createdAt DateTime @default(now())

  /// One result per row per run — so re-applying a chunk after a crash upserts
  /// instead of doubling the log.
  @@unique([runId, rowNumber])
  @@index([runId, status])
  @@index([orgId, createdAt])
  /// The retention sweep (#1964): row detail older than 90 days goes, across
  /// every tenant at once — see `rosterRowResult` in src/lib/retentionEntries.ts.
  @@index([createdAt])
}

// ── Scheduled report delivery (#1905) ────────────────────────────────────────
// A named report from the registry (src/lib/reports/definitions.ts) mailed on a
// cadence to ONE recipient: a user of the org (`recipientUserId`, whose
// `analytics-report` opt-out keeps applying) or an address with no account
// (`recipientEmail` — the dean, the funder), who leaves through a signed link.
// The rules (cadence, period key, due-ness) live in src/lib/reportSubscriptions.ts;
// the sender is src/lib/jobs/reportSubscriptions.ts. docs/report-subscriptions.md.
//
// Vocabularies are VARCHAR + a whitelist in code, never a Prisma enum, for the
// reason `pipelineStatus` is (#747): growing an enum is an ENUM→VARCHAR migration.
model ReportSubscription {
  id              String                   @id @default(cuid())
  orgId           String?
  org             Organization?            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// A key of REPORT_DEFINITIONS; an unknown key is refused when written.
  reportKey       String                   @db.VarChar(64)
  params          Json?
  /// WEEKLY | MONTHLY | QUARTERLY
  cadence         String                   @db.VarChar(16)
  /// ISO weekday, 1 = Monday … 7 = Sunday (WEEKLY only).
  dayOfWeek       Int?
  /// 1–28 (MONTHLY and QUARTERLY), so every month has the day.
  dayOfMonth      Int?
  /// Hour of the day, UTC, 0–23.
  hour            Int
  /// en | tr | de — the language of the mail, labels included.
  locale          String                   @db.VarChar(8)
  /// EMAIL_SUMMARY | CSV | XLSX — a table in the body, or the file attached.
  format          String                   @db.VarChar(16)
  recipientUserId String?
  recipientUser   User?                    @relation("ReportSubscriptionRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientEmail  String?                  @db.VarChar(320)
  recipientName   String?                  @db.VarChar(191)
  /// The admin who set it up — an id, deliberately not a relation, so the
  /// subscription outlives that admin's account.
  createdById     String?
  isActive        Boolean                  @default(true)
  lastSentAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  sends           ReportSubscriptionSend[]

  @@index([orgId, isActive])
  @@index([recipientUserId])
}

/// One row per subscription per period — the idempotency marker. The job
/// CLAIMS the period by inserting it before sending, so a second run (a retry,
/// a second replica) collides on the unique and sends nothing.
model ReportSubscriptionSend {
  id             String             @id @default(cuid())
  orgId          String?
  org            Organization?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   ReportSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// "2026-W41", "2026-10", "2026-Q4" — or "test-<ms>" for a send-me-a-test.
  periodKey      String             @db.VarChar(32)
  /// CLAIMED | SENT | SKIPPED | FAILED
  status         String             @db.VarChar(16)
  /// Why it was skipped or failed — a code, never a recipient's data.
  error          String?            @db.VarChar(191)
  sentAt         DateTime           @default(now())

  @@unique([subscriptionId, periodKey])
  @@index([orgId, sentAt])
}

// ── Relationship-health snapshots (#1901) ────────────────────────────────────
// One row per ACTIVE relation per UTC day, written by the nightly sweep
// (src/lib/jobs/relationHealthSweep.ts) from scoreRelation() (#1898). The
// unique makes a re-run of the same day an upsert, not a second row; rows
// older than the retention window are pruned by the same sweep — this is the
// one table here that grows without bound otherwise.
model RelationHealthSnapshot {
  id           String             @id @default(cuid())
  orgId        String?
  org          Organization?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  relationId   String
  relation     MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  /// The UTC day the snapshot describes (midnight UTC).
  takenOn      DateTime           @db.Date
  /// 0-100, or null for a pair no rule could judge yet.
  score        Int?
  /// HEALTHY | WATCH | AT_RISK
  band         String             @db.VarChar(16)
  /// The rule flags behind the score (HealthReason[]).
  reasons      Json
  rulesVersion Int
  /// Set on the snapshot whose crossing into AT_RISK was put in an admin
  /// digest — the marker that keeps it to one alert per crossing.
  alertedAt    DateTime?
  createdAt    DateTime           @default(now())

  @@unique([relationId, takenOn])
  @@index([orgId, takenOn])
}

// ── Admin-defined forms (#1800, story #1798) ─────────────────────────────────
//
// Questions an admin adds to registration, onboarding, the profile or a
// mentorship request, and the answers people give. The field-type union and
// the ONE validator are src/lib/forms/schema.ts (client-safe, shared with the
// survey engine); the write boundary is src/lib/forms/definitions.ts. Two
// rules carry the design:
//   • ANSWERS ARE KEYED BY fieldKey, not by a field id. A published definition
//     is never edited in place — an edit is version N+1 — so a field id changes
//     with every version while its key does not; an answer given to v1 still
//     resolves under v2.
//   • A KEY'S TYPE IS FIXED across the versions of a form once published (409),
//     and a free-text field can never be `matchable` (refused at the write).
// The vocabularies (audience, surface, field type) are Strings validated by
// whitelists, the house rule for enum-like columns.

model FormDefinition {
  id          String        @id @default(cuid())
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // The form's stable name within the org, e.g. "mentee_registration".
  key         String        @db.VarChar(80)
  // MENTEE | MENTOR | BOTH
  audience    String        @db.VarChar(16)
  // REGISTRATION | ONBOARDING | PROFILE | MENTORSHIP_REQUEST
  surface     String        @db.VarChar(32)
  version     Int           @default(1)
  // { en?, tr?, de? } — the builder's name for it. Nullable: Json columns
  // carry no default under MariaDB (prisma/backfill-json-columns.mjs).
  title       Json?
  publishedAt DateTime?
  // Set on a version superseded by a newer published one, or retired.
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  fields    FormField[]
  responses FormResponse[]

  @@unique([orgId, key, version])
  @@index([orgId, surface])
}

// Deliberately NOT in TENANT_MODELS: a field is only ever reached through its
// FormDefinition, which is scoped — the SurveyQuestion reasoning. It carries
// no orgId, so every nested write stays a plain nested create.
model FormField {
  id           String         @id @default(cuid())
  definitionId String
  definition   FormDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  // The answer join key: stable across versions, its type fixed once published.
  key          String         @db.VarChar(80)
  // A FormFieldType (src/lib/forms/schema.ts).
  type         String         @db.VarChar(20)
  // { en?, tr?, de? }. Every writer sets it (no Json default under MariaDB).
  labels       Json
  helpText     Json?
  // [{ value, labels: { en?, tr?, de? } }] for SELECT / MULTI_SELECT; null otherwise.
  options      Json?
  required     Boolean        @default(false)
  // May feed matching (#1803). Only a bounded type — canBeMatchable().
  matchable    Boolean        @default(false)
  sortOrder    Int            @default(0)
  // Removed from the form: no longer asked, its answers still read.
  archivedAt   DateTime?

  @@unique([definitionId, key])
  @@index([definitionId, sortOrder])
}

// One person's answer to one field of one version. Carries orgId itself —
// the matching engine loads a cohort's answers for one field without a join
// (@@index([orgId, fieldKey])).
model FormResponse {
  id           String         @id @default(cuid())
  orgId        String?
  org          Organization?  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  definitionId String
  definition   FormDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  fieldKey     String         @db.VarChar(80)
  // Every writer sets it (no Json default under MariaDB).
  value        Json
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, definitionId, fieldKey])
  @@index([orgId, fieldKey])
  @@index([definitionId])
}

// ── Surveys (#1879, epic #1877) ──────────────────────────────────────────────
//
// The survey engine's data model. NOT an Evaluation: an evaluation is one named
// person assessing another against a framework, and is read by the people
// involved; a survey is many people answering about their own experience, and
// is read in aggregate. docs/surveys.md has the full design, including what
// each anonymity mode promises. Who may read which answer is decided in ONE
// place, src/lib/surveyPrivacy.ts, never in a component.

enum SurveyAudience {
  MENTEE
  MENTOR
  BOTH
  COMPANY
}

// IDENTIFIED   — the respondent is known and an ADMIN may read their answer.
// CONFIDENTIAL — the respondent is known to the system (for completion and
//                follow-up) but individual answers are read only by the
//                respondent; staff see aggregates above the response floor.
// ANONYMOUS    — the link between a person and their answer is never written:
//                SurveyResponse.respondentId and .invitationId are NULL at
//                insert (src/lib/surveys.ts), not filtered on read.
enum SurveyAnonymity {
  IDENTIFIED
  CONFIDENTIAL
  ANONYMOUS
}

enum SurveyStatus {
  DRAFT
  OPEN
  CLOSED
}

model Survey {
  id    String        @id @default(cuid())
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id])

  // e.g. `program_post`. Not unique: an org runs the same instrument more than once.
  key          String          @db.VarChar(80)
  // Which built-in instrument it came from (src/lib/surveyTemplates.ts), if any.
  templateKey  String?         @db.VarChar(80)
  // { en?, tr?, de? }. No @default: Prisma drops Json defaults against MariaDB
  // (prisma/backfill-json-columns.mjs), so every writer sets them.
  title        Json
  intro        Json?
  audience     SurveyAudience
  anonymity    SurveyAnonymity
  status       SurveyStatus    @default(DRAFT)
  opensAt      DateTime?
  closesAt     DateTime?
  // The response floor for this survey. Raised per survey, never lowered below
  // SURVEY_MIN_RESPONSES — effectiveMinResponses() enforces it on read.
  minResponses Int             @default(5)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  questions   SurveyQuestion[]
  invitations SurveyInvitation[]
  responses   SurveyResponse[]
  campaigns   SurveyCampaign[]

  @@index([orgId, status])
}

// Deliberately NOT in TENANT_MODELS: a question is only ever reached through
// its Survey, which is scoped — the same reasoning as MeetingGuest. Adding it
// would make every nested write need an orgId it has no use for.
model SurveyQuestion {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  // The answer join key. Immutable once the survey has opened — refused with
  // 409 at the write boundary (src/lib/surveys.ts) — so an answer always
  // resolves to the question it answered, whatever its wording became.
  key       String  @db.VarChar(80)
  // A FormFieldType (src/lib/forms/schema.ts) or NPS. A String, validated by
  // the shared union, so adding a type is not a schema change.
  type      String  @db.VarChar(20)
  labels    Json
  helpText  Json?
  // [{ value, labels: { en?, tr?, de? } }] for choice questions; null otherwise.
  options   Json?
  required  Boolean @default(false)
  sortOrder Int     @default(0)

  @@unique([surveyId, key])
  @@index([surveyId, sortOrder])
}

// One row per person invited to one survey — the completion-tracking table.
// The TOKEN is never stored, only its hash (the TrustedDevice discipline).
model SurveyInvitation {
  id       String        @id @default(cuid())
  orgId    String?
  org      Organization? @relation(fields: [orgId], references: [id])
  surveyId String
  survey   Survey        @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  // Reminders (#1889). `remindersSent` below is capped at SURVEY_MAX_REMINDERS
  // (src/lib/surveyReminders.ts), and every reminder — scheduled or "remind
  // now" — is claimed by ONE conditional UPDATE on it, so the two paths can
  // never both send the same reminder. Each reminder mints its own link
  // (`tokens`); `tokenHash` below is the first one.
  lastRemindedAt DateTime?
  tokens         SurveyInvitationToken[]

  // Null for an external recipient with no account.
  userId        String?
  user          User?     @relation("SurveyInvitee", fields: [userId], references: [id], onDelete: SetNull)
  email         String    @db.VarChar(191)
  locale        String?   @db.VarChar(5)
  tokenHash     String    @unique @db.VarChar(64)
  sentAt        DateTime?
  remindersSent Int       @default(0)
  // Stamped on submit in EVERY mode — completion still works for an anonymous
  // survey, without the response knowing which invitation it came from.
  respondedAt   DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  // Which round of the survey this invitation is for (#1887): "" for a
  // one-off, a recurring campaign's pulse period ("pulse:3") otherwise. One
  // invitation per person per round — the unique below (#2769).
  round         String    @default("") @db.VarChar(80)

  response SurveyResponse?

  // Widened from [surveyId, email] in a second deploy (#2769, the contract
  // step of #1887): MariaDB will not drop a unique the surveyId foreign key
  // relies on, so the FK's own index below had to be live first. Keep that
  // index — it is what lets this unique change again.
  @@unique([surveyId, email, round])
  @@index([surveyId])
  @@index([orgId])
}

model SurveyResponse {
  id       String        @id @default(cuid())
  orgId    String?
  org      Organization? @relation(fields: [orgId], references: [id])
  surveyId String
  survey   Survey        @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  // Both NULL for an ANONYMOUS survey, written that way at insert.
  invitationId   String?           @unique
  invitation     SurveyInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  respondentId   String?
  respondent     User?             @relation("SurveyRespondent", fields: [respondentId], references: [id], onDelete: SetNull)
  // MENTEE | MENTOR | COMPANY | GUEST — kept in every mode: it is what the
  // aggregates are broken down by, and alone it identifies nobody.
  respondentRole String            @db.VarChar(20)
  // The pairing the answer is about, when there is one. A plain id, not a
  // foreign key: an answer outlives the relation it was about.
  relationId     String?
  submittedAt    DateTime          @default(now())

  answers SurveyAnswer[]

  @@index([orgId, surveyId])
  @@index([surveyId, submittedAt])
}

// A link minted by a survey reminder (#1889). The database keeps only the
// hash, like SurveyInvitation.tokenHash: the token cannot be re-derived, so a
// reminder mints a new one rather than resending the first — and the first
// keeps working, because people click whichever mail they find. Every token
// answers the same invitation, once. Not in TENANT_MODELS: reached only
// through its SurveyInvitation, which is scoped.
model SurveyInvitationToken {
  id           String           @id @default(cuid())
  invitationId String
  invitation   SurveyInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  tokenHash    String           @unique @db.VarChar(64)
  createdAt    DateTime         @default(now())

  @@index([invitationId])
}

// Not in TENANT_MODELS for the same reason as SurveyQuestion: reached only
// through its SurveyResponse. Keyed by questionKey, not question id, so
// re-wording a question never orphans an answer.
model SurveyAnswer {
  id          String         @id @default(cuid())
  responseId  String
  response    SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionKey String         @db.VarChar(80)
  value       Json
  text        String?        @db.Text

  @@unique([responseId, questionKey])
  @@index([questionKey])
}

// One participant's answer to "how was the meeting?" (#1896). Two questions at
// most: did it actually happen, and how helpful was it (1-5). `happened =
// false` is its own answer — a meeting that did not take place is valuable
// data and is never scored as a bad meeting (helpfulness stays NULL).
//
// One row per (meeting, rater): answering again updates it. Only the two
// people of the relation rate a relation meeting; external MeetingGuest
// invitees are never asked (no account, no relation). Who may read what is
// src/lib/meetingFeedback.ts — a mentor gets aggregates above the response
// floor, never one mentee's answer.
model MeetingFeedback {
  id          String        @id @default(cuid())
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id])
  meetingId   String
  meeting     Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  raterId     String
  rater       User          @relation("MeetingFeedbackRater", fields: [raterId], references: [id], onDelete: Cascade)
  // Denormalised from the meeting so the health score reads one table.
  relationId  String?
  happened    Boolean
  helpfulness Int?
  note        String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([meetingId, raterId])
  @@index([relationId, createdAt])
  @@index([orgId])
}

// ── Survey campaigns (#1887) ─────────────────────────────────────────────────
//
// Who gets which survey, when — so the programme sends it, not an admin.
// One idempotent sweep (src/lib/surveyCampaigns.ts, daily and `job=surveys`)
// resolves each active campaign into targets and invites them, claiming a
// SurveyCampaignSend row BEFORE anything is minted or mailed.

// STAGE_ENTERED   — a relation entered `stageKey` (read from StatusChange, the
//                   tenant's own stage key, never a hardcoded one).
// DAYS_AFTER_START — `dayOffset` days after the relation started.
// DAYS_BEFORE_END — `dayOffset` days before the relation's stage deadline.
// DAYS_AFTER_END  — `dayOffset` days after the relation COMPLETED (#1912): the
//                   first-destination survey, 30/90/180 days on.
// RECURRING       — every `everyDays` days, one round per period.
// MANUAL          — once to the whole audience, as soon as it is active.
enum SurveyTrigger {
  STAGE_ENTERED
  DAYS_AFTER_START
  DAYS_BEFORE_END
  DAYS_AFTER_END
  RECURRING
  MANUAL
}

model SurveyCampaign {
  id        String          @id @default(cuid())
  orgId     String?
  org       Organization?   @relation(fields: [orgId], references: [id])
  surveyId  String
  survey    Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  name      String          @db.VarChar(120)
  trigger   SurveyTrigger
  stageKey  String?         @db.VarChar(64)
  dayOffset Int?
  everyDays Int?
  // Null inherits the survey's audience.
  audience  SurveyAudience?
  active    Boolean         @default(true)
  lastRunAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  sends SurveyCampaignSend[]

  @@index([orgId, active])
}

// The idempotency claim: one row per (campaign, person, period), written
// before the invitation is minted or the mail sent. A second sweep finds the
// row and does nothing. Not in TENANT_MODELS: reached only through its
// SurveyCampaign, the same reasoning as SurveyQuestion.
model SurveyCampaignSend {
  id           String         @id @default(cuid())
  campaignId   String
  campaign     SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  relationId   String?
  userId       String
  // `stage:<key>`, `day:<n>`, `before:<deadline day>`, `pulse:<n>` or `manual`.
  periodKey    String         @db.VarChar(80)
  invitationId String?
  createdAt    DateTime       @default(now())

  @@unique([campaignId, userId, periodKey])
  @@index([campaignId, createdAt])
}

// A named filter preset on an admin list (#1900) — server-side, so it follows
// the admin to another device and can be shared with the team. `surface` is a
// key from SAVED_VIEW_SURFACES (src/lib/savedViews.ts), never a free string, so
// a typo cannot orphan a view. `visibility` is PRIVATE (the author only) or ORG
// (every admin of the org); only the author edits or deletes either, checked
// in the route handler.
model SavedView {
  id          String        @id @default(cuid())
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id])
  surface     String        @db.VarChar(64)
  name        String        @db.VarChar(80)
  filters     Json
  visibility  String        @default("PRIVATE") @db.VarChar(16)
  createdById String
  createdBy   User          @relation("SavedViewAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([orgId, surface, createdById, name])
  @@index([orgId, surface])
}

// Org-defined segmentation attributes (#1920) — the dimensions a registry report
// can be sliced by (department, level, location, a start date…). Generic on
// purpose: `type` is SELECT | TEXT | DATE | NUMBER and the labels are the
// admin's own words in EN/TR/DE, never a dictionary key. No special-category
// preset ships (docs/analytics.md § Dimensions). Vocabularies are VARCHAR + a
// whitelist in src/lib/orgAttributesRule.ts, never a Prisma enum (#747).
// Tenure is DERIVED from a DATE attribute at read time, never stored.
model OrgAttribute {
  id            String               @id @default(cuid())
  orgId         String
  org           Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Stable machine key (a-z, 0-9, _), what `segmentBy` and the import name.
  key           String               @db.VarChar(64)
  labelEn       String               @db.VarChar(191)
  labelTr       String               @db.VarChar(191)
  labelDe       String               @db.VarChar(191)
  /// SELECT | TEXT | DATE | NUMBER
  type          String               @db.VarChar(16)
  /// SELECT only: the allowed values, as a string array.
  options       Json?
  /// USER today; RELATION is reserved for a later slice.
  appliesTo     String               @default("USER") @db.VarChar(16)
  isSegmentable Boolean              @default(true)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  values        UserAttributeValue[]

  @@unique([orgId, key])
  @@index([orgId, sortOrder])
}

/// One person's value of one attribute. The (orgId, attributeId, value) index
/// is what makes a segmented report one grouped query rather than a scan.
model UserAttributeValue {
  id          String       @id @default(cuid())
  orgId       String
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   OrgAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String       @db.VarChar(191)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, attributeId])
  @@index([orgId, attributeId, value])
  @@index([attributeId])
}

// A text-only practice interview (#2051): the mentee answers, an AI interviewer
// asks the next question, and after `maxTurns` answers an after-action report is
// written and stored as a PRIVATE AiArtifact (`reportArtifactId`) the mentee may
// share with their mentor. No audio, no video, no recording — text only, by
// design. `turns` is the transcript: [{ q, a?, note? }], the mentee's typed
// answers included, so the row cascades with the person (erasure) and is
// tenant-anchored (orgId + TENANT_MODELS).
model PracticeSession {
  id               String    @id @default(cuid())
  orgId            String?
  userId           String
  user             User      @relation("PracticeSessions", fields: [userId], references: [id], onDelete: Cascade)
  requisitionId    String?
  role             String    @db.VarChar(191)
  // ACTIVE | COMPLETED
  status           String    @default("ACTIVE") @db.VarChar(16)
  turns            Json      @default("[]")
  maxTurns         Int       @default(6)
  reportArtifactId String?
  startedAt        DateTime  @default(now())
  endedAt          DateTime?

  @@index([userId, startedAt])
  @@index([orgId])
}

// ── Safeguarding (#2056) ─────────────────────────────────────────────────────
// A message that shared a contact detail or hit an org's watch keyword. The
// rule is src/lib/safeguarding.ts (pure, corpus-tested); the only writer is
// src/lib/safeguardingScan.ts; the queue is /admin/safeguarding. Detection
// NEVER blocks or holds the message — this row is a note for an admin, not a
// gate on the participant's channel. docs/safeguarding.md has the whole story.

enum SafeguardingFlagKind {
  CONTACT_DETAIL
  KEYWORD
}

enum SafeguardingOutcome {
  // Looked at; nothing to do (a false positive, or harmless in context).
  NO_ACTION
  // Looked at and dealt with inside the programme (a word with the mentor…).
  REVIEWED
  // Handed on — to the safeguarding lead, the institution, the authorities.
  ESCALATED
}

model SafeguardingFlag {
  id           String               @id @default(cuid())
  // Tenant data: the org of the message's SENDER, stamped at write time. In
  // TENANT_MODELS (src/lib/orgContext.ts) and filtered by hand in every read.
  orgId        String?
  messageId    String
  kind         SafeguardingFlagKind
  // A MASKED contact detail ("01•• ••••••78") or the watch keyword as the admin
  // configured it — never the full number or address: the message body is the
  // record, and the retention sweep masks bodies, so a flag that kept the
  // number would outlive it.
  matchedTerm  String               @db.VarChar(191)
  createdAt    DateTime             @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  outcome      SafeguardingOutcome?

  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  message    Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("SafeguardingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  // Re-scanning an edited message must not raise the same flag twice.
  @@unique([messageId, kind, matchedTerm])
  // The queue: one org's open flags, newest first.
  @@index([orgId, reviewedAt, createdAt])
  @@index([reviewedById])
}
