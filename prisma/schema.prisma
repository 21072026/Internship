generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MENTOR
  MENTEE
  COMPANY
  SOURCE
}

enum MentorshipStatus {
  ACTIVE
  COMPLETED
}

// Per-tenant plan tier (#547). Concrete limits per plan live in
// src/lib/orgPlans.ts (client-safe), not the DB.
enum OrgPlan {
  FREE
  PRO
  ENTERPRISE
}

enum InteractionType {
  Meeting
  Feedback
  Email
  Call
  WhatsApp
}

// Mentee'nin staj/işe alım sürecindeki granular aşaması (Excel status kolonunun karşılığı)
enum PipelineStatus {
  APPLICATION_100 // 100 tr: ilk temas
  APPROVAL_PENDING_220 // 220 tr: staj için onay bekliyor
  INTERVIEW_PENDING_250 // 250 tr: görüşülecek
  INTRODUCTION_PENDING_270 // 270 tr: tanıştırılacak
  INTERNSHIP_STARTING_300 // 300 tr: staj başlayacak
  INTERNSHIP_IN_PROGRESS_450 // 450 tr: staj devam ediyor
  INTERNSHIP_DROPPED_460 // 460 tr: staj yarım bıraktı
  INTERNSHIP_COMPLETED_490 // 490 tr: staj bitti
  JOB_SEEKING_500 // 500 tr: iş arıyor
  HIREABLE_600 // 600 tr: işe alınabilir
  HIRED_660 // 660 tr: işe alındı
  EMPLOYED_700 // 700 tr: iş buldu
  INTERNSHIP_FOUND_ELSEWHERE_800 // 800 tr: başka yerde staj buldu
}

// Tenant/organization for multi-tenancy (#543). Phase 1: additive & nullable —
// every tenant-scoped row is backfilled to a single default org and nothing
// enforces isolation yet, so behaviour is unchanged. Enforcement (query
// filtering, per-org uniqueness) lands in a later, guarded slice.
model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  // Per-tenant plan tier (#547). Limits per plan live in src/lib/orgPlans.ts
  // (client-safe catalogue), not the DB. New tenants start on FREE; the
  // backfilled legacy "default" org is grandfathered to ENTERPRISE (unlimited)
  // so single-tenant production is never constrained. Limits are advisory in
  // this phase (surfaced as usage-vs-limit), not hard-enforced.
  plan           OrgPlan  @default(FREE)
  // White-label branding (#546). All optional — when null the app falls back to
  // its own defaults (see src/lib/branding.ts). These are stored per tenant and
  // resolved once per-tenant chrome application lands (needs tenant resolution,
  // the #543 enforcement slice); until then they are managed but not applied to
  // the live single-tenant UI.
  brandName      String?
  brandLogoUrl   String?  @db.Text
  brandColor     String?
  supportEmail   String?
  // Enterprise SSO config (#545). All optional; nothing is active until
  // ssoEnabled is true AND a valid config is present (see src/lib/sso.ts).
  // Actual assertion handling requires the tenant's IdP metadata and a SAML
  // library — see docs/sso-saml.md; this stores/validates the config and gates
  // the (documented, not-yet-wired) auth code path.
  ssoEnabled     Boolean  @default(false)
  ssoProvider    String? // 'saml' | 'oidc'
  ssoIssuer      String? // IdP entity ID / issuer
  ssoEntryPoint  String?  @db.Text // IdP SSO sign-in URL
  ssoCertificate String?  @db.Text // IdP x509 signing certificate (PEM)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users                User[]
  sources              Source[]
  cohorts              Cohort[]
  companies            Company[]
  projects             Project[]
  relations            MentorshipRelation[]
  pipelineStages       PipelineStage[]
  evaluationTemplates  EvaluationTemplate[]
  stageSlas            StageSla[]
  tags                 Tag[]
  mentorApplications   MentorApplication[]
  companyInquiries     CompanyInquiry[]
  documentRequirements DocumentRequirement[]
  weeklyReports        WeeklyReport[]
  offers               Offer[]
  requisitions         Requisition[]
  interviewRequests    InterviewRequest[]
}

// Per-tenant customizable pipeline stages (#747, part of white-label #546).
// Phase A is additive + behavior-preserving: an org with NO rows here uses the
// built-in canonical stages (the PipelineStatus enum, src/lib/pipeline.ts), so
// single-tenant production is unchanged. An org that defines rows overrides the
// label / order / color / on-path grouping for the stages it lists. `key` is the
// stable identifier (the enum value for the canonical set; a slug for custom
// stages once storage moves off the enum in a later slice).
// Per-stage service level (#817): "nobody should wait more than N days here".
//
// Deliberately NOT a column on PipelineStage, even though that is where stage
// configuration lives. Custom stages are premium-gated and their editor
// replaces the whole set on every save, so putting the SLA there would (a)
// paywall a candidate-experience feature and (b) wipe every SLA whenever an
// admin renamed a stage. A separate row keyed by stage KEY works for an org on
// the built-in stages and an org with its own, and survives stage edits.
//
// DAYS ARE CALENDAR DAYS, not business days. A candidate waiting over a weekend
// still waited — the SLA measures their experience, not our working hours.
// Business-day arithmetic would need a holiday calendar per country and per
// org; calendar days can only ever fire the warning EARLIER, never later.
// Free-form labels on a person (#887).
//
// NOT a replacement for Cohort or Source, and the distinction matters or the
// three blur into each other:
//   · Cohort — the official period group a candidate belongs to. Exactly ONE.
//   · Source — where a candidate came from. Exactly ONE.
//   · Tag    — whatever this org needs to mark, MANY per person, invented by
//              the people doing the work rather than configured up front.
//
// Org-scoped by construction (orgId required): a tenant must never see another
// tenant's vocabulary, let alone who carries it.
model Tag {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  // Optional hex swatch; the management screen (a separate task) owns picking it.
  color       String?
  createdById String?
  createdAt   DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users UserTag[]

  @@unique([orgId, name])
  @@index([orgId])
}

// Deleting a Tag removes the label, never the person: the cascade runs from
// Tag → UserTag and from User → UserTag, and stops there.
model UserTag {
  id        String   @id @default(cuid())
  userId    String
  tagId     String
  addedById String?
  addedAt   DateTime @default(now())

  user User @relation("UserTags", fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([tagId])
  @@index([userId])
}

model StageSla {
  id        String   @id @default(cuid())
  orgId     String
  // The stage this applies to. A plain key, not a relation: it must work for
  // an org that has no PipelineStage rows at all (i.e. uses the built-ins).
  stageKey  String
  days      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, stageKey])
  @@index([orgId])
}

model PipelineStage {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key        String
  label      String
  order      Int
  isTerminal Boolean      @default(false)
  isOffPath  Boolean      @default(false)
  color      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([orgId, key])
  @@index([orgId, order])
}

model User {
  orgId                   String?
  org                     Organization? @relation(fields: [orgId], references: [id])
  id                      String        @id @default(cuid())
  email                   String        @unique
  password                String
  role                    Role          @default(MENTEE)
  fullName                String
  phone                   String?
  university              String?
  department              String?
  graduationYear          Int?
  skills                  Json          @default("[]")
  // Languages a mentor speaks; distinct from preferredLanguage (the UI locale).
  languages               Json          @default("[]")
  // Mentee self-assessment: { "<skill>": 1..5 }
  skillLevels             Json          @default("{}")
  cvUrl                   String?
  avatarUrl               String?
  whatsapp                String?
  city                    String?
  birthDate               DateTime?
  referralSource          String?
  // Person-level referral (#51): which *person* brought this user in — the
  // mentee, mentor or admin whose invite/referral link they signed up through.
  // Orthogonal to `sourceId` (an institution/channel) and `referralSource`
  // (free text typed by whoever created the record).
  referredById            String?
  // Stable personal referral code behind /auth/register?ref=<code>. Generated
  // on first use so existing rows need no backfill.
  referralCode            String?       @unique
  // Personal ICS calendar-feed credential (#915): unguessable, generated on
  // demand, revocable by nulling. Null = no feed exposed for this user.
  icsFeedToken            String?       @unique
  // How this user's name appears on a published testimonial (#1096):
  // "fullname" | "initials". Null = initials — the privacy-first default;
  // showing the full name is an explicit choice next to the consent toggle.
  testimonialNameStyle    String?
  // Whether the public profile shows the projects/tasks showcase (#1091).
  // The data is the user's own work in PUBLIC projects only, so it rides the
  // publicProfile switch — this just lets them turn that one section off.
  publicShowProjects      Boolean       @default(true)
  // Extended profile (all optional; safe to add to existing rows).
  displayName             String?
  bio                     String?       @db.Text
  country                 String?
  timezone                String?
  linkedinUrl             String?
  githubUrl               String?
  portfolioUrl            String?
  // Mentee: interests / target position. Mentor: max concurrent mentees.
  interests               String?       @db.Text
  targetPosition          String?
  mentorCapacity          Int?
  // Mentor's own "I can take new mentees right now" preference (#941) —
  // distinct from mentorCapacity (a headcount ceiling): a mentor under
  // capacity can still switch this off (e.g. going on leave), and one at
  // capacity could in principle switch it on. Null = no preference set yet;
  // availability then falls back to a capacity-derived guess (see
  // src/lib/mentorAvailability.ts).
  acceptingMentees        Boolean?
  // Set the first time a MENTOR lands on their dashboard (#911), so the
  // one-time redirect to the mentor onboarding wizard never fires twice —
  // stamped before the redirect, not after the wizard is finished/skipped.
  mentorOnboardingSeenAt  DateTime?
  // Default true so existing rows stay writable after the column is added;
  // new self-registrations are created with false until they verify by email.
  emailVerified           Boolean       @default(true)
  // Admin can deactivate a user; inactive users cannot sign in.
  isActive                Boolean       @default(true)
  // Set only when the `selfRegistration` setting is 'manual': the account was
  // created by open sign-up and is waiting for an admin to let it in. Lets the
  // sign-in page tell "we haven't reviewed you yet" apart from "an admin
  // deactivated you" — both are isActive=false. Cleared on activation.
  pendingApproval         Boolean       @default(false)
  // Opt-in: expose a limited, PII-free public profile at /p/[id].
  publicProfile           Boolean       @default(false)
  // For COMPANY-role users: which company they observe (read-only).
  companyId               String?
  // Mentee's referral source (where they came from).
  sourceId                String?
  // How many times this user's public profile has been viewed.
  profileViews            Int           @default(0)
  // When the user accepted the privacy/data terms (consent). Also the anchor
  // for retention re-consent: data is kept no longer than retentionMonths past
  // this date without renewal.
  consentAt               DateTime?
  // Set when a retention/re-consent reminder was last emailed (avoids resending
  // on every cron run). Cleared when the user renews consent.
  retentionReminderSentAt DateTime?
  // The re-engagement pool (#834). On the CANDIDATE, not on MentorshipRelation:
  // the pool is a promise between the organisation and the person ("we will
  // write in September"), and a relation is precisely the thing that ends when
  // the cycle ends — hanging the promise on it would kill the promise at the
  // moment it becomes due. It would also let someone with two relations sit in
  // the pool twice on two different dates, which is incoherent as a commitment.
  reEngageAt              DateTime?
  reEngageNote            String?       @db.Text
  // Idempotency for the reminder cron: stamped when the "let's talk again"
  // message goes out, so a tick that runs twice does not mail twice.
  reEngageNotifiedAt      DateTime?
  // Opt-out switch for transactional email (messages, announcements). In-app
  // notifications are always created regardless.
  emailNotifications      Boolean       @default(true)
  // Per-category email toggles, e.g. {"messages":false}. Nullable so existing
  // rows aren't touched (avoids MariaDB json_valid CHECK issues); unset = on.
  notificationPrefs       Json?
  // Optional TOTP two-factor auth. The secret is only meaningful once enabled.
  twoFactorEnabled        Boolean       @default(false)
  twoFactorSecret         String?
  // Highest TOTP time step already accepted for this account. Three codes are
  // valid at any moment (±1 step for clock skew, ~90s), so without this a code
  // captured by a phishing page or over someone's shoulder could be replayed
  // inside that window (#865). A code must beat this value to be accepted.
  lastTotpStep            Int?
  // "Sign out of all devices": any JWT issued before this instant is rejected at
  // the session callback. Null = never revoked. Set to now() to invalidate every
  // existing session (including the current one) on demand.
  sessionsValidFrom       DateTime?
  // Preferred UI language ('en' | 'tr' | 'de'); applied at sign-in.
  preferredLanguage       String?
  // UI theme preference ('light' | 'dark' | 'system'); applied at sign-in.
  theme                   String?
  // UI font-size preference ('sm' | 'md' | 'lg' | 'xl'); applied at sign-in.
  fontSize                String?
  // UI density preference ('comfortable' | 'compact'); applied at sign-in.
  // Null = comfortable (the default spacing).
  density                 String?
  // UI accent color ('blue' | 'green' | 'purple' | 'rose' | 'teal' | 'amber');
  // drives the app's primary color via data-accent. Null = environment default
  // (green in preview, blue in production).
  accentColor             String?
  // Last successful sign-in; powers "X days since login" in activity reports.
  lastLoginAt             DateTime?
  // Last time the user was seen active (page-view heartbeat, consent-gated).
  lastSeenAt              DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  mentorRelations                   MentorshipRelation[]          @relation("MentorRelations")
  menteeRelations                   MentorshipRelation[]          @relation("MenteeRelations")
  statusChanges                     StatusChange[]                @relation("StatusChangedBy")
  passwordResetTokens               PasswordResetToken[]
  emailVerificationTokens           EmailVerificationToken[]
  tags                              UserTag[]                     @relation("UserTags")
  cvFile                            CvFile?
  avatarFile                        AvatarFile?
  notifications                     Notification[]
  pushSubscriptions                 PushSubscription[]
  conversationParticipants          ConversationParticipant[]
  ownedProjects                     Project[]                     @relation("ProjectOwner")
  projectMemberships                ProjectMember[]               @relation("ProjectMemberships")
  availabilitySlots                 AvailabilitySlot[]
  company                           Company?                      @relation("CompanyUsers", fields: [companyId], references: [id])
  source                            Source?                       @relation(fields: [sourceId], references: [id])
  documents                         Document[]                    @relation("DocumentOwner")
  personalNotes                     PersonalNote[]
  consents                          UserConsent[]
  contributorTermsAcceptances       ContributorTermsAcceptance[]
  googleCalendar                    GoogleCalendarConnection?
  companyInterests                  CompanyInterest[]             @relation("CompanyInterestMentee")
  companyNeedAlerts                 CompanyNeedAlert[]            @relation("CompanyNeedAlertMentee")
  mentorshipRequests                MentorshipRequest[]           @relation("MentorshipRequests")
  decidedRequests                   MentorshipRequest[]           @relation("DecidedMentorshipRequests")
  preferredInRequests               MentorshipRequest[]           @relation("PreferredMentorRequests")
  decidedMentorApplications         MentorApplication[]           @relation("DecidedMentorApplications")
  handledCompanyInquiries           CompanyInquiry[]              @relation("HandledCompanyInquiries")
  supportTickets                    SupportTicket[]               @relation("SupportRequester")
  assignedSupportTickets            SupportTicket[]               @relation("SupportAssignee")
  supportMessages                   SupportMessage[]              @relation("SupportMessageSender")
  authoredRelationNotes             RelationNote[]                @relation("RelationNoteAuthor")
  pageViews                         PageView[]
  referredBy                        User?                         @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers                     User[]                        @relation("UserReferrals")
  sentInvitations                   InvitationToken[]             @relation("InvitationInviter")
  assignedProjectTasks              ProjectTask[]                 @relation("ProjectTaskAssignee")
  authoredProjectTasks              ProjectTask[]                 @relation("ProjectTaskAuthor")
  projectJoinRequests               ProjectJoinRequest[]          @relation("JoinRequester")
  decidedJoinRequests               ProjectJoinRequest[]          @relation("JoinRequestDecider")
  taskTemplates                     ProjectTaskTemplate[]         @relation("TaskTemplateAuthor")
  mentorOnboardings                 MenteeOnboarding[]            @relation("OnboardingMentor")
  menteeOnboarding                  MenteeOnboarding[]            @relation("OnboardingMentee")
  missingDocumentReminderSubjects   DocumentRequirementReminder[] @relation("MissingDocumentReminderSubject")
  missingDocumentReminderRecipients DocumentRequirementReminder[] @relation("MissingDocumentReminderRecipient")
  createdOffers                     Offer[]                       @relation("OfferCreatedBy")
  decidedOffers                     Offer[]                       @relation("OfferDecidedBy")
  reviewedWeeklyReports             WeeklyReport[]                @relation("WeeklyReportReviewer")
  ownedRequisitions                 Requisition[]                 @relation("RequisitionOwner")
  interviewRequests                 InterviewRequest[]            @relation("InterviewRequestMentee")
  decidedInterviewRequests          InterviewRequest[]            @relation("InterviewRequestDecider")
  newsletterSends                   NewsletterSend[]
  trustedDevices                    TrustedDevice[]
  guidanceStates                    UserGuidanceState[]

  @@index([role])
  @@index([referredById])
}

// Per-user state for in-product guidance surfaces (#2068): "I have seen this"
// and "I dismissed this", keyed by a surface string (e.g. `checklist:ADMIN`).
// One generic table rather than a flag per surface — a new tip or tour adds a
// key, never a column. It stores only the ACKNOWLEDGEMENT: whether a checklist
// step is done stays derived from the real rows, because a stored "I did it"
// flag can disagree with reality and a derived one cannot.
model UserGuidanceState {
  id          String    @id @default(cuid())
  userId      String
  key         String
  seenAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

// Consent-gated activity trail: one row per page visit, with the dwell time on
// the previous page. Powers the "pages visited / time on site" section of the
// mentee activity report. Only written when the user has granted
// ACTIVITY_TRACKING consent (see src/lib/consent.ts + /api/track/pageview).
model PageView {
  id          String   @id @default(cuid())
  userId      String
  // App-relative path only (query string stripped), capped in the API.
  path        String
  // Seconds spent on this page before navigating away (0 for the entry hit,
  // filled by the next beacon / an unload beacon).
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Reusable, auditable per-user consent (GDPR). A consent is "active" when
// grantedAt is set and revokedAt is null. Gates optional processing such as
// sending CV text to an AI provider (see ConsentType).
enum ConsentType {
  AI_CV_PARSING
  // Acceptance of the privacy notice & terms at registration. `version` records
  // which policy version was accepted (GDPR Art. 7 demonstrability).
  PRIVACY_POLICY
  // Opt-in to detailed activity tracking (pages visited + time on site) that
  // feeds the mentee activity report shared with the mentor/admin.
  ACTIVITY_TRACKING
  // Explicit opt-in to being visible to companies (talent-pool search,
  // need-match alerts, early access). GDPR basis for company-facing exposure —
  // required IN ADDITION to publicProfile (#527). Default off.
  TALENT_POOL_VISIBILITY
  // Opt-in to sending the mentee's interaction-log text to the AI provider for
  // the mentor-facing auto-summary (Faz 2, #534). Default off.
  AI_INTERACTION_SUMMARY
  // Mentor's explicit opt-in to being listed in the mentee-facing /mentors
  // directory (#937) — required IN ADDITION to publicProfile, mirroring
  // TALENT_POOL_VISIBILITY. Shown: name, expertise, languages, capacity
  // status, bio. Never: email, phone, mentee list. Default off.
  MENTOR_DIRECTORY_VISIBILITY
  // Opt-in to an excerpt of an evaluation being published on marketing pages
  // (#1096). An evaluation is third-party personal data, so BOTH sides must
  // hold this consent — the author (their words) and the subject (it is about
  // them). Revoking unpublishes immediately (revokePublishedFor). Default off.
  TESTIMONIAL
  // "Write to me again when there is a place" (#834) — permission to be
  // CONTACTED in a later cycle. Deliberately NOT the same thing as permission
  // to keep storing the data: that one is anchored on User.consentAt and
  // governed by lib/retention. Conflating them would turn "yes, get in touch in
  // September" into indefinite retention, which is the exact behaviour this
  // feature exists to end. Joining the pool never moves consentAt.
  RE_ENGAGEMENT_POOL
}

model UserConsent {
  id        String      @id @default(cuid())
  userId    String
  type      ConsentType
  // For versioned consents (e.g. PRIVACY_POLICY): the accepted policy version.
  version   String?
  grantedAt DateTime?
  revokedAt DateTime?
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// Contributor terms as DATA, not code (#1025, design in
// docs/legal/contributor-terms-in-app.md). Terms are versioned rows rather than
// a constant because the click-wrap only holds up if the exact text a person
// accepted can be produced later — and because a second project may one day
// have different IP rules, keyed separately.
model ContributorTerms {
  key             String // 'default' | 'project-x' …
  version         String // '1.0'; changing the text means a NEW row, never an edit
  locale          String // 'en' | 'tr' | 'de'
  // Exactly one locale per (key, version) is the binding text; the others are
  // informative translations. Which one it is has to be recorded, not assumed.
  isAuthoritative Boolean  @default(false)
  body            String   @db.Text // markdown
  effectiveFrom   DateTime
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())

  @@unique([key, version, locale])
  @@index([key, effectiveFrom])
}

// Evidence, not preference: who accepted which version, when, and from where.
// A row is written on acceptance and never updated — a later version produces
// another row, so the history is the record.
model ContributorTermsAcceptance {
  id         String   @id @default(cuid())
  userId     String
  termsKey   String
  version    String
  // null = platform-level acceptance (onboarding). A project id scopes the
  // acceptance to that project — § 40 UrhG is why this is a chain of specific
  // acceptances rather than one blanket future-works consent.
  projectId  String?
  acceptedAt DateTime @default(now())
  // Hashed, never raw: the evidence question is "was it the same client", not
  // "what is their address". Same treatment the rest of the app gives an IP.
  ipHash     String?
  uaHash     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsKey, version, projectId])
  @@index([userId])
  @@index([termsKey, version])
}

// A referral source — the education/agency a mentee came from. Admin-managed
// so reporting can group mentees by where they were sourced.
model Source {
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])
  id           String        @id @default(cuid())
  name         String        @unique
  contactName  String?
  contactEmail String?
  createdAt    DateTime      @default(now())

  users User[]

  @@index([name])
}

enum MessageChannel {
  IN_APP
  EMAIL
}

// Conversation layer for messaging: DIRECT is 1:1, GROUP is project/group chat.
model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType
  // Group conversations can be bound to a project; DIRECT conversations may
  // leave this null.
  projectId String?
  // Deterministic identity for a DIRECT (1:1) conversation: the two participant
  // ids sorted and joined with '|'. Unique, so create-or-get can lean on the
  // constraint instead of a read-then-write race (two simultaneous "message
  // this person" clicks would otherwise create two conversations for the same
  // pair). Null for GROUP conversations — MySQL permits many NULLs in a unique
  // index, so groups are unconstrained.
  directKey String?          @unique
  createdAt DateTime         @default(now())
  // @default(now()) as well as @updatedAt: without a default, adding this
  // required column to the already-deployed table would fail `db push` on any
  // non-empty Conversation table.
  updatedAt DateTime         @default(now()) @updatedAt

  project      Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
  meetings     Meeting[]

  // MySQL permits multiple NULL values, so DIRECT conversations remain
  // unaffected while each project can have only one GROUP conversation.
  @@unique([type, projectId])
}

enum ConversationType {
  DIRECT
  GROUP
}

// Membership for a conversation. Authorization can be derived from
// participants rather than MentorshipRelation ownership.
model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  // When the participant joined the conversation (kept as addedAt for backward
  // compatibility with the already-deployed column from #784).
  addedAt        DateTime  @default(now())
  // Last time this participant read the conversation — powers per-conversation
  // unread counts without a per-message read row.
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // No explicit @@index([userId]): MySQL already maintains an index on the FK
  // column (ConversationParticipant_userId_fkey), so lookups by userId are
  // covered. Declaring one here makes `db push` try to *rename* that index into
  // ConversationParticipant_userId_idx, and MySQL refuses to drop an index a
  // foreign key depends on ("Can't DROP INDEX ..._userId_fkey"). Harmless when
  // Prisma creates the table itself, fatal on the already-deployed table (#784).

  @@unique([conversationId, userId])
}

// A message in a mentorship thread (legacy) and/or a conversation (new).
// Sent in-app or mirrored from an email; powers mentor ↔ mentee conversations.
model Message {
  id                   String         @id @default(cuid())
  // New conversation-layer link. Nullable for backward compatibility while
  // legacy relation-bound messages still rely on relationId.
  conversationId       String?
  // Legacy mentorship-thread link. Nullable so conversation-only messages can be
  // written; every pre-existing row keeps its relationId, so the mentorship
  // messaging path is untouched.
  relationId           String?
  senderId             String
  body                 String         @db.Text
  channel              MessageChannel @default(IN_APP)
  readAt               DateTime?
  createdAt            DateTime       @default(now())
  // Set once this message has been included in an unread-digest email so the
  // hourly digest cron never re-sends the same message (#667).
  digestedAt           DateTime?
  // Set when the sender edits the message (shows an "(edited)" label).
  editedAt             DateTime?
  // Set when the sender (or an admin) deletes the message for everyone; the body
  // is masked server-side and a "message deleted" placeholder is shown to all.
  deletedForEveryoneAt DateTime?
  // RFC Message-ID of the email this message came from, for messages created by
  // the inbound mail bridge. Unique so an IMAP replay (at-least-once delivery)
  // can never post the same reply twice. Null for messages written in-app.
  inboundMessageId     String?        @unique

  relation     MentorshipRelation? @relation(fields: [relationId], references: [id], onDelete: Cascade)
  conversation Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]
  // Per-user "delete for me" — hides the message only from these users' view.
  hiddenFor    MessageHiddenFor[]
  // Emoji reactions (👍❤️😂…) from thread participants.
  reactions    MessageReaction[]

  @@index([conversationId])
  @@index([relationId])
}

// A single emoji reaction on a message by one user (WhatsApp/Slack style).
// One row per (message, user, emoji) — a user can add several distinct emojis to
// the same message but not the same emoji twice.
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// "Delete for me": a message hidden from a single user's view (the message and
// attachments stay for everyone else). WhatsApp-style per-user deletion.
model MessageHiddenFor {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// A file/image attached to a message (DB bytes, same approach as CvFile/
// Document — no external object storage needed).
model MessageAttachment {
  id          String   @id @default(cuid())
  messageId   String
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// In-app notification for a user.
model Notification {
  id             String   @id @default(cuid())
  userId         String
  type           String
  // Long-form text (e.g. a broadcast announcement fanned out to every user) —
  // TEXT, not the default VARCHAR(191), so long messages aren't truncated/rejected.
  // Nullable since #921: rows written through the i18n contract carry `params`
  // instead and are rendered from the dictionary in the recipient's locale;
  // `text` remains for announcements (free-form copy) and legacy rows.
  text           String?  @db.Text
  // i18n payload (#921): interpolation values for the dictionary template keyed
  // by `type` (e.g. { from: "Aylin" } for message.new). Null on legacy/announcement rows.
  params         Json?
  // VarChar(500) to match the 500-char cap the announcement API validates; the
  // VARCHAR(191) default rejected long tracking URLs with an unhandled 500.
  link           String?  @db.VarChar(500)
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
  // Set on the rows a broadcast fanned out, so editing the announcement can
  // correct the copy sitting in everyone's bell and deleting it can take those
  // rows with it (#1162). Nullable: every other notification type has no
  // announcement behind it, and an existing row predates this column — a
  // NOT NULL addition here would need a backfill on a live table.
  announcementId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([announcementId])
}

// One Web Push endpoint a user has granted us (#1464, #675 Kademe 2).
//
// A push subscription belongs to a *browser profile*, not to a person: the same
// user signing in on a laptop and a phone produces two rows, and clearing site
// data produces a third while orphaning the first. `endpoint` is therefore the
// identity — it is what the push service hands out and what we POST to — and it
// is unique so a re-subscribe updates the row instead of accumulating duplicates
// that would each deliver the same notification.
model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  // The push service's URL for this browser. VarChar(500), not the VARCHAR(191)
  // default: FCM/Mozilla/Apple endpoints are comfortably longer than 191 chars,
  // and 500 * 4 bytes stays inside InnoDB's 3072-byte key limit for the unique
  // index below.
  endpoint     String   @unique @db.VarChar(500)
  // The subscription's public key and auth secret, used to encrypt each payload
  // for this endpoint (RFC 8291). Base64url, so plain VarChar.
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  // Which browser this is, so /account can list "Chrome on Android" rather than
  // an opaque endpoint. Free-form and untrusted — display only.
  userAgent    String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  // Bumped every time the browser re-confirms the subscription, so a row that
  // has not been seen for months can be recognised as dead weight.
  lastSeenAt   DateTime @default(now())
  // Consecutive delivery failures that were NOT a definitive 404/410 (those
  // delete the row immediately). A transient outage must not drop a valid
  // subscription, but a permanently broken one must not be retried forever.
  failureCount Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // No explicit @@index([userId]): MySQL maintains one for the foreign key
  // already, and declaring it makes `db push` try to rename that index — see the
  // same note on ConversationParticipant.
}

// One row per broadcast admin announcement (distinct from the per-recipient
// Notification rows it fans out to) — lets the admin UI show a history of
// what was sent, by whom, and to how many people.
model Announcement {
  id             String   @id @default(cuid())
  // Broadcast body — TEXT, not the default VARCHAR(191), so admins can publish
  // long-form announcements (release notes, articles) without hitting a limit.
  text           String   @db.Text
  // { en?, tr?, de? } — the announcement in each language it was written in
  // (#1163). `text` above stays the canonical wording and the fallback for a
  // reader whose language has no entry here, so every row written before this
  // column existed keeps working untouched. Nullable for the same reason.
  // Resolved per reader in src/lib/announcementText.ts.
  translations   Json?
  // VarChar(500) to match the API's 500-char cap — see Notification.link.
  link           String?  @db.VarChar(500)
  sentById       String
  recipientCount Int
  emailedCount   Int      @default(0)
  createdAt      DateTime @default(now())

  // Optional attached image. Deliberately NOT mirrored into an `imageUrl`
  // column: the URL is a pure function of the announcement id
  // (/api/announcements/<id>/image), so storing it would only add a second write
  // and a field that can disagree with reality.
  image AnnouncementImage?

  @@index([createdAt])
}

// An image attached to a broadcast announcement, stored in the database (same
// approach as AvatarFile/CvFile — no object storage, so it survives container
// redeploys). Served via /api/announcements/[id]/image.
model AnnouncementImage {
  id             String   @id @default(cuid())
  announcementId String   @unique
  contentType    String
  size           Int
  data           Bytes
  uploadedAt     DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// E-mail newsletter (#1440)
//
// Distinct from Announcement on purpose, even though both broadcast a body to
// many people. An announcement is operational and time-bound ("the meeting has
// started") — read a week late it is noise, which is why the reader feed hides
// anything older than the account. A newsletter issue is *content*: career tips
// that are as useful in November as they were in August, sent on a schedule,
// addressed to a role (mentees, mentors, or both) rather than to everyone, and
// unsubscribable on its own without silencing the operational mail.
//
// Which is also why the two cannot share a table: targeting, scheduling, an
// archive that stays readable, and a per-recipient delivery record are all
// things Announcement deliberately does not have.
// ─────────────────────────────────────────────────────────────────────────────

enum NewsletterAudience {
  // The default. Everything in the curated library is written for the person
  // looking for a placement.
  MENTEE
  // Mentor-facing issues (how to coach a CV review, what to ask in a mock
  // interview). Never sent to mentees.
  MENTOR
  // One issue, both audiences — mentors additionally get the `mentorNote`
  // block, so the same content reaches a coach with a coaching angle.
  BOTH
}

enum NewsletterStatus {
  // Being written. Never sent by the scheduler, whatever `scheduledAt` says.
  DRAFT
  // Queued: the dispatcher picks it up once `scheduledAt` has passed.
  SCHEDULED
  // Claimed by a dispatch run. A row stuck here means a run died mid-send —
  // resuming is safe because NewsletterSend is unique per (issue, address).
  SENDING
  SENT
  // Pulled before it went out. Kept rather than deleted: "we decided not to
  // send this" is itself part of the record.
  CANCELED
}

model Newsletter {
  id String @id @default(cuid())

  // The curated library entry this issue started from
  // (src/lib/newsletterContent.ts), or null when an admin wrote it from
  // scratch. Only ever a provenance marker: the content below is a full copy,
  // so editing the library never rewrites an issue that already went out.
  templateKey String? @db.VarChar(64)

  audience NewsletterAudience @default(MENTEE)
  status   NewsletterStatus   @default(DRAFT)

  // The canonical (default-locale) subject line — the fallback for a reader
  // whose language this issue was never written in, and what the admin history
  // and the activity log show.
  subject String @db.VarChar(300)

  // { en?: NewsletterIssueContent, tr?: …, de?: … } — the whole issue per
  // language: subject, preheader, intro, tips[], optional CTA and mentorNote.
  // Shape and normalisation live in src/lib/newsletter.ts; Json rather than a
  // table of blocks because an issue is only ever read and written whole.
  content Json

  // When the dispatcher should send it. Null for a draft.
  scheduledAt DateTime?
  // When the dispatch run actually finished. The archive orders by this.
  sentAt      DateTime?

  createdById String

  // Filled in by the dispatch run. Kept as counters next to the per-recipient
  // rows below so the history list needs no aggregate query per issue.
  recipientCount Int @default(0)
  sentCount      Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image NewsletterImage?
  sends NewsletterSend[]

  // The dispatcher's own query: "SCHEDULED and due".
  @@index([status, scheduledAt])
  @@index([sentAt])
  @@index([createdAt])
}

// The hero image of an issue, stored in the database like AnnouncementImage
// (no object storage, so it survives a container redeploy). Attached to the
// e-mail inline via cid: and served to the archive from
// /api/newsletters/[id]/image.
model NewsletterImage {
  id           String   @id @default(cuid())
  newsletterId String   @unique
  contentType  String
  size         Int
  data         Bytes
  uploadedAt   DateTime @default(now())

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
}

// One row per recipient per issue — the delivery record ("gönderilmiş bülten
// geçmişi"). EmailLog already logs every outgoing message, but it is keyed by
// address and pruned after 90 days, so it cannot answer "who has already been
// sent issue X?" — which is exactly what makes a resumed dispatch safe.
//
// The @@unique below is that guarantee: a second run over the same issue
// re-sends to nobody.
model NewsletterSend {
  id           String  @id @default(cuid())
  newsletterId String
  // Null once the account is hard-deleted through a path that predates this
  // table; normally set. PII in `email` is cleared by both erasure modes —
  // see forgetEmailLog in src/lib/accountErasure.ts.
  userId       String?
  email        String  @db.VarChar(320)
  // The language this recipient was actually served, which is worth keeping:
  // it is the only place the per-reader resolution is visible afterwards.
  locale       String  @db.VarChar(8)

  status EmailStatus @default(SENT)
  error  String?     @db.Text
  sentAt DateTime    @default(now())

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsletterId, email])
  @@index([userId])
  @@index([sentAt])
}

// A user's profile picture, stored in the database (same approach as CvFile).
model AvatarFile {
  id          String   @id @default(cuid())
  userId      String   @unique
  contentType String
  size        Int
  data        Bytes
  uploadedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A user's CV stored in the database (no external object storage needed, so it
// survives container redeploys). Served via /api/cv/[userId].
model CvFile {
  id          String   @id @default(cuid())
  userId      String   @unique
  filename    String
  contentType String
  size        Int
  data        Bytes
  uploadedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum DocumentType {
  CV
  CONTRACT
  CERTIFICATE
  OTHER
}

// Organization-defined document names and applicability. Completion is never
// stored here: it is derived from documents carrying this requirement id.
model DocumentRequirement {
  id             String   @id @default(cuid())
  orgId          String
  key            String
  labels         Json
  appliesToStage String?
  appliesToRole  String?
  mandatory      Boolean  @default(true)
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org       Organization                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents Document[]
  reminders DocumentRequirementReminder[]

  @@unique([orgId, key])
  @@index([orgId, active, order])
  @@index([orgId, appliesToStage])
  @@index([orgId, appliesToRole])
}

// Delivery-only weekly idempotency marker. Missing/completed state is not
// stored here and is always derived from DocumentRequirement + Document.
model DocumentRequirementReminder {
  id            String   @id @default(cuid())
  requirementId String
  menteeId      String
  recipientId   String
  weekStart     DateTime @db.Date
  createdAt     DateTime @default(now())

  requirement DocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  mentee      User                @relation("MissingDocumentReminderSubject", fields: [menteeId], references: [id], onDelete: Cascade)
  recipient   User                @relation("MissingDocumentReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requirementId, menteeId, recipientId, weekStart])
  @@index([menteeId])
  @@index([recipientId])
  @@index([weekStart])
}

// A stored document (DB bytes, like CvFile). Belongs to a user, or is an
// admin-managed template (ownerId null + isTemplate) available to everyone.
// Re-uploading the same (owner, type) keeps prior rows and bumps `version`.
model Document {
  id            String       @id @default(cuid())
  ownerId       String?
  uploaderId    String
  type          DocumentType @default(OTHER)
  title         String
  filename      String
  contentType   String
  size          Int
  data          Bytes
  version       Int          @default(1)
  isTemplate    Boolean      @default(false)
  requirementId String?
  createdAt     DateTime     @default(now())

  owner       User?                @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  requirement DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([requirementId])
  @@index([ownerId, requirementId, version])
  @@index([isTemplate])
}

model Company {
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])
  id           String        @id @default(cuid())
  name         String
  // TEXT: the company form offers 2 000 characters, far past VARCHAR(191).
  description  String?       @db.Text
  contactEmail String?
  industry     String?
  logoUrl      String?
  size         String?
  address      String?
  quota        Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  needs             CompanyNeed[]
  mentorships       MentorshipRelation[]
  users             User[]               @relation("CompanyUsers")
  projects          Project[]            @relation("CompanyProjects")
  interests         CompanyInterest[]
  entitlements      CompanyEntitlement[]
  needAlerts        CompanyNeedAlert[]
  offers            Offer[]
  requisitions      Requisition[]
  interviewRequests InterviewRequest[]
}

// Premium entitlement (freemium — Faz 0). One row per enabled feature per
// company; the row's PRESENCE means the feature is on (see src/lib/entitlements.ts).
// Mentor/mentee functionality is always free and never gated by this table.
model CompanyEntitlement {
  id        String   @id @default(cuid())
  companyId String
  // A key from PREMIUM_FEATURES (src/lib/entitlements.ts), stored as text so
  // adding features needs no migration.
  feature   String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, feature])
  @@index([companyId])
}

// Support tickets (#586/#592): a relation-independent channel between any user
// and the admins. Deliberately separate from Message (which is bound to a
// MentorshipRelation) — clean boundary, no relation baggage.
enum SupportStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model SupportTicket {
  id              String        @id @default(cuid())
  requesterId     String
  status          SupportStatus @default(OPEN)
  subject         String?
  assignedAdminId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  closedAt        DateTime?

  requester     User             @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedAdmin User?            @relation("SupportAssignee", fields: [assignedAdminId], references: [id])
  messages      SupportMessage[]

  @@index([requesterId])
  @@index([status])
}

model SupportMessage {
  id        String    @id @default(cuid())
  ticketId  String
  senderId  String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  readAt    DateTime?

  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User                @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([ticketId])
}

model SupportAttachment {
  id          String   @id @default(cuid())
  messageId   String
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// A mentee's self-serve request for mentorship (#590). One PENDING request at
// a time; an admin approves (choosing a mentor -> MentorshipRelation) or
// rejects. Powers the self-registration intake (#585).
enum MentorshipRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model MentorshipRequest {
  id                 String                  @id @default(cuid())
  menteeId           String
  status             MentorshipRequestStatus @default(PENDING)
  message            String?                 @db.Text
  targetPosition     String?
  // Structured, NON-BINDING matching preferences (#939): the subject area the
  // mentee wants help with, the languages they can be mentored in, and an
  // optional specific mentor picked from the consent-gated /mentors directory.
  // Admins see these in the approval queue; nothing is auto-assigned.
  preferredField     String?
  preferredLanguages Json                    @default("[]")
  preferredMentorId  String?
  decidedById        String?
  decidedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  mentee          User  @relation("MentorshipRequests", fields: [menteeId], references: [id], onDelete: Cascade)
  decidedBy       User? @relation("DecidedMentorshipRequests", fields: [decidedById], references: [id])
  // SetNull: a mentor leaving must not take pending requests with them — the
  // preference simply disappears while the request survives.
  preferredMentor User? @relation("PreferredMentorRequests", fields: [preferredMentorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([menteeId])
  @@index([preferredMentorId])
}

// A public, unauthenticated application to become a mentor (#904). No User
// account is created on submission — an admin reviews the queue and, when
// approving, is what turns an applicant into an account (a later task). One
// PENDING application at a time per email, same shape as MentorshipRequest.
enum CompanyInquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// A company asking to be shown the product, submitted from the public
// /for-companies page. Companies have no self-service sign-up — a COMPANY user
// is only born from an InvitationToken — so this is the bridge: the enquiry is
// stored (rather than only emailed) so a request cannot quietly go missing in
// an inbox, and so an admin can see what is still unanswered.
model CompanyInquiry {
  orgId       String?
  org         Organization?        @relation(fields: [orgId], references: [id])
  id          String               @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  // Roles they are hiring for, and anything else they typed.
  openRoles   String?              @db.Text
  message     String?              @db.Text
  // Preferred UI language ('en' | 'tr' | 'de') — the language they read the
  // page in, so a reply can be written in it.
  locale      String?
  status      CompanyInquiryStatus @default(NEW)
  // When they accepted the privacy terms — set server-side on submit.
  consentAt   DateTime?
  handledAt   DateTime?
  handledById String?
  note        String?              @db.Text
  createdAt   DateTime             @default(now())

  handledBy User? @relation("HandledCompanyInquiries", fields: [handledById], references: [id])

  @@index([status])
  @@index([email])
  @@index([orgId])
}

enum MentorApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model MentorApplication {
  orgId        String?
  org          Organization?           @relation(fields: [orgId], references: [id])
  id           String                  @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  // Areas the applicant can mentor in — same shape as User.skills.
  expertise    Json                    @default("[]")
  // Free-form professional background.
  experience   String?                 @db.Text
  // Why they want to mentor.
  motivation   String?                 @db.Text
  // Max concurrent mentees they could take on — mirrors User.mentorCapacity.
  capacity     Int?
  linkedinUrl  String?
  // Preferred UI language ('en' | 'tr' | 'de'), mirrors User.preferredLanguage.
  locale       String?
  status       MentorApplicationStatus @default(PENDING)
  decidedAt    DateTime?
  decidedById  String?
  // Set when rejecting; explains the decision to the reviewing admin later.
  rejectReason String?                 @db.Text
  // When the applicant accepted the privacy/data terms — set server-side on
  // submit, mirrors User.consentAt.
  consentAt    DateTime?
  createdAt    DateTime                @default(now())

  decidedBy User? @relation("DecidedMentorApplications", fields: [decidedById], references: [id])

  @@index([status])
  @@index([email])
  @@index([orgId])
}

// An offer extended to a mentee within a mentorship (#809). `status` is a free
// String (not an enum) — same reasoning as MentorshipRelation.pipelineStatus —
// validated + transitioned through the central state machine in
// src/lib/offers.ts (DRAFT -> SENT -> ACCEPTED|DECLINED|EXPIRED|WITHDRAWN).
// `compensationNote` is sensitive: only ADMIN and the offer's own MENTEE may
// ever have it selected server-side (enforced in the API layer, not just hidden
// in the UI).
model Offer {
  id                String             @id @default(cuid())
  orgId             String?
  org               Organization?      @relation(fields: [orgId], references: [id])
  relationId        String
  relation          MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  // Optional link to the company's staffing need this offer fills. Plain id,
  // not a FK — CompanyNeed rows aren't guaranteed to persist for the life of
  // the offer, and the offer must remain readable even if the need is edited.
  requisitionId     String?
  companyId         String?
  company           Company?           @relation(fields: [companyId], references: [id])
  status            String             @default("DRAFT")
  position          String
  startDate         DateTime?
  compensationNote  String?            @db.Text
  expiresAt         DateTime?
  sentAt            DateTime?
  decidedAt         DateTime?
  declineReasonCode String?
  // Optional free-text elaboration on the decline reason (never required).
  declineNote       String?            @db.Text
  createdById       String
  createdBy         User               @relation("OfferCreatedBy", fields: [createdById], references: [id])
  decidedById       String?
  decidedBy         User?              @relation("OfferDecidedBy", fields: [decidedById], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([orgId, status])
  @@index([relationId])
}

// Dedupe marker for premium CompanyNeed match alerts (Faz 1, #530). One row per
// company+mentee: once a matching candidate has triggered an alert for a
// company, we never re-notify for the same candidate (the "*SentAt" pattern).
model CompanyNeedAlert {
  id        String   @id @default(cuid())
  companyId String
  menteeId  String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mentee  User    @relation("CompanyNeedAlertMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([companyId, menteeId])
  @@index([companyId])
}

// One row per successful AI provider call (Faz 2, #537) — the metering behind
// the monthly AI quota (Setting.aiMonthlyQuota). scope identifies the feature
// (e.g. "cv_extract"); userId/companyId record who consumed it (companyId
// prepares per-company quotas for multi-tenancy).
model AiUsage {
  id        String   @id @default(cuid())
  scope     String
  userId    String?
  companyId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([scope])
}

// A company's read/interest signal on a candidate they're linked to via a
// MentorshipRelation (EPIC: company shortlist). One record per company+mentee
// pair; re-setting the status updates it in place.
enum InterestStatus {
  INTERESTED
  SHORTLISTED
  PASS
}

model CompanyInterest {
  id            String         @id @default(cuid())
  companyId     String
  menteeId      String
  requisitionId String?
  // Stable application-derived discriminator: legacy:<companyId>:<menteeId>
  // or requisition:<requisitionId>:<menteeId>. Unlike nullable compound
  // uniques, this remains reliable on MySQL when requisitionId is null.
  scopeKey      String?        @unique
  status        InterestStatus
  // TEXT: the shortlist API accepts 1 000 characters, past VARCHAR(191).
  note          String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mentee      User         @relation("CompanyInterestMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  requisition Requisition? @relation(fields: [requisitionId], references: [id], onDelete: Restrict)

  @@index([companyId, menteeId])
  @@index([menteeId])
  @@index([requisitionId])
}

// Outgoing webhook subscription (admin-managed). Events are sent as signed
// POSTs (HMAC-SHA256 of the body in the X-Signature header).
model Webhook {
  id        String   @id @default(cuid())
  url       String
  secret    String
  events    Json     @default("[]")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Read-only programmatic access key. Only the SHA-256 hash is stored.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  hashedKey  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Key-value system settings, admin-editable (e.g. reminder cadence, support
// email). Values are stored as strings; callers parse as needed.
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

// A project must be owned by exactly one of: an admin, a mentor, or a company.
enum ProjectOwnerType {
  ADMIN
  MENTOR
  MENTEE
  COMPANY
}

// An internship project. May belong to a company (owner=COMPANY) or be a
// community project owned by an admin/mentor. Mentees are assigned via
// MentorshipRelation.projectId. Ownership is transferable (audited).
model Project {
  orgId          String?
  org            Organization?    @relation(fields: [orgId], references: [id])
  id             String           @id @default(cuid())
  name           String
  description    String?          @db.Text
  technologies   Json             @default("[]")
  repoUrl        String?
  demoUrl        String?
  boardUrl       String?
  status         ProjectStatus    @default(ACTIVE)
  isPublic       Boolean          @default(false)
  goals          String?          @db.Text
  startDate      DateTime?
  endDate        DateTime?
  ownerType      ProjectOwnerType
  ownerUserId    String?
  ownerCompanyId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Which contributor terms this project's members accept, and whether it asks
  // at all (#1026). A key rather than a foreign key: the terms are versioned
  // rows, and a project follows the *document*, not one frozen version of it —
  // pointing at a row would pin the project to wording that has been superseded.
  // null → the platform default. `contributorTermsRequired = false` is for a
  // project that genuinely has no IP question (a reading group, a demo).
  contributorTermsKey      String?
  contributorTermsRequired Boolean @default(true)

  ownerUser     User?                 @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  ownerCompany  Company?              @relation("CompanyProjects", fields: [ownerCompanyId], references: [id])
  relations     MentorshipRelation[]
  tasks         ProjectTask[]
  members       ProjectMember[]
  conversations Conversation[]
  meetingSeries MeetingSeries[]
  meetings      Meeting[]
  taskTemplates ProjectTaskTemplate[]
  joinRequests  ProjectJoinRequest[]

  @@index([ownerUserId])
  @@index([ownerCompanyId])
}

// Person-level project membership (#617): a project can have several OWNERs
// (admins/mentors) and several MENTORs. Company ownership stays on
// ownerCompanyId; legacy ownerType/ownerUserId are kept in sync with the
// OWNER rows for backward compatibility until every consumer reads members.
enum ProjectMemberRole {
  OWNER
  MENTOR
  MENTEE
}

// Functional (job) role of a project member — orthogonal to the structural
// role above (owner/mentor/mentee). Optional; used mainly for mentee members
// so a project can show who does what (#51).
enum ProjectFunctionalRole {
  DEVELOPER
  TESTER
  MARKETING
}

model ProjectMember {
  id             String                 @id @default(cuid())
  projectId      String
  userId         String
  role           ProjectMemberRole      @default(MENTOR)
  functionalRole ProjectFunctionalRole?
  addedAt        DateTime               @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
}

// One to-do. Three shapes, one model, because one person reads them in a single
// list (/todos):
//   - a project goal            — projectId set, assigneeId null: open, claimable
//   - a to-do handed to someone — projectId set, assigneeId set
//   - a personal to-do          — projectId null, assigneeId set: written by the
//                                 person for themselves (or by their mentor)
//
// `templateId` is what makes a to-do *shared* (#1113): the wording then lives in
// the template, in every language, and this row only tracks that the person was
// given it and whether they are done. `title` is a snapshot for search,
// notifications and the day the template row disappears.
model ProjectTask {
  id          String    @id @default(cuid())
  // Null = a personal to-do that belongs to no project.
  projectId   String?
  title       String
  done        Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  // Optional owner of the task (#51). Null = an unassigned project-wide goal
  // that any member may claim ("üstlen"); set = a personal goal, which is what
  // a mentor sends a fresh member from the template pool.
  assigneeId  String?
  // Who wrote it — so "your mentor gave you this" and "you wrote this yourself"
  // are distinguishable on the to-do list.
  createdById String?
  // Who ticked it off, and when — so a mentor can see progress per person
  // without reading the activity log.
  doneAt      DateTime?
  // Finished and put away by the assignee. The row stays (it is the record that
  // the work was done), it just leaves the active list.
  archivedAt  DateTime?
  // Set when this to-do came from the shared pool: the text is read from the
  // template, in the reader's language, every time it is displayed.
  templateId  String?

  project  Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?                @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  author   User?                @relation("ProjectTaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  // A template is archived rather than deleted, so this normally stays intact;
  // SetNull is the safety net that leaves the snapshot title behind.
  template ProjectTaskTemplate? @relation("TaskFromTemplate", fields: [templateId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assigneeId])
  @@index([templateId])
  @@index([createdById])
}

// Reusable goal/task text (#51). Every task written for a project member is
// worth keeping: a new member usually gets the same starter goals. A template
// with `projectId` set belongs to that project; `projectId = null` makes it
// available everywhere (the shared starter pool).
// Not tenant-anchored: reached through Project / User, like the other child
// models (see TENANT_MODELS in src/lib/orgContext.ts).
model ProjectTaskTemplate {
  id           String    @id @default(cuid())
  projectId    String?
  // The fallback wording, and the key the pool dedupes on. A localized title
  // lives in `translations`; `title` is what a member sees when their language
  // has no entry there.
  title        String
  // { en?, tr?, de? } — the goal in each language it has been written in. The
  // task created from a template is a plain string, resolved once from the
  // assignee's own language (src/lib/goalTemplates.ts).
  translations Json?
  createdById  String?
  // How many times this template has been handed to someone — the pool sorts
  // by it so the goals actually used float to the top.
  useCount     Int       @default(0)
  createdAt    DateTime  @default(now())
  // Retired from the pool, not deleted (#1113). Handing a to-do out creates a
  // live reference to this row, so removing it would blank the wording for
  // everyone who was ever given it. Archived means "don't offer this again";
  // adding the same wording back revives the row.
  archivedAt   DateTime?

  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("TaskTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     ProjectTask[] @relation("TaskFromTemplate")

  // One template per wording per project, so capturing a goal that already
  // exists is a no-op. MySQL allows many NULLs here, so the shared (global)
  // pool is not constrained by it.
  @@unique([projectId, title])
  @@index([projectId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A request to join a *public* project (#51). Anyone signed in may ask; the
// project's owner (or an admin) approves, which creates the ProjectMember row.
model ProjectJoinRequest {
  id             String                 @id @default(cuid())
  projectId      String
  userId         String
  message        String?                @db.Text
  // What the applicant wants to do on the project; carried onto the member row.
  functionalRole ProjectFunctionalRole?
  status         JoinRequestStatus      @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?                @db.Text
  createdAt      DateTime               @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("JoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  // One open-or-decided request per person per project; re-applying reuses the row.
  @@unique([projectId, userId])
  @@index([status])
}

// Mentor-side onboarding checklist for a mentee (#51). Created lazily the first
// time the mentor opens the wizard for a mentee who joined the site or one of
// their projects. `steps` holds { "<stepKey>": true } so adding a step later
// never needs a migration.
model MenteeOnboarding {
  id          String    @id @default(cuid())
  mentorId    String
  menteeId    String
  // The project whose membership triggered the wizard, when it was a project
  // join rather than a plain site signup. Informational.
  projectId   String?
  steps       Json      @default("{}")
  dismissedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  mentor User @relation("OnboardingMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee User @relation("OnboardingMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([mentorId, menteeId])
  @@index([menteeId])
}

// A mentor's recurring weekly availability window.
model AvailabilitySlot {
  id        String   @id @default(cuid())
  mentorId  String
  weekday   Int // 0 = Sunday .. 6 = Saturday
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  createdAt DateTime @default(now())

  mentor User @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
}

// A cohort groups mentees/internships by intake period for comparison.
model Cohort {
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id])
  id        String        @id @default(cuid())
  name      String
  term      String?
  createdAt DateTime      @default(now())

  relations MentorshipRelation[]
}

model CompanyNeed {
  id        String @id @default(cuid())
  companyId String
  position  String
  count     Int
  period    String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model MentorshipRelation {
  orgId                   String?
  org                     Organization?    @relation(fields: [orgId], references: [id])
  id                      String           @id @default(cuid())
  mentorId                String
  menteeId                String
  companyId               String?
  projectId               String?
  cohortId                String?
  startDate               DateTime         @default(now())
  status                  MentorshipStatus @default(ACTIVE)
  // When the relation was marked COMPLETED. Anchors the post-mentorship CV and
  // document access window (#854) — without it, "access ended six months ago"
  // is unanswerable and mentors keep reading a former mentee's CV forever.
  // Cleared if the relation is reopened as ACTIVE.
  completedAt             DateTime?
  // Stage key. Free String (was the PipelineStatus enum) so tenants can define
  // their own stages (#747). The enum below is kept as the canonical default
  // key registry; values are unchanged for existing rows (ENUM→VARCHAR keeps
  // them), so single-tenant behaviour is identical.
  pipelineStatus          String           @default("APPLICATION_100")
  // Optional deadline for the current pipeline stage; powers overdue flagging
  // and deadline reminders.
  stageDeadline           DateTime?
  // Set when an overdue-stage reminder was last sent (avoids re-notifying daily).
  deadlineReminderSentAt  DateTime?
  // Set when a stale-mentee in-app notification was last sent; cleared once the
  // mentee has a recent interaction again, so each staleness episode notifies the
  // mentor only once (#573).
  stalenessReminderSentAt DateTime?
  // Dormant first contact (#1501). Stamped by the daily sweep when the relation
  // is still parked in the pipeline's FIRST stage, an outreach already went out
  // and nothing came back (lib/dormantFirstContact.ts). Cleared the moment any
  // sign of life appears, so a later silence can flag — and nudge — again.
  dormantSince            DateTime?
  // "Still interested?" check-ins sent to the MENTEE for the current dormancy
  // episode: how many (capped at DORMANT_MAX_NUDGES) and when the last one went
  // out. Both reset with dormantSince, so a person who comes back and goes quiet
  // months later is written to again rather than being silently written off.
  dormantNudgeCount       Int              @default(0)
  dormantNudgeSentAt      DateTime?

  mentor                User                   @relation("MentorRelations", fields: [mentorId], references: [id])
  mentee                User                   @relation("MenteeRelations", fields: [menteeId], references: [id])
  company               Company?               @relation(fields: [companyId], references: [id])
  project               Project?               @relation(fields: [projectId], references: [id])
  cohort                Cohort?                @relation(fields: [cohortId], references: [id])
  interactions          InteractionLog[]
  statusChanges         StatusChange[]
  meetings              Meeting[]
  messages              Message[]
  evaluations           Evaluation[]
  goals                 Goal[]
  meetingRequests       MeetingRequest[]
  questions             MentorQuestion[]
  relationNotes         RelationNote[]
  offers                Offer[]
  weeklyReports         WeeklyReport[]
  weeklyReportReminders WeeklyReportReminder[]

  @@index([status])
  @@index([pipelineStatus])
}

// A mentor's structured evaluation of a mentee within a mentorship.
enum EvaluationType {
  INTERIM
  FINAL
  // A scorecard written during a hiring interview (#824). Unlike the other two
  // it may exist before any mentorship does, which is why relationId is
  // nullable and subjectId names the candidate directly.
  INTERVIEW
}

enum GoalStatus {
  OPEN
  DONE
}

model Evaluation {
  id          String         @id @default(cuid())
  // Nullable since #824: an interview happens before a mentorship exists (a
  // company round especially), so a scorecard has no relation to hang off.
  // Every pre-existing row and every INTERIM/FINAL evaluation still carries one
  // — the existing queries all filter by it or traverse the relation, so they
  // are unaffected.
  relationId  String?
  // Who is being evaluated. Only set for relation-less rows (interviews); for a
  // relation-backed row the subject is relation.menteeId, and duplicating it
  // would mean a backfill and a second source of truth.
  subjectId   String?
  // The interview panel this scorecard belongs to (#824).
  panelId     String?
  // Blind scoring: a scorecard counts — and becomes visible to the rest of the
  // panel — only once submitted. Null means its author has not committed to it.
  // INTERIM/FINAL rows are submitted the moment they are written.
  submittedAt DateTime?
  authorId    String
  type        EvaluationType @default(INTERIM)
  scores      Json           @default("{}") // { criterion: 1..5 }
  comment     String?        @db.Text
  createdAt   DateTime       @default(now())
  // Which rubric this was scored against (#822). Null means the built-in 4+4
  // criteria, which is every row written before org templates existed and every
  // row in an org that never defined one. Stamped at write time so a record
  // keeps rendering with the labels of its own era even after the org rewrites
  // its framework — criteria are deactivated, never deleted, for the same
  // reason.
  templateId  String?

  // Consent-based testimonial publishing (#1096/#1098). The original comment
  // is never published or edited: the admin drafts publicExcerpt, the AUTHOR
  // approves that exact wording (excerptApprovedAt — cleared on every edit),
  // and only then can publish set publishedAt + sharedPublicly. Revoking the
  // TESTIMONIAL consent on either side clears the publish fields immediately.
  sharedPublicly    Boolean   @default(false)
  publishedAt       DateTime?
  publicExcerpt     String?   @db.Text
  excerptApprovedAt DateTime?

  relation MentorshipRelation? @relation(fields: [relationId], references: [id], onDelete: Cascade)
  panel    InterviewPanel?     @relation(fields: [panelId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: losing a template must never delete the evaluations
  // written against it.
  template EvaluationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([relationId])
  @@index([sharedPublicly, publishedAt])
  @@index([templateId])
  @@index([subjectId])
  @@index([panelId])
}

// Structured interview scoring (#824).
//
// The point of a panel is the ORDER: every interviewer scores independently and
// cannot see anyone else's scorecard, and only once the panel is complete does
// the calibration view show them side by side. Break that order and the
// scorecard is theatre — an interviewer who reads a colleague's 2 before
// writing their own does not produce an independent signal.
//
// That rule is enforced in the API, never merely hidden in the UI.
model InterviewPanel {
  id          String    @id @default(cuid())
  orgId       String?
  // The candidate being interviewed.
  subjectId   String
  // The rubric to score against (#822). Null = the org's built-in mentee
  // criteria, resolved at read time like everywhere else.
  templateId  String?
  title       String?
  scheduledAt DateTime?
  createdById String?
  // Set when an admin closes the panel early — a no-show interviewer must not
  // hold the calibration view hostage for ever. Closing reveals the scorecards
  // that were submitted.
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members    InterviewPanelMember[]
  scorecards Evaluation[]

  @@index([orgId, subjectId])
  @@index([subjectId, createdAt])
}

model InterviewPanelMember {
  id      String @id @default(cuid())
  panelId String
  userId  String

  panel InterviewPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, userId])
  @@index([userId])
}

// Per-tenant competency framework (#822), the same shape #747 gave pipeline
// stages: an org that defines nothing keeps exactly the built-in criteria, and
// one that defines a template replaces them for that scope.
//
// `scope` is a plain String validated against a whitelist in code
// (src/lib/evaluation.ts), not a Prisma enum — the same convention the rest of
// this repo uses for status-like values, so adding a scope is not a migration.
model EvaluationTemplate {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  // 'MENTEE' (mentor scores the mentee) | 'MENTOR' (mentee scores the mentor).
  scope     String
  // Only one active template per org+scope is used; the rest are history.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  criteria    EvaluationCriterion[]
  evaluations Evaluation[]

  @@index([orgId, scope, active])
}

model EvaluationCriterion {
  id         String  @id @default(cuid())
  templateId String
  // The key stored inside Evaluation.scores. Stable: renaming a criterion
  // changes its labels, never its key, or historical scores stop matching.
  key        String
  // { en?, tr?, de? } — the label in each language it was written in. A missing
  // language falls back to English, then to the key itself, so a half-translated
  // framework still renders.
  labels     Json
  order      Int     @default(0)
  // Retired, not deleted (#822): an evaluation scored against this criterion
  // still has to render its label years later.
  active     Boolean @default(true)

  template EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId, order])
}

// A structured question from a mentee to their mentor, with an optional answer.
// Distinct from chat: each question has an answered/unanswered state.
model MentorQuestion {
  id         String    @id @default(cuid())
  relationId String
  askedById  String
  question   String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
}

enum MeetingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A mentee-initiated meeting request. The mentor accepts (creating a Meeting)
// or declines. Distinct from Meeting, which is the confirmed event.
model MeetingRequest {
  id            String               @id @default(cuid())
  relationId    String
  requestedById String
  topic         String
  proposedAt    DateTime
  status        MeetingRequestStatus @default(PENDING)
  createdAt     DateTime             @default(now())

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
}

// A mentee's private personal note (only the author can see it).
model PersonalNote {
  id        String   @id @default(cuid())
  userId    String
  // 'MEETING' | 'FEEDBACK' | 'TASKS' | 'PERSONAL' — validated in the API, not
  // a DB enum, so new categories don't need a schema change.
  category  String   @default("PERSONAL")
  // Which meeting this note was taken in (#1056). Null for a free-standing note.
  // SetNull rather than Cascade: deleting the meeting must not delete what was
  // written in it — the note is the durable part.
  meetingId String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([meetingId])
}

// A mentor-private note on a mentorship relation (impressions, prep notes,
// red flags) — visible only to the authoring mentor and admins, never the
// mentee (EPIC: mentor private notes).
model RelationNote {
  id         String   @id @default(cuid())
  relationId String
  authorId   String
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  author   User               @relation("RelationNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([relationId])
}

// A goal set within a mentorship — supports goal setting + tracking (checklist 7).
model Goal {
  id            String     @id @default(cuid())
  relationId    String
  title         String
  description   String?    @db.Text
  status        GoalStatus @default(OPEN)
  dueDate       DateTime?
  createdAt     DateTime   @default(now())
  // Set when the goal is marked DONE (cleared if reopened); powers the
  // "completed todos" line of the activity report.
  completedAt   DateTime?
  // Which side created the goal (mentor vs mentee), so it's clear at a glance.
  createdByRole Role?

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@index([relationId])
}

model InteractionLog {
  id         String          @id @default(cuid())
  relationId String
  date       DateTime
  // Optional short topic/subject line — the free-form `notes` field carries
  // the detail; this is what a filtered list scans/displays at a glance.
  subject    String?
  // TEXT, not the default VARCHAR(191): a meeting note is prose and overflowed
  // the 191-char default after ~three sentences, which surfaced as an opaque
  // 500 (Prisma P2000) *after* the mentor's email had already been sent.
  notes      String          @db.Text
  type       InteractionType
  // Written by the system rather than typed by a mentor (#1489) — a meeting
  // that took place is logged on its own, so the interaction history is the
  // history and not "whatever anybody remembered to re-type afterwards".
  // A plain boolean and not just `meetingId != null`: the link below is
  // SetNull, so deleting the meeting must not turn its log into a hand-written
  // one retroactively.
  autoLogged Boolean         @default(false)
  // Which meeting produced this log. Also the idempotency key: @unique means
  // one meeting can never write two logs, whichever path gets there first (the
  // "end meeting" click or the sweep that catches meetings nobody ended).
  // SetNull rather than Cascade — deleting the meeting row must not delete the
  // record that the meeting happened (same reasoning as PersonalNote).
  meetingId  String?         @unique

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  meeting  Meeting?           @relation(fields: [meetingId], references: [id], onDelete: SetNull)
}

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A scheduled meeting, with a video link and an emailed RSVP (responded to via
// a public token link).
//
// A meeting hangs off exactly ONE context (#1051):
//   relationId     — the original mentor ↔ mentee meeting (one row per invitee,
//                    each with its own rsvpToken; the shared room is meetLink)
//   projectId      — an ad-hoc meeting for a whole project team
//   conversationId — an ad-hoc meeting for a group chat
// MySQL can't express "exactly one of three" as a CHECK, so the rule lives in
// src/lib/meetingContext.ts and every write path goes through it.
model Meeting {
  id             String     @id @default(cuid())
  // Nullable since #1051: project/conversation meetings have no relation.
  relationId     String?
  projectId      String?
  conversationId String?
  title          String
  // Optional: a meeting with a set time expects an RSVP and gets reminders; a
  // meeting with no time (null) is just a shared link — no RSVP, no reminder.
  scheduledAt    DateTime?
  // The clock the organizer picked `scheduledAt` on (IANA zone), captured at
  // creation (#1210). `scheduledAt` is an instant and is enough to render the
  // time for anyone, but not to say *which* reading was the one agreed on — and
  // the organizer's profile zone can't stand in for it, since it changes when
  // they travel. Null for meetings created before this and for the odd caller
  // that sends no zone; both fall back to the organizer's profile zone.
  timeZone       String?
  meetLink       String?
  rsvp           RsvpStatus @default(PENDING)
  rsvpToken      String     @unique
  createdById    String
  reminderSentAt DateTime?
  createdAt      DateTime   @default(now())
  // Null for manually scheduled meetings; set for auto-generated series instances.
  seriesId       String?
  // "This meeting is over" — set when any participant marks it ended, which
  // hides the dashboard banner for everyone instead of letting the assumed
  // 60-minute window run out. Null = never marked; the window still applies.
  endedAt        DateTime?
  endedById      String?

  relation     MentorshipRelation?       @relation(fields: [relationId], references: [id], onDelete: Cascade)
  project      Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation Conversation?             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  series       MeetingSeries?            @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  interaction  InteractionLog?
  notes        PersonalNote[]
  googleEvents GoogleCalendarEventLink[]
  guests       MeetingGuest[]

  @@index([relationId])
  @@index([projectId])
  @@index([conversationId])
  @@index([seriesId])
}

// An invitee who has no account here — a company contact, a parent, an external
// interviewer (#1446). Everyone else on a meeting is reached through the
// meeting's context (the relation's mentor/mentee, the project's members, the
// conversation's participants); a guest is reached only by the address the
// organizer typed, so the row IS the invitation.
//
// Guests hang off ONE Meeting row, never one per invitee the way the RELATION
// context fans out: a bulk schedule writes N meeting rows sharing a single
// room, and mailing the same outsider N times would be a bug, not thoroughness.
// The write paths attach guests to the first row of the batch (`meetingId`),
// which is also the row a guest's RSVP is counted against.
//
// `rsvpToken` is the guest's whole credential — same shape and entropy as
// Meeting.rsvpToken (24 random bytes, hex) — so /rsvp/<token> and
// /api/calendar/<token> work for them with no account and no login. It is
// deliberately a SEPARATE column from Meeting.rsvpToken rather than a shared
// token table: the two are looked up by different queries and a guest must not
// be able to present a token that resolves to a participant's row.
//
// No `orgId`, deliberately: this is a child of Meeting, and Meeting itself is
// not in TENANT_MODELS (src/lib/orgContext.ts) — both are reached only through a
// scoped parent. Worth stating, because a model that is not anchored gets no
// automatic tenant protection and every reader has to know that on purpose.
model MeetingGuest {
  id          String     @id @default(cuid())
  meetingId   String
  // Stored lowercased+trimmed so @@unique actually prevents a double invite
  // ("Ada@X.com" and "ada@x.com" are one person to every mail server).
  email       String
  // Optional display name, purely so the email can open with "Hi <name>".
  name        String?
  rsvpToken   String     @unique
  rsvp        RsvpStatus @default(PENDING)
  // Who typed the address. Kept for the audit trail and so the RSVP
  // notification can reach the organizer even when they were not the creator
  // of the meeting row the guest hangs off.
  invitedById String
  createdAt   DateTime   @default(now())
  respondedAt DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // No @@index([meetingId]): @@unique([meetingId, email]) already gives MySQL a
  // leftmost-prefix index on meetingId, and a second one is dead weight.
  @@unique([meetingId, email])
}

// A recurring-meeting rule. Auto-generated Meeting rows reference this via seriesId;
// manually scheduled meetings leave seriesId null (backward-compatible).
model MeetingSeries {
  id          String   @id @default(cuid())
  projectId   String?
  title       String
  // Days of week as a JSON array of integers (0=Sun … 6=Sat), e.g. [1,4] = Mon+Thu.
  daysOfWeek  Json
  // Wall-clock start time in "HH:mm" format (24-hour), e.g. "09:30".
  timeOfDay   String
  // Which clock `timeOfDay` is on (IANA zone, e.g. "Europe/Istanbul"). Null for
  // rules saved before #1110, which are read on the deployment default zone —
  // the clock the UI always showed them on. Without this the wall clock was
  // anchored to UTC, so a 09:00 rule was reminded as "12:00 (GMT+3)".
  timeZone    String?
  fixedLink   String?
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  project   Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meetings  Meeting[]
  reminders MeetingSeriesReminder[]
  ends      MeetingOccurrenceEnd[]

  @@index([projectId])
}

// One row per (series, occurrence, lead time) that has been reminded (#51).
// The recurring project meeting is announced to *every* project member, not
// only the mentees who happen to have a MentorshipRelation, so its reminders
// cannot ride on `Meeting.reminderSentAt`. The unique key is the idempotency
// guard: the cron claims the row first and only mails when the insert wins.
enum MeetingReminderLead {
  DAY_BEFORE
  HOUR_BEFORE
}

model MeetingSeriesReminder {
  id           String              @id @default(cuid())
  seriesId     String
  occurrenceAt DateTime
  lead         MeetingReminderLead
  sentAt       DateTime            @default(now())

  series MeetingSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, occurrenceAt, lead])
}

// "This occurrence is over" for a series occurrence that has no Meeting row —
// the dashboard banner synthesizes those on the fly (src/lib/upcomingMeeting.ts),
// so the end mark needs its own home, keyed the same way as the reminders above.
// Occurrences that DO have a generated Meeting row get both marks (the row's
// endedAt and one of these), so every viewer's representation is covered.
model MeetingOccurrenceEnd {
  id           String   @id @default(cuid())
  seriesId     String
  occurrenceAt DateTime
  endedById    String
  endedAt      DateTime @default(now())

  series MeetingSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, occurrenceAt])
}

// Live state of one JaaS video room, fed by the tenant's webhooks
// (/api/webhooks/jaas, enabled by JAAS_WEBHOOK_SECRET). Purely informational:
// the dashboard banner shows "n in the call" while the room is active. Keyed by
// the bare room name (unguessable, unique per meeting; a series' fixedLink
// reuses one room, so readers must also check freshness via updatedAt).
model MeetingRoomState {
  id           String   @id @default(cuid())
  room         String   @unique
  active       Boolean  @default(false)
  // JSON array of { id, name } for everyone currently in the room.
  participants Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Audit trail of pipeline stage changes for a mentorship.
model StatusChange {
  id          String   @id @default(cuid())
  relationId  String
  fromStatus  String
  toStatus    String
  changedById String
  createdAt   DateTime @default(now())
  // Drop-off reason (#810): required by the API when `toStatus` resolves to a
  // negative/off-path stage in the org's pipeline (PipelineStage.isOffPath —
  // see src/lib/dropoffReasons.ts for the whitelist and src/lib/stageChange.ts
  // for the validation). Null for every pre-existing row and for moves into a
  // non-negative stage — never backfilled.
  reasonCode  String?
  // Free-text elaboration; required only when reasonCode is OTHER.
  reasonNote  String?  @db.Text

  relation  MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  changedBy User               @relation("StatusChangedBy", fields: [changedById], references: [id])
}

model InvitationToken {
  id           String    @id @default(cuid())
  token        String    @unique
  // Nullable since #670: an invitation may be a shareable link with no address
  // attached ("invite someone who has no email yet, or whose address you don't
  // know"). When such a link is used, registration writes the address the
  // invitee actually signed up with back here, so the row always ends up naming
  // whoever consumed it.
  email        String?
  // The inviter's own note about a link — "Ayşe from the bootcamp", "career fair
  // handout" (#670). Never shown to the invitee; it is how the sender recognises
  // an email-less link in their own list.
  label        String?
  role         Role
  used         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  // The inviter's tenant, captured at invite time (#1272) so registration can
  // assign the org immediately instead of leaving the account org-less until
  // the next deploy's backfill (fail-closed org scoping 403s COMPANY reads in
  // that window). Nullable: pre-existing rows predate the column.
  orgId        String?
  // Who sent the invitation (#51). Nullable: pre-existing rows have no inviter,
  // and the seeder/system can invite without a user. Drives two things on
  // registration — the new account's `referredById`, and the automatic
  // mentorship link below.
  invitedById  String?
  // When set, registering through this invitation immediately creates the
  // mentorship: `mentorId` mentors the new MENTEE (or, for a MENTOR invite, the
  // invited mentor is paired with `menteeId`). A mentor inviting a mentee sets
  // this to itself; an admin picks the mentor in the invite form.
  mentorId     String?
  menteeId     String?
  // The project the invitee should join on registration, if any.
  projectId    String?
  // Lifecycle timestamps (nullable — each set once, the first time it happens):
  // openedAt  → the register link was clicked/opened
  // registeredAt → the account was created from this invitation
  // verifiedAt → the invitee's email was verified (immediate for invited users)
  openedAt     DateTime?
  registeredAt DateTime?
  verifiedAt   DateTime?
  // Revoked (#2071): an invitation the admin has withdrawn. A real state rather
  // than a delete, so the board can still answer "what happened to that person"
  // — and so the consumption paths (register, /api/invite/opened, resend) can
  // refuse it. Registration checks this alongside `used`/`expiresAt`: hiding a
  // revoked row from the list without refusing the token would leave the link
  // live for whoever already has it.
  revokedAt    DateTime?

  // Only the inviter gets a relation; mentorId/menteeId/projectId stay plain
  // columns (validated when the invitation is created) so the User model does
  // not grow three more back-relations for a write-once pointer.
  invitedBy User? @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([invitedById])
}

// Single-use, time-limited token for self-service password reset and for the
// "set your password" link sent to freshly-created mentees.
enum PasswordResetPurpose {
  RESET
  SET_INITIAL
}

model PasswordResetToken {
  id        String               @id @default(cuid())
  token     String               @unique
  userId    String
  purpose   PasswordResetPurpose @default(RESET)
  used      Boolean              @default(false)
  createdAt DateTime             @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, very short-lived grant that authorizes an impersonation sign-in.
// Created by an admin-guarded API route, then consumed by the auth provider —
// so the provider never has to re-check the caller's session itself.
model ImpersonationGrant {
  id        String   @id @default(cuid())
  token     String   @unique
  adminId   String // the real admin
  targetId  String // who to become (the target on START, the admin on STOP)
  kind      String // START | STOP
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Single-use bridge token minted by the SSO ACS route AFTER a signed SAML
// assertion is verified, then consumed by the `sso` NextAuth provider to issue a
// session (#545). Mirrors ImpersonationGrant: short-lived + single-use, so a
// verified IdP login can't be replayed.
model SsoLoginGrant {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Single-use bridge token minted by /api/auth/remember/refresh once a trusted
// device's remember-me cookie has been verified AND rotated, then consumed by
// the `remember` NextAuth provider to mint a fresh session. Same shape as
// SsoLoginGrant on purpose: the session is always minted by a NextAuth
// provider, never hand-encoded, so every token carries the same claims.
model SessionRefreshGrant {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  deviceId  String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// "Remember me" — one row per device the user chose to trust (#1495).
//
// The session JWT stays short-lived (12h); this is the long-lived credential
// that silently mints a new one, so an idle laptop does not have to be logged
// into every morning. Shaped along the usual persistent-login rules:
//
//   * only the SHA-256 of the secret is stored, so a database dump is not a
//     pile of usable login cookies;
//   * the secret ROTATES on every use — `tokenHash` becomes the new one and the
//     old hash moves to `prevTokenHash`, valid for a few seconds only so two
//     parallel tabs racing the same refresh do not knock each other out;
//   * presenting a hash older than that grace window means the cookie was
//     copied off the machine (the legitimate device would have rotated it), so
//     the device is revoked on the spot rather than trusted;
//   * `expiresAt` slides forward on use but `absoluteExpiresAt` never does — a
//     remembered device eventually has to type its password again.
model TrustedDevice {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the current secret. Never the secret itself.
  tokenHash         String    @unique
  // The previous secret's hash, accepted until prevValidUntil (see above).
  prevTokenHash     String?   @unique
  prevValidUntil    DateTime?
  // Human-readable "Chrome on macOS", derived from the user-agent at enrolment
  // so the account page can list devices someone actually recognises.
  label             String?
  userAgent         String?   @db.Text
  lastIp            String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  // Idle expiry — slides forward on every refresh.
  expiresAt         DateTime
  // Hard cap — never extended.
  absoluteExpiresAt DateTime
  // Set when the user signs out, revokes the device, changes their password or
  // signs out of all devices. Kept (rather than deleted) so a later attempt
  // with the stolen cookie can be recognised and logged instead of looking like
  // an unknown token.
  revokedAt         DateTime?

  @@index([userId])
  @@index([expiresAt])
}

enum LogLevel {
  DEBUG
  INFO
  WARNING
  ERROR
}

// Application activity log: auth events and key user actions, at several
// levels. Powers the admin activity viewer.
model ActivityLog {
  id         String   @id @default(cuid())
  level      LogLevel @default(INFO)
  action     String
  actorId    String?
  actorEmail String?
  targetType String?
  targetId   String?
  detail     String?
  // Where the action came from (#881). Both optional: existing rows predate the
  // columns, and plenty of call sites (cron jobs, NextAuth event callbacks) have
  // no Request to read them from. An incident review can't answer "was this
  // really the user?" from actor + action alone.
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

enum EmailStatus {
  // Handed to the SMTP server without error. NOT proof of inbox placement —
  // the message can still bounce or be filed as spam downstream.
  SENT
  // The SMTP server rejected it, or the connection failed.
  FAILED
  // Never attempted: SMTP is not configured on this environment.
  SKIPPED
}

// Delivery log for outgoing mail (#1194).
//
// Without this there is no record anywhere that a mail was (or wasn't) sent:
// `sendEmail` used to return silently when SMTP was unconfigured and most
// callers swallow send failures, so an outage looked exactly like "the user
// ignored us". Deliberately metadata only — recipient, subject, category and
// outcome. The body is never stored: it is the most sensitive part of the
// payload and duplicating it here would put message content in a second place
// that account erasure would have to chase.
model EmailLog {
  id        String      @id @default(cuid())
  to        String      @db.VarChar(320)
  subject   String      @db.VarChar(512)
  // Coarse bucket ("verification", "message", "invitation", …) so the admin
  // view can answer "are verification mails going out at all?".
  category  String?     @db.VarChar(64)
  // Which of the two outbound channels carried it: "primary" (the reputable
  // relay, for mail that must reach a human) or "bulk" (our own server, for
  // digests and reminders). Lets the admin see how much of the relay's daily
  // quota each category is actually consuming (#1203).
  transport String?     @db.VarChar(16)
  status    EmailStatus @default(SENT)
  // Rejection reason / exception message when status is FAILED or SKIPPED.
  error     String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([to])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// Lightweight audit trail for sensitive admin actions (e.g. impersonation).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String // who performed the action (e.g. the admin)
  action    String // e.g. IMPERSONATE_START / IMPERSONATE_STOP
  targetId  String? // affected user, when applicable
  // @db.Text: a USER_MERGE detail carries per-relation move counts as JSON,
  // which overflows the default VARCHAR(191) and turned a committed merge
  // into a 500 with no audit row (P2000).
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([actorId])
}

// Single-use, time-limited token to confirm a user's email address.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum WeeklyReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

// One mentee-owned internship report per relation and canonical UTC week.
model WeeklyReport {
  id            String             @id @default(cuid())
  orgId         String
  relationId    String
  weekStart     DateTime           @db.Date
  summary       String             @db.Text
  hoursSpent    Int?
  blockers      String?            @db.Text
  status        WeeklyReportStatus @default(DRAFT)
  mentorComment String?            @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  relation   MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  reviewedBy User?              @relation("WeeklyReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([relationId, weekStart])
  @@index([orgId, weekStart])
  @@index([relationId, status, weekStart])
  @@index([reviewedById])
}

// Delivery-only weekly idempotency marker; contains no report/message content.
model WeeklyReportReminder {
  id         String   @id @default(cuid())
  relationId String
  weekStart  DateTime @db.Date
  createdAt  DateTime @default(now())

  relation MentorshipRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@unique([relationId, weekStart])
  @@index([weekStart])
}

// Structured hiring demand (#806). CompanyNeed remains in place during the
// compatibility window; legacyCompanyNeedId makes the manual backfill safe to
// rerun without coupling the two live write paths.
model Requisition {
  id                  String    @id @default(cuid())
  orgId               String
  companyId           String
  title               String
  description         String?   @db.Text
  status              String    @default("DRAFT")
  openings            Int
  filled              Int       @default(0)
  requiredSkills      Json      @default("[]")
  city                String?
  workMode            String?
  startDate           DateTime?
  ownerId             String?
  legacyCompanyNeedId String?   @unique
  createdAt           DateTime  @default(now())
  closedAt            DateTime?

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User?        @relation("RequisitionOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  interests         CompanyInterest[]
  interviewRequests InterviewRequest[]

  @@index([orgId, companyId])
  @@index([orgId, status])
  @@index([ownerId])
}

// A company asks the program/authorized mentor to interview one shortlisted
// mentee for one requisition (#807). Status stays String so the workflow can
// grow without a schema enum migration.
model InterviewRequest {
  id            String    @id @default(cuid())
  requisitionId String
  menteeId      String
  companyId     String
  orgId         String
  status        String    @default("PENDING")
  note          String?   @db.Text
  decidedById   String?
  decidedAt     DateTime?
  proposedSlots Json?
  activeKey     String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requisition Requisition  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  mentee      User         @relation("InterviewRequestMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  decidedBy   User?        @relation("InterviewRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([companyId, requisitionId])
  @@index([menteeId, status])
  @@index([requisitionId, menteeId])
}

/// A user's own Google Calendar, connected by them and revocable by them (#709).
/// One row per user: the app never creates a Google account and never writes to
/// anyone's calendar without this row existing.
model GoogleCalendarConnection {
  id     String @id @default(cuid())
  userId String @unique

  /// The Google account that granted consent — shown back to the person so they
  /// can tell WHICH calendar this is before they trust it or disconnect it.
  googleEmail String
  /// 'primary' unless the operator points it elsewhere.
  calendarId  String @default("primary")
  /// What Google actually granted. Stored so a scope that was reduced on
  /// re-consent is visible rather than discovered by a failing write.
  scope       String @db.Text

  /// Both sealed with lib/secretBox (AES-256-GCM), never written in the clear.
  /// The access token is short-lived; the refresh token is the one that matters.
  accessTokenEnc  String   @db.Text
  refreshTokenEnc String?  @db.Text
  expiresAt       DateTime

  /// Operational state, so a broken connection is visible in the UI instead of
  /// failing silently on every meeting.
  lastSyncAt DateTime?
  lastError  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  events GoogleCalendarEventLink[]
}

/// Which Google event a meeting became, on whose calendar (#709).
/// Per (meeting, user) rather than per meeting: the same meeting is pushed to
/// every connected participant's own calendar, and each gets a different event
/// id — one column on Meeting could only ever remember one of them.
model GoogleCalendarEventLink {
  id            String   @id @default(cuid())
  meetingId     String
  connectionId  String
  googleEventId String
  pushedAt      DateTime @default(now())

  meeting    Meeting                  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([meetingId, connectionId])
  @@index([connectionId])
}
